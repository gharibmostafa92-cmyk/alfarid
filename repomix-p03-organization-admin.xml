/* ─── Simple Markdown Renderer ─── */
function renderMarkdown(md: string): string {
  let html = md
    // Code blocks
    .replace(/```(\w*)\n([\s\S]*?)```/g, (_m, lang, code) =>
      `<pre><code class="lang-${lang}">${code.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</code></pre>`)
    // Inline code
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    // Headers
    .replace(/^### (.+)$/gm, '<h4>$1</h4>')
    .replace(/^## (.+)$/gm, '<h3>$1</h3>')
    .replace(/^# (.+)$/gm, '<h2>$1</h2>')
    // Bold
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    // Italic
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    // Blockquotes
    .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
    // Horizontal rule
    .replace(/^---$/gm, '<hr />')
    // Unordered lists
    .replace(/^- (.+)$/gm, '<li>$1</li>')
    // Line breaks
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br />');

  // Wrap in paragraph
  html = `<p>${html}</p>`;

  // Simple table rendering
  html = html.replace(/<p>\|(.+)\|<br \/>\|[-| :]+\|([\s\S]*?)<\/p>/g, (_m, header, body) => {
    const headers = header.split('|').map((h: string) => h.trim()).filter(Boolean);
    const rows = body.split('<br />').filter((r: string) => r.trim().startsWith('|'));
    let table = '<div class="chat-table-wrap"><table><thead><tr>';
    headers.forEach((h: string) => { table += `<th>${h}</th>`; });
    table += '</tr></thead><tbody>';
    rows.forEach((row: string) => {
      const cells = row.split('|').map((c: string) => c.trim()).filter(Boolean);
      if (cells.length) {
        table += '<tr>';
        cells.forEach((c: string) => { table += `<td>${c}</td>`; });
        table += '</tr>';
      }
    });
    table += '</tbody></table></div>';
    return table;
  });

  return html;
}

