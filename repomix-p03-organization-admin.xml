    if (initialRoleId && appliedInitialRole.current !== initialRoleId && roles.some(r => r.id === initialRoleId)) {
      setSelId(initialRoleId);
      appliedInitialRole.current = initialRoleId;
    }
  }, [initialRoleId, roles]);

  useEffect(() => {
    if (!draft && roles.length && !roles.some(r => r.id === selId)) {
