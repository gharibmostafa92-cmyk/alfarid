import React, { useEffect, useLayoutEffect, useRef, useState, useMemo } from 'react';
import { createPortal } from 'react-dom';
import { useRoles, useApi, useQueryError } from './hooks';
import { adminApi } from './api/endpoints';
import { UsersScreen } from './users';
import { RolesScreen } from './roles';
import { SettingsScreen } from './settings';
import { ToastHost, Icon, EmptyState } from './ui';
import styles from './admin-reference.css?inline';
import { useBranding } from '@alfarid/ui/branding';

export interface AdminMockPageProps {
  page: 'users' | 'roles' | 'settings';
  can?: (perm: string) => boolean;
  darkMode?: boolean;
  theme?: string;
  initialTab?: string;
}

export default function AdminMockPage({ page, can, darkMode, theme, initialTab }: AdminMockPageProps) {
  const { branding } = useBranding();
  const host = useRef<HTMLDivElement>(null);
  const [root, setRoot] = useState<ShadowRoot | null>(null);

  const canFn = can ?? (() => false);
  const visible = (key: string) => canFn(key+'.view') || canFn(key+'.manage');
  const rolesQ = useRoles(visible('roles'));
  const roles = rolesQ.data ?? [];
  const [usersTick, setUsersTick] = useState(0);
  const usersTotal = useApi(signal => visible('users') ? adminApi.countUsers({}, signal) : Promise.resolve(undefined), [usersTick, visible('users')]);
  useQueryError(rolesQ.error); useQueryError(usersTotal.error);
  useEffect(() => { ['alfarid_mock_users','alfarid_mock_roles','alfarid_mock_settings'].forEach(key => localStorage.removeItem(key)); }, []);
  // Parse URL query parameters if present (e.g. ?role=3 or ?roleId=2 or ?tab=store)
  const queryParams = useMemo(() => {
    const raw = window.location.hash.includes('?')
      ? window.location.hash.split('?')[1]
      : window.location.search.replace(/^\?/, '');
    const sp = new URLSearchParams(raw);
    const roleParam = sp.get('role') || sp.get('roleId');
    const roleIdParam = sp.get('roleId') || sp.get('role');
    const tabParam = sp.get('tab');
    return {
      role: roleParam ? (isNaN(Number(roleParam)) ? 'all' : Number(roleParam)) : 'all',
      roleId: roleIdParam && !isNaN(Number(roleIdParam)) ? Number(roleIdParam) : undefined,
      userId: sp.get('userId') && /^[1-9][0-9]*$/.test(sp.get('userId')!) ? Number(sp.get('userId')) : undefined,
      tab: tabParam || initialTab || undefined,
    };
  }, [page, window.location.hash, initialTab]);

  const [detectedDark, setDetectedDark] = useState(() => {
    if (typeof darkMode === 'boolean') return darkMode;
    if (typeof theme === 'string') return theme === 'dark';
    try {
      return localStorage.getItem('vortix_theme') === 'dark';
    } catch {
      return false;
    }
  });

  const isDark = typeof darkMode === 'boolean' ? darkMode : (theme ? theme === 'dark' : detectedDark);

  useLayoutEffect(() => {
    if (host.current) {
      setRoot(host.current.shadowRoot || host.current.attachShadow({ mode: 'open' }));
    }
    const fonts = document.createElement('link');
    fonts.rel = 'stylesheet';
    fonts.href = 'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Readex+Pro:wght@400;500;600;700&display=swap';
    document.head.append(fonts);
    return () => fonts.remove();
  }, []);

  useEffect(() => {
    if (host.current) {
      host.current.setAttribute('data-theme', isDark ? 'dark' : 'light');
    }
  }, [isDark]);

  useEffect(() => {
    const handleCustom = (e: any) => {
      if (typeof e.detail?.darkMode === 'boolean') {
        setDetectedDark(e.detail.darkMode);
      }
    };
    window.addEventListener('vortix:theme-change', handleCustom);

    const checkParent = () => {
      const rootNode = host.current?.getRootNode() as ShadowRoot | undefined;
      const parentViewport = host.current?.closest('#app-viewport');
      const target = parentViewport || (rootNode?.host?.querySelector?.('#app-viewport') || rootNode?.host) || document.querySelector('#app-viewport') || document.querySelector('[data-vortix-host]');
      if (!target) return null;
      const dark = target.classList?.contains('theme-dark') || target.getAttribute?.('data-theme') === 'dark';
      setDetectedDark(dark);
      return target;
    };

    const target = checkParent();
    let observer: MutationObserver | undefined;
    if (target) {
      observer = new MutationObserver(() => checkParent());
      observer.observe(target, { attributes: true, attributeFilter: ['class', 'data-theme'] });
    }

    return () => {
      window.removeEventListener('vortix:theme-change', handleCustom);
      observer?.disconnect();
    };
  }, []);

  const handleNavigate = (targetPage: 'users' | 'roles' | 'settings', params?: Record<string, any>) => {
    let hash = `/${targetPage}`;
    if (params) {
      const sp = new URLSearchParams();
      Object.entries(params).forEach(([k, v]) => {
        if (v != null) sp.set(k, String(v));
      });
      const q = sp.toString();
      if (q) hash += `?${q}`;
    }
    window.location.hash = hash;
  };

  const navItems = [
    { id: 'users', label: 'المستخدمون', icon: 'users', count: usersTotal.loading ? undefined : usersTotal.data, path: '/users' },
    { id: 'roles', label: 'الأدوار والصلاحيات', icon: 'shield', count: rolesQ.loading ? undefined : roles.length, path: '/roles' },
    { id: 'settings', label: 'الإعدادات العامة', icon: 'sliders', path: '/settings' },
  ].filter(item => visible(item.id));

  return (
    <div
      ref={host}
      data-catalog-mock={page}
      data-admin-mock={page}
      data-theme={isDark ? 'dark' : 'light'}
      dir="rtl"
    >
      {root &&
        createPortal(
          <>
            <style>{styles}</style>
            <div className={`admin-mock-surface ${isDark ? 'theme-dark' : 'theme-light'} p-4 sm:p-6 lg:p-8 space-y-6`} dir="rtl" lang="ar">
              {/* Top Linking Bar between the 3 Administrative Screens */}
              <div className="flex flex-wrap items-center justify-between gap-3 pb-3 border-b" style={{ borderColor: 'var(--divider-color)' }}>
                <div className="inline-flex p-1 rounded-full v-subcard" role="tablist">
                  {navItems.map((item) => {
                    const active = page === item.id;
                    return (
                      <button
                        type="button"
                        key={item.id}
                        role="tab"
                        aria-selected={active}
                        onClick={() => handleNavigate(item.id as any)}
                        className={`px-4 py-2 rounded-full text-[13px] font-semibold flex items-center gap-2 transition-all duration-150 ${
                          active ? 'shadow-xs' : 'hover:opacity-80'
                        }`}
                        style={{
                          background: active ? 'var(--pill-active-bg)' : 'transparent',
                          color: active ? 'var(--pill-active-text)' : 'var(--text-secondary)',
                        }}
                      >
                        <Icon name={item.icon} className="w-4 h-4" />
                        <span>{item.label}</span>
                        {item.count != null && (
                          <span
                            className="px-2 py-0.5 rounded-full text-[11px] font-medium"
                            style={{
                              background: active ? 'rgba(255, 255, 255, 0.2)' : 'var(--bg-card)',
                              color: active ? 'inherit' : 'var(--text-muted)',
                            }}
                          >
                            {item.count}
                          </span>
                        )}
                      </button>
                    );
                  })}
                </div>

                <div className="flex items-center gap-2 text-[12px]" style={{ color: 'var(--text-muted)' }}>
                  <span>لوحة الإدارة والتحكم</span>
                  <span>•</span>
                  <span dir="auto">{branding.name}</span>
                </div>
              </div>

              {/* Screen Content */}
              {!visible(page) && <EmptyState icon="lock" title="لا تملك صلاحية الوصول لهذه الصفحة" />}
              {visible(page) && page === 'users' && (
                <UsersScreen
                  rolesLoading={rolesQ.loading}
                  can={canFn}
                  onUsersChanged={() => { setUsersTick(t => t+1); rolesQ.reload(); }}
                  roles={roles}
                  onNavigate={handleNavigate}
                  initialRoleFilter={queryParams.role as any}
                  initialUserId={queryParams.userId}
                />
              )}

              {visible(page) && page === 'roles' && rolesQ.error && <EmptyState icon="lock" title={rolesQ.error.message} action={<button type="button" onClick={rolesQ.reload}>إعادة المحاولة</button>} />}
              {visible(page) && page === 'roles' && !rolesQ.error && (
                <RolesScreen
                  roles={roles}
                  rolesLoading={rolesQ.loading}
                  reloadRoles={rolesQ.reload}
                  can={canFn}
                  onNavigate={handleNavigate}
                  initialRoleId={queryParams.roleId}
                />
              )}

              {visible(page) && page === 'settings' && (
                <SettingsScreen can={canFn} onNavigate={handleNavigate} initialTab={queryParams.tab} />
              )}

              <ToastHost />
            </div>
          </>,
          root
        )}
    </div>
  );
}
</file>

<file path="bags-platform/frontend/apps/backoffice/src/pages/admin/admin-mock/settings.tsx">
import React, { useState, useEffect, useMemo, ReactNode } from 'react';
import {
  Icon,
  Toggle,
  Badge,
  Field,
  TextInput,
  GhostButton,
  PageHeader,
  StickyBar,
  Skeleton,
  EmptyState,
  Notice,
  toast,
  fmtDate,
} from './ui';
import { DOC_TYPES, AdminSettings } from './data';
import { useSettingsQuery, runMutation, useQueryError, useMe } from './hooks';
import { adminApi } from './api/endpoints';
import { settingsPatch, settingsExpected, toAdminSettings } from './api/mappers';
import { StoreManagementTab } from './store-management';
import { useBranding } from '@alfarid/ui/branding';

export const SETTINGS_TABS = [
  { key: 'company', label: 'بيانات الشركة', icon: 'building', desc: 'الهوية وترويسة المستندات' },
  { key: 'tax', label: 'الضرائب والفواتير', icon: 'percent', desc: 'القيمة المضافة وطريقة الاحتساب' },
  { key: 'numbering', label: 'ترقيم المستندات', icon: 'hash', desc: '12 نوعاً من الوثائق' },
  { key: 'orders', label: 'سياسة الإرجاع', icon: 'undo', desc: 'مهلة إرجاع المنتجات' },
  { key: 'purchases', label: 'دورة المشتريات', icon: 'truck', desc: 'الاعتماد والرقابة الثنائية' },
  { key: 'store', label: 'إدارة المتجر', icon: 'storefront', desc: 'السلايدر، البانرات والنوافذ المنبثقة' },
];

const clone = <T,>(o: T): T => JSON.parse(JSON.stringify(o));
const fmtMoney = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

interface SectionCardProps {
  title: string;
  subtitle?: string;
  children: ReactNode;
  className?: string;
  aside?: ReactNode;
}

function SectionCard({ title, subtitle, children, className = '', aside }: SectionCardProps) {
  return (
    <div className={`v-card p-6 ${className}`}>
      <div className="flex items-start justify-between gap-4 mb-5">
        <div>
          <h3 className="font-display text-[17px] font-semibold" style={{ color: 'var(--text-primary)' }}>{title}</h3>
          {subtitle && <p className="text-[12.5px] mt-1" style={{ color: 'var(--text-muted)' }}>{subtitle}</p>}
        </div>
        {aside}
      </div>
      {children}
    </div>
  );
}

export function SettingsScreen({ onNavigate, can, initialTab }: { onNavigate?: (page: 'users' | 'roles' | 'settings') => void; can: (p: string) => boolean; initialTab?: string }) {
  const { refreshBranding } = useBranding();
  const query = useSettingsQuery();
  useQueryError(query.error);
  const [server, setServer] = useState<AdminSettings | null>(null);
  const [s, setS] = useState<AdminSettings | null>(null);
  const [tab, setTab] = useState(() => (initialTab === 'store' || initialTab === 'banners') ? 'store' : (initialTab || 'company'));
  const [saving, setSaving] = useState(false);
  const [conflict, setConflict] = useState<string | false>(false);
  const [fieldErrors, setFieldErrors] = useState<Record<string,string[]>>({});
  const { centralAccess } = useMe();
  const editable = centralAccess && ( can('settings.update') || can('settings.manage'));
  const loading = query.loading && !server;

  useEffect(() => {
    if (initialTab) {
      setTab(initialTab === 'banners' ? 'store' : initialTab);
    }
  }, [initialTab]);
  useEffect(() => { if (query.data) { setServer(clone(query.data)); setS(clone(query.data)); setFieldErrors({}); } }, [query.data]);
  const set = (group: keyof AdminSettings, key: string, val: any) =>
    setS(p => p && editable ? ({ ...p, [group]: { ...(p[group] as any), [key]: val } }) : p);

  const setNum = (doc: string, key: string, val: any) =>
    setS(p => p && editable ? ({ ...p, numbering: { ...p.numbering, [doc]: { ...p.numbering[doc], [key]: val } } }) : p);

  // compute changed fields (flat)
  const diffs = useMemo(() => {
    const out: [string, string][] = [];
    if (!s || !server) return out;
    (Object.keys(s) as (keyof AdminSettings)[]).forEach(g => {
      Object.keys(s[g]).forEach(k => {
        if (JSON.stringify((s[g] as any)[k]) !== JSON.stringify((server[g] as any)[k])) {
          out.push([g, k]);
        }
      });
    });
    return out;
  }, [s, server]);

  const dirtyGroups = new Set(diffs.map(d => d[0]));
  const isDirty = diffs.length > 0;

  useEffect(() => {
    if (!isDirty) return;
    const guard = (event: BeforeUnloadEvent) => { event.preventDefault(); event.returnValue = ''; };
    window.addEventListener('beforeunload', guard);
    return () => window.removeEventListener('beforeunload', guard);
  }, [isDirty]);
  const save = async () => {
    if (!s || !server || !editable || saving) return;
    const patch = settingsPatch(s, server);
    if (!Object.keys(patch).length) return;
    setSaving(true); setFieldErrors({});
    const result = await runMutation(() => adminApi.updateSettings({...patch, expected: settingsExpected(patch, server)}));
    setSaving(false);
    if (!result.ok) {
      if (result.error.status === 422) setFieldErrors(result.error.fields);
      if (result.error.status === 409) setConflict(result.error.message);
      if (result.error.status !== 401) toast(result.error.message, 'err');
      return;
    }
    const fresh = toAdminSettings(result.data.data);
    void refreshBranding();
    setServer(clone(fresh)); setS(clone(fresh)); setConflict(false);
    if (result.data.warnings?.length) result.data.warnings.forEach(message => toast(message, 'warn'));
    else toast('تم حفظ الإعدادات بنجاح');
  };
  const reload = () => { setConflict(false); query.reload(); };
  if (query.error && !server && tab !== 'store') return <EmptyState icon="lock" title={query.error.message} action={<GhostButton onClick={query.reload}>إعادة المحاولة</GhostButton>} />;
  if ((!s || !server) && tab !== 'store') return <SettingsSkeleton />;

  return (
    <section className="space-y-5 pb-20" data-screen-label="03 Settings">
      <PageHeader
        title="الإعدادات العامة"
        subtitle="هوية المؤسسة، الضرائب، الترقيم التلقائي للمستندات، سياسات الإرجاع وسير عمل المشتريات."
        action={
          <div className="flex items-center gap-3 stagger-item stagger-2">
            {onNavigate && (
              <GhostButton icon="users" onClick={() => onNavigate('users')}>
                فريق العمل
              </GhostButton>
            )}
          </div>
        }
      />

      {conflict && (
        <div className="v-conflict rounded-[22px] p-4 flex flex-wrap items-center gap-4 v-pop-in">
          <span className="w-10 h-10 rounded-full flex items-center justify-center bg-white/15 shrink-0"><Icon name="alert" className="w-5 h-5" strokeWidth={2.2} /></span>
          <div className="flex-1 min-w-[240px]">
            <div className="font-semibold text-[14px]">تعارض في البيانات (409)</div>
            <div className="text-[12.5px] opacity-85 mt-0.5">{conflict}</div>
          </div>
          <div className="flex items-center gap-2">
            <button type="button" onClick={() => setConflict(false)} className="h-9 px-4 rounded-full text-[12.5px] font-semibold hover:bg-white/10">لاحقاً</button>
            <button type="button" onClick={reload} className="h-9 px-4 rounded-full text-[12.5px] font-semibold bg-white flex items-center gap-1.5" style={{ color: '#c2410c' }}><Icon name="refresh" className="w-3.5 h-3.5" strokeWidth={2.2} />إعادة التحميل</button>
          </div>
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        {/* Tabs rail */}
        <nav className="lg:col-span-3 v-card p-2 stagger-item stagger-2 lg:sticky lg:top-5">
          {SETTINGS_TABS.map((t) => {
            const active = tab === t.key;
            return (
              <button type="button" key={t.key} onClick={() => setTab(t.key)}
                className={`w-full flex items-center gap-3 p-3 rounded-2xl text-start transition ${active ? 'v-tab-active' : 'v-tab'}`}>
                <span className={`w-9 h-9 rounded-xl flex items-center justify-center shrink-0 ${active ? 'text-white v-accent-btn' : 'v-icon-well'}`}><Icon name={t.icon} className="w-4 h-4" /></span>
                <div className="flex-1 min-w-0">
                  <div className="text-[13px] font-semibold" style={{ color: 'var(--text-primary)' }}>{t.label}</div>
                  <div className="text-[11px] truncate" style={{ color: 'var(--text-muted)' }}>{t.desc}</div>
                </div>
                {dirtyGroups.has(t.key) && <span className="w-2 h-2 rounded-full shrink-0" style={{ background: 'var(--accent-orange)' }} title="تعديلات غير محفوظة" />}
              </button>
            );
          })}
        </nav>

        <div className="lg:col-span-9 stagger-item stagger-3" key={tab}>
          {tab === 'store' ? (
            <StoreManagementTab can={can} />
          ) : (!s || !server || loading) ? <SettingsSkeleton /> : (
            <fieldset disabled={!editable || saving} className="v-tab-in space-y-5">
              {tab === 'company' && <CompanyTab errors={fieldErrors} v={s.company} set={(k, val) => set('company', k, val)} />}
              {tab === 'tax' && <TaxTab errors={fieldErrors} v={s.tax} set={(k, val) => set('tax', k, val)} />}
              {tab === 'numbering' && <NumberingTab errors={fieldErrors} v={s.numbering} server={server.numbering} setNum={setNum} />}
              {tab === 'orders' && <ReturnsTab v={s.orders} set={(k, val) => set('orders', k, val)} />}
              {Object.entries(fieldErrors).filter(([key]) => !['company','tax','numbering'].includes(tab) && key in s[tab as 'orders' | 'purchases']).map(([key,messages]) => <div role="alert" key={key}>{messages.join('، ')}</div>)}
              {tab === 'purchases' && <PurchasesTab v={s.purchases} set={(k, val) => set('purchases', k, val)} />}
            </fieldset>
          )}
        </div>
      </div>

      <StickyBar show={isDirty && editable} onSave={save} onReset={() => setS(clone(server))} saving={saving} count={diffs.length} />
    </section>
  );
}

function SettingsSkeleton() {
  return (
    <div className="v-card p-6 space-y-5">
      <Skeleton className="h-5 w-40 rounded" /><Skeleton className="h-3 w-64 rounded" />
      <div className="flex gap-4 pt-2"><Skeleton className="w-24 h-24 rounded-2xl" /><div className="flex-1 space-y-3"><Skeleton className="h-11 rounded-2xl" /><Skeleton className="h-3 w-40 rounded" /></div></div>
      <div className="grid grid-cols-2 gap-4">{[1, 2, 3, 4].map(i => <Skeleton key={i} className="h-11 rounded-2xl" />)}</div>
      <Skeleton className="h-24 rounded-2xl" />
    </div>
  );
}

/* ---------- Tab 1: Company ---------- */
