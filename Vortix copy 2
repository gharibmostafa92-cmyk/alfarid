Copyfinal class UpdateVariantTool implements WriteTool, UndoableTool, LocksTargets
{
    public function __construct(
        private VariantService $variants,
        private ProposalBuilder $proposals,
        private CatalogPresenter $presenter,
    ) {}

    public function name(): string { return 'update_variant'; }
    public function kind(): ToolKind { return ToolKind::Write; }
    public function risk(): string { return 'medium'; }
    public function permissions(): array { return ['products.update']; }

    public function declaration(): array
    {
        return ['name' => $this->name(),
            'description' => 'تعديل متغير منتج واحد (سعر/لون/مقاس/حالة). للأسعار الجماعية استخدم bulk_update_prices.',
            'parameters' => ['type' => 'object', 'required' => ['variant_id'], 'properties' => [
                'variant_id' => ['type' => 'integer'],
                'retail_price' => ['type' => 'number'], 'wholesale_price' => ['type' => 'number'],
                'cost_price' => ['type' => 'number'], 'color' => ['type' => 'string'],
                'size' => ['type' => 'string'], 'is_active' => ['type' => 'boolean'],
            ]]];
    }

    public function prepare(User $actor, array $args): ToolOutcome
    {
        $variant = ProductVariant::with('product')->find($args['variant_id'])
            ?? return ToolOutcome::denied('المتغير مش موجود.', auditable: false);
        if (! CostAccess::canView($actor)) unset($args['cost_price']);
        $data = CatalogArgs::normalizeVariant($args);          // ألوان + أرقام عربية + uppercase
        CatalogArgs::validate($data, UpdateVariantRules::for($variant)); // يرمي ValidationException (non-auditable)
        $warnings = CatalogWarnings::forVariantChange($variant, $data); // آخر متغير نشط؟ قابلية النشر؟
        return $this->proposals->make($actor, $this->name(), $data + ['variant_id' => $variant->id],
            risk: $this->risk(),
            title: "تعديل {$variant->sku}",
            before: $this->presenter->variant($variant, $actor),
            after: $this->presenter->variant($variant->replicate()->fill($data), $actor),
            warnings: $warnings,
            expectedVersions: ['variant:'.$variant->id => $variant->lock_version],
            inverse: Arr::only($variant->getAttributes(), array_keys($data)));
    }

    public function lockTargets(AiPendingAction $a): void { CatalogLock::tree(shared: true); }

    public function execute(User $actor, AiPendingAction $a): ToolOutcome
    {
        $variant = ProductVariant::findOrFail($a->args['variant_id']);
        $data = Arr::except($a->args, ['variant_id']) + ['expected_version' => $a->expected_versions['variant:'.$variant->id]];
        $variant = $this->variants->update($variant, $data);
        return ToolOutcome::result(true, 'اتعدل المتغير.', ['deep_link' => "#/products/{$variant->product_id}"]);
    }

    public function canUndo(AiPendingAction $a): bool { return $a->inverse !== null; }
    public function targetState(AiPendingAction $a): string
    {
        $v = ProductVariant::findOrFail($a->args['variant_id']);
        return hash('sha256', json_encode([$v->lock_version, Arr::only($v->getAttributes(), array_keys($a->inverse))]));
    }
    public function undo(User $actor, AiPendingAction $a): ToolOutcome { /* update بالـ inverse */ }
}
