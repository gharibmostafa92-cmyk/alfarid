المرحلة 0: سد الثغرات في الدومين قبل ما نلمس الـ AI
لقيت في الكود فجوات لازم تتقفل الأول، وإلا المساعد هيقترح حاجات مفيش مسار يتنفذ بيه.

0.1 مفيش طريقة لإعادة تفعيل تاجر موقوف
CustomerManagementService فيه suspend بس، ومفيش reactivate. يعني أي تاجر بيتوقف بيفضل موقوف للأبد إلا لو حد عدّل الداتابيز بإيده.

ضيف في CustomerManagementService:

Copypublic function reactivate(Customer $customer, ?int $actorId = null, array $via = []): Customer
{
    return DB::transaction(function () use ($customer, $actorId, $via) {
        $locked = Customer::query()->lockForUpdate()->findOrFail($customer->id);
        if ($locked->status !== CustomerStatus::Suspended) {
            throw new BusinessException('الحساب مش موقوف.');
        }
        // لو كان معتمد قبل كده يرجع Approved، غير كده يرجع Pending
        $locked->status = $locked->approved_at ? CustomerStatus::Approved : CustomerStatus::Pending;
        $locked->suspension_reason = null;
        $locked->save(); // constraint customers_approved_business هيحمي لو البيانات القانونية ناقصة
        CustomerAuditLog::record($locked, 'reactivated', $actorId, ['via' => $via]);
        return $locked->fresh(['customerGroup']);
    });
}
ضيف كمان route اسمه POST customers/{customer}/reactivate في routes/api/admin.php، ودالة reactivate في CustomerController، وخليها في الـ middleware تحت can:customers.approve.

0.2 مفيش endpoint يعرض سجل تغييرات العميل
CustomerAuditLog بيتسجل فيه كل حاجة، بس مفيش أي endpoint بيقرا منه، وده رغم إن P04-M01-F05 بيطلب "تاريخ تغييرات ملفه" صراحة.

ضيف GET customers/{customer}/history تحت can:customers.view، وخليه paginated (25 في الصفحة)، ويرجّع action, actor{id,name}, metadata, created_at ومرتّب من الأحدث للأقدم. الـ index (customer_id, created_at) موجود أصلًا.

0.3 رفض المستند مالوش سبب
reviewDocument بيسجّل status وreviewed_by وreviewed_at، لكن مفيش مكان يتكتب فيه سبب الرفض. التاجر بيشوف "مرفوض" من غير ما يعرف ليه.

اعمل migration اسمه 2026_11_04_000001_add_review_note_to_customer_documents.php يضيف review_note text nullable. بعدها ضيف ?string $note = null لـ reviewDocument، وخليه required لما status = rejected على مستوى الـ request (required_if:status,rejected|max:500). اعرض الحقل في CustomerResource وفي applicationStatus() جوه rejected_documents.

0.4 تمرير قناة التنفيذ للـ audit
كل دوال الـ service بتاخد $actorId بس. ضيف باراميتر أخير اختياري array $via = [] لكل من create, update, approve, reject, suspend, restore, reviewDocument, reactivate، وادمجه في metadata تحت المفتاح via. كده سجل العميل هيبيّن إن التعديل اتعمل من المساعد (channel=ai, conversation_id, action_id). REST يفضل شغال زي ما هو، لأن القيمة الافتراضية فاضية.

0.5 الإشعار بيتبعت قبل ما الـ transaction تخلص
approve وreject بيعملوا WholesaleApplicationReviewed::dispatch جوه DB::transaction، والـ listener SendWholesaleApplicationReviewed من نوع ShouldQueue. في مسار الـ AI التنفيذ بيحصل جوه transaction متداخلة في PendingActionService، فلو حصل rollback بعد الـ dispatch، التاجر ممكن يوصله "اتقبلت" على حاجة متنفذتش أصلًا.

الحل إن الـ listener يعمل implement لـ Illuminate\Contracts\Events\ShouldHandleEventsAfterCommit. ده سطر واحد، وبيقفل الثغرة دي في REST والـ AI مع بعض.

0.6 بصمة نسخة للعميل (Optimistic Concurrency)
جدول customers مفيهوش lock_version. الفروع بتستخدم branchVersion()، وهي hash للصف الخام كله. لو نقلنا نفس الفكرة للعملاء زي ما هي هتبقى غلطة، لأن wallet_balance وupdated_at بيتغيروا مع كل طلب أو حركة محفظة، فكل كارت تأكيد هيتلغي بـ 409 من غير سبب حقيقي.

ضيف في ToolRegistry:

Copyprivate const CUSTOMER_VERSION_FIELDS = [
    'status', 'type', 'customer_group_id', 'credit_limit', 'company_name',
    'tax_number', 'commercial_register', 'email', 'phone', 'deleted_at',
    'rejection_reason', 'suspension_reason',
];

private function customerVersion(Customer $c): string
{
    return $this->hashArgs(Arr::only($c->getRawOriginal(), self::CUSTOMER_VERSION_FIELDS));
}

private function documentVersion(CustomerDocument $d): string
{
    return $this->hashArgs(Arr::only($d->getRawOriginal(), ['status', 'reviewed_at', 'customer_id']));
}

private function customerGroupVersion(CustomerGroup $g): string
{
    return $this->hashArgs(Arr::only($g->getRawOriginal(), ['name', 'code', 'discount_percentage', 'is_active']));
}
معايير قبول المرحلة 0: اختبارات Feature لـ reactivate (موقوف كان معتمد قبل كده يرجع معتمد، وموقوف عمره ما اتعمد يرجع pending، والحساب الشغال يرجّع 422). كمان اختبار لـ history بيتأكد إن مستخدم من غير customers.view بياخد 403، واختبار إن الإشعار مبيتبعتش لو حصل rollback (Event::fake + DB::rollBack).

