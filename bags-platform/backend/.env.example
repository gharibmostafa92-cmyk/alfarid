APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:5173
# Additional exact frontend origins, comma-separated, for local network development.
CORS_ALLOWED_ORIGINS=
# Seconds browsers may cache a CORS preflight (0 doubles API traffic).
CORS_MAX_AGE=600
# Demo only: expose X-Served-By so buyers see requests spread across nodes.
APP_EXPOSE_NODE_HEADER=false
# For local network access only: SERVER_HOST=0.0.0.0
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=1440
SANCTUM_TRACK_LAST_USED=false
CUSTOMER_REQUIRE_PHONE_VERIFICATION=true
CUSTOMER_MAX_TOKENS=10
SUPPLIER_MAX_TOKENS=5
STAFF_MAX_TOKENS=20
STAFF_TOKEN_MINUTES=120
STAFF_CURRENT_PASSWORD_FAILURES=5
STAFF_ADMIN_MUTATIONS_MINUTE=60
STAFF_AUDIT_RETENTION_DAYS=365
LEGACY_LOGIN_ENABLED=false
UNIFIED_LOGIN_IP_MINUTE=120
UNIFIED_LOGIN_FAILURES_HOUR=10
UNIFIED_LOGIN_IP_FAILURES_HOUR=1000
UNIFIED_LOGIN_FAILURES_DAY=1000
UNIFIED_HANDOFF_IP_MINUTE=60
CUSTOMER_DAILY_MESSAGES=5
# Configure only your actual reverse-proxy IPs/CIDRs in production.
# TRUSTED_PROXIES=10.0.0.10,192.0.2.0/24

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_DISABLE_PREPARES=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alfarid
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# Production: use CACHE_STORE=redis and CACHE_LIMITER=redis (see .env.production.example).
CACHE_LIMITER=
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# HTTPS gateway receiving JSON {"to": "phone", "message": "text"} with Bearer authentication.
CUSTOMER_SMS_URL=
CUSTOMER_SMS_TOKEN=
CUSTOMER_PASSWORD_RESET_QUEUE_CONNECTION=database
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# All uploaded files and generated image sizes use R2 exclusively.
# R2 is required; there is no local upload fallback.
MEDIA_DISK=r2
MEDIA_CONVERSIONS_DISK=r2
R2_ACCOUNT_ID=
R2_JURISDICTION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_KEY_PREFIX=alfarid
# Public catalog CDN URL, including R2_PUBLIC_KEY_PREFIX. Required for catalog images.
R2_PUBLIC_URL=
# H5: separate public bucket for catalog media (products/variants/categories/
# brands). Private documents always stay on R2_BUCKET_NAME with signed URLs.
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_KEY_PREFIX=alfarid
R2_DOWNLOAD_URL_TTL_SECONDS=3600

# Server-side Gemini API; never expose this key through VITE_ or NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INVOICE_MODEL=
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=2048
# Optional trusted CA bundle when PHP cannot use the operating system trust store.
INTEGRATIONS_CA_BUNDLE=

VITE_APP_NAME="${APP_NAME}"

# Mandatory in production: exact proxy IPs/CIDRs, or none for a direct origin.
# The edge must replace incoming forwarding headers; never use * in production.
TRUSTED_PROXIES=none
CUSTOMER_SMS_DAILY_LIMIT=1000
CUSTOMER_SMS_HOURLY_LIMIT=100
CUSTOMER_REGISTRATION_IP_MINUTE=20
CUSTOMER_REGISTRATION_IP_DAY=500
CUSTOMER_PHONE_IP_MINUTE=20
CUSTOMER_PHONE_IP_DAY=500
STORE_CATALOG_IP_MINUTE=600
STORE_PRICE_IP_MINUTE=20
STORE_PRICE_GLOBAL_MINUTE=200
CUSTOMER_LOGIN_ID_HOUR=30
CUSTOMER_LOGIN_ID_DAY=100
# SMS gateway must return a 2xx JSON response with {"success":true} on acceptance.
CUSTOMER_PHONE_VERIFY_IP_MINUTE=120
CUSTOMER_RESET_CONFIRM_IP_MINUTE=120
CUSTOMER_LOGIN_IP_MINUTE=120
CUSTOMER_RESET_IP_MINUTE=20
CUSTOMER_RESET_IP_DAY=500
