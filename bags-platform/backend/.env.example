APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=1440
SANCTUM_TRACK_LAST_USED=false
CUSTOMER_REQUIRE_PHONE_VERIFICATION=true
CUSTOMER_MAX_TOKENS=10
SUPPLIER_MAX_TOKENS=5
STAFF_MAX_TOKENS=20
LEGACY_LOGIN_ENABLED=true
UNIFIED_LOGIN_IP_MINUTE=120
UNIFIED_LOGIN_ID_HOUR=100
CUSTOMER_DAILY_MESSAGES=5
# Configure only your actual reverse-proxy IPs/CIDRs in production.
# TRUSTED_PROXIES=10.0.0.10,192.0.2.0/24

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alfarid
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# HTTPS gateway receiving JSON {"to": "phone", "message": "text"} with Bearer authentication.
CUSTOMER_SMS_URL=
CUSTOMER_SMS_TOKEN=
CUSTOMER_PASSWORD_RESET_QUEUE_CONNECTION=database
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mandatory in production: exact proxy IPs/CIDRs, or none for a direct origin.
# The edge must replace incoming forwarding headers; never use * in production.
TRUSTED_PROXIES=none
CUSTOMER_SMS_DAILY_LIMIT=1000
CUSTOMER_SMS_HOURLY_LIMIT=100
CUSTOMER_REGISTRATION_IP_MINUTE=20
CUSTOMER_REGISTRATION_IP_DAY=500
CUSTOMER_PHONE_IP_MINUTE=20
CUSTOMER_PHONE_IP_DAY=500
STORE_CATALOG_IP_MINUTE=600
STORE_PRICE_IP_MINUTE=20
STORE_PRICE_GLOBAL_MINUTE=200
CUSTOMER_LOGIN_ID_HOUR=30
CUSTOMER_LOGIN_ID_DAY=100
# SMS gateway must return a 2xx JSON response with {"success":true} on acceptance.
CUSTOMER_PHONE_VERIFY_IP_MINUTE=120
CUSTOMER_RESET_CONFIRM_IP_MINUTE=120
CUSTOMER_LOGIN_IP_MINUTE=120
CUSTOMER_RESET_IP_MINUTE=20
CUSTOMER_RESET_IP_DAY=500
