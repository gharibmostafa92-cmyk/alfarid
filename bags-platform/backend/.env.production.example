# Merge these production cache/session settings into a securely configured deployment.
# Redis must be provisioned and reachable before selecting these stores.
APP_ENV=production
APP_DEBUG=false
CACHE_STORE=redis
CACHE_LIMITER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
STAFF_TOKEN_MINUTES=120
UNIFIED_LOGIN_IP_FAILURES_HOUR=1000
UNIFIED_LOGIN_IDENTIFIER_FAILURES_HOUR=30
UNIFIED_LOGIN_FAILURES_DAY=100
QUEUE_CONNECTION=database
MEDIA_QUEUE_CONNECTION=database
CUSTOMER_TOKEN_MINUTES=1440
LOG_STACK=daily
# Set explicit trusted proxy IPs/CIDRs, or none when exposed directly.
TRUSTED_PROXIES=none
# F17: never leave the log mailer or a downgradable sslmode in production.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
DB_SSLMODE=require
LOG_LEVEL=info
