# Production behind HAProxy (multi-node). Redis must be reachable via haproxy-data.
APP_ENV=production
APP_DEBUG=false
CUSTOMER_REQUIRE_PHONE_VERIFICATION=true
APP_EXPOSE_NODE_HEADER=true
CACHE_STORE=redis
CACHE_LIMITER=redis
SESSION_DRIVER=array
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
# QUEUE_CONNECTION stays database on purpose: PostgreSQL distributes jobs across
# workers without duplication, and after_commit=true keeps jobs after commit.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
MEDIA_QUEUE_CONNECTION=database-media
MEDIA_QUEUE=media
REDIS_CLIENT=phpredis
REDIS_HOST=haproxy-data
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
STAFF_TOKEN_MINUTES=120
SUPPLIER_TOKEN_MINUTES=720
UNIFIED_LOGIN_IP_FAILURES_HOUR=1000
UNIFIED_LOGIN_IDENTIFIER_FAILURES_HOUR=30
UNIFIED_LOGIN_FAILURES_DAY=100
CUSTOMER_TOKEN_MINUTES=1440
LOG_STACK=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info
# HAProxy 1 + HAProxy 2 only. Storefront SSR nodes are never trusted proxies directly;
# they pass through fe_internal or sign client IPs with PROXY_CLIENT_IP_SECRET.
# Never use * in production (AppServiceProvider throws a LogicException on wildcards).
TRUSTED_PROXIES=172.31.0.10,172.31.0.11
# Generate with: openssl rand -hex 32. The storefront proxy signs the client
# address with the same value (API_PROXY_CLIENT_IP_SECRET in Next.js).
PROXY_CLIENT_IP_SECRET=
# POS origin must be listed so its browser calls pass CORS; add real domains here.
CORS_ALLOWED_ORIGINS=https://api.alfarid.example,https://admin.alfarid.example,https://pos.alfarid.example
CORS_MAX_AGE=600
# F17: never leave the log mailer or a downgradable sslmode in production.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
DB_HOST=pgbouncer
DB_PORT=6432
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/alfarid-db-ca/root.crt
DB_DISABLE_PREPARES=true

# Reserve at least 40% of SMS capacity for password recovery.
CUSTOMER_SMS_VERIFICATION_FRACTION=0.6
CUSTOMER_SMS_VERIFICATION_NETWORK_DAILY_LIMIT=10

# F15: set one unique secret and store it as the storage_cleanup_owner setting;
# cleanup also requires the .alfarid-cleanup-owner object with the DB-bound marker.
R2_CLEANUP_OWNER=

# Store RESEND_API_KEY in Secret Manager and expose it only to the delivery worker.
# Set RESEND_FROM_ADDRESS to an address on a verified Resend domain before enabling delivery.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_ENVIRONMENT=production
CUSTOMER_EMAIL_CAPTURE_ENABLED=false
CUSTOMER_EMAIL_DELIVERY_ENABLED=false
