{
  "name": "alfarid-frontend-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:storefront": "pnpm --filter @alfarid/storefront dev",
    "dev:backoffice": "pnpm --filter @alfarid/backoffice dev",
    "dev:pos": "turbo dev --filter=@alfarid/pos",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --experimental-strip-types --test \"tests/*.test.cjs\"",
    "test:utils": "node --test tests/utils-formatters.test.cjs",
    "test:operations": "node --test tests/operations-core.test.cjs tests/operations-hooks.test.cjs tests/operations-commerce.test.cjs tests/operations-finance.test.cjs tests/operations-suppliers.test.cjs",
    "test:operations:e2e": "node tests/operations.e2e.cjs",
    "test:assistant": "node --test tests/assistant.test.cjs",
    "test:assistant:e2e": "node tests/assistant.e2e.cjs",
    "test:wholesale": "node --test tests/wholesale-portal.test.cjs",
    "test:wholesale:e2e": "node tests/wholesale-portal.e2e.cjs",
    "test:pricing:frontend": "node --experimental-strip-types --test tests/sse-parser.test.cjs tests/operations-commerce.test.cjs",
    "generate:types": "pnpm --filter @alfarid/api-client generate:types"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
