{
  "name": "alfarid-frontend-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "turbo dev",
    "dev:storefront": "turbo dev --filter=@alfarid/storefront",
    "dev:backoffice": "turbo dev --filter=@alfarid/backoffice",
    "dev:pos": "turbo dev --filter=@alfarid/pos",
    "build": "turbo build",
    "lint": "turbo lint",
    "generate:types": "pnpm --filter @alfarid/api-client generate:types"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
