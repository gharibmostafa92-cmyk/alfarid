VITE_API_URL=http://localhost:8000
VITE_CSP_IMG_ORIGINS=
VITE_ATTACHMENT_ALLOWED_HOSTS=
VITE_WEB_URL=http://localhost:3000
# Additional API/WebSocket origins, comma separated, for the production CSP.
VITE_CSP_CONNECT_ORIGINS=

# POS data source: 'api' (real backend) or 'mock' (instant rollback to the prototype data)
VITE_POS_SOURCE=api

# Blank DSN disables Sentry in local development and ordinary CI.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Build-time identifiers. Supply SENTRY_AUTH_TOKEN through the protected build environment only.
SENTRY_ORG=akgroup-ig
SENTRY_PROJECT=alfarid-backoffice

# Dev-only: paste a freshly issued staff token into .env.local as VITE_DEV_TOKEN (never commit it).
