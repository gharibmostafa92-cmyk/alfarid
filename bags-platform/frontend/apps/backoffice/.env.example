VITE_API_URL=http://localhost:8000
VITE_WEB_URL=http://localhost:3000
# Additional API/WebSocket origins, comma separated, for the production CSP.
VITE_CSP_CONNECT_ORIGINS=

# POS data source: 'api' (real backend) or 'mock' (instant rollback to the prototype data)
VITE_POS_SOURCE=api

# Dev-only: paste a freshly issued staff token into .env.local as VITE_DEV_TOKEN (never commit it).
