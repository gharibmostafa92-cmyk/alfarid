NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional API address reachable from the Next.js server (for Docker or a reverse proxy).
# API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:5173
# Shared HMAC secret with the API's PROXY_CLIENT_IP_SECRET. Required behind
# Cloud Run so the API can trust the forwarded client address.
API_PROXY_CLIENT_IP_SECRET=
# Optional IAM-private origin for assistant streams and synchronous turns.
# PRIVATE_CLOUD_RUN_AI_ORIGIN=https://alfarid-ai-example.run.app
# IAM-private Cloud Run API origin used by the storefront /api/v1 proxy.
PRIVATE_CLOUD_RUN_API_ORIGIN=
# Public object-storage origin. next.config.mjs reads R2_PUBLIC_URL, then NEXT_PUBLIC_R2_PUBLIC_URL.
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=
# Number of trusted proxy hops appending to X-Forwarded-For (1 = direct Cloud Run, 2 = CDN/LB + Cloud Run).
# A shorter chain than this hop count trusts only the rightmost address.
TRUSTED_PROXY_HOPS=1
# Namespaces the storefront proxy may forward. Admin, POS, and webhooks stay off unless this list includes them.
# API_PROXY_ALLOWED_NAMESPACES=auth,store,wholesale,supplier
API_PROXY_ALLOWED_ORIGINS=http://localhost:3000
# Supplier portal remains disabled until its operational acceptance is complete.
NEXT_PUBLIC_SUPPLIER_PORTAL_ENABLED=false

# Optional Sentry error and performance monitoring. Keep browser DSN public and
# provide the server DSN separately through the runtime secret manager.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Build-only identifiers/token: pass SENTRY_AUTH_TOKEN via the protected build secret.
SENTRY_ORG=akgroup-ig
SENTRY_PROJECT=alfarid-storefront
