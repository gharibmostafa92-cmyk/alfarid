# Copy using: node scripts/setup.mjs (creates random local credentials).
APP_NAME=Alfarid
APP_KEY=
APP_URL=https://api.alfarid.example:8443
APP_EXPOSE_NODE_HEADER=false
DB_CONNECTION=pgsql
DB_USERNAME=alfarid
DB_PASSWORD=
REDIS_PASSWORD=
HAPROXY_STATS_PASSWORD=
GRAFANA_PASSWORD=
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=2525
FILESYSTEM_DISK=r2
MEDIA_DISK=r2
BANNERS_DISK=r2_public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
PUBLIC_API_URL=https://api.alfarid.example:8443
PUBLIC_WEB_URL=https://alfarid.example:8443
CORS_ALLOWED_ORIGINS=https://alfarid.example:8443,https://admin.alfarid.example:8443,https://pos.alfarid.example:8443
CORS_MAX_AGE=600
# Demo ports avoid other local projects. Set 80/443 on dedicated production hosts.
HTTP_PORT=8088
HTTPS_PORT=8443
HTTP_BACKUP_PORT=8089
HTTPS_BACKUP_PORT=8444
STATS_PORT=8404
PROMETHEUS_PORT=9098
GRAFANA_PORT=3008
# Local 8 GB Docker VM. For dedicated 4 GB app hosts, measure RSS and size pools.
APP_MAXCONN=8
APP_SLOW_MAXCONN=2
