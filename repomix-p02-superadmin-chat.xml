<file path="bags-platform/backend/app/Http/Controllers/Api/V1/Admin/BranchController.php">
<?php

declare(strict_types=1);

namespace App\Http\Controllers\Api\V1\Admin;

use App\Exceptions\BusinessException;
use App\Http\Controllers\Controller;
use App\Http\Requests\Api\V1\Admin\StoreBranchRequest;
use App\Http\Requests\Api\V1\Admin\UpdateBranchRequest;
use App\Http\Resources\Api\V1\Admin\BranchResource;
use App\Models\Branch;
use App\Models\StockLevel;
use App\Models\StockTransfer;
use App\Services\BranchAccess;
use Illuminate\Database\QueryException;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\DB;

class BranchController extends Controller
{
    public function __construct(private readonly BranchAccess $branchAccess) {}

    public function index(Request $request): AnonymousResourceCollection
    {
        $validated = $request->validate([
            'per_page' => ['sometimes', 'integer', 'min:1', 'max:100'],
        ]);

        $branches = Branch::query()
            ->withCount(['locations', 'users'])
            ->orderBy('id')
            ->paginate($validated['per_page'] ?? 15)
            ->withQueryString();

        return BranchResource::collection($branches);
    }

    public function store(StoreBranchRequest $request): JsonResponse
    {
        // M4: الفروع كيانات مركزية — إنشاؤها ليس لموظف فرع مقيّد.
        $this->branchAccess->assertCentralAccess($request->user());
        $branch = Branch::query()->create($request->validated());

        return $this->branchResource($branch)->response()->setStatusCode(201);
    }

    public function show(Branch $branch): BranchResource
    {
        return $this->branchResource($branch);
    }

    public function update(UpdateBranchRequest $request, Branch $branch): BranchResource
    {
        $this->branchAccess->assertCentralAccess($request->user());
        DB::transaction(function () use ($request, $branch): void {
            $locked = Branch::query()->lockForUpdate()->findOrFail($branch->id);
            if (array_key_exists('is_active', $request->validated()) && ! $request->boolean('is_active') && (
                StockLevel::query()->where('branch_id', $locked->id)->where('in_transit', '>', 0)->exists()
                || StockTransfer::query()->where('to_branch_id', $locked->id)->where('status', 'shipped')->exists()
            )) {
                throw new BusinessException('لا يمكن تعطيل الفرع قبل استلام التحويلات المشحونة إليه.');
            }
            $locked->update($request->validated());
        });
        $branch->refresh();

        return $this->branchResource($branch);
    }

    private function branchResource(Branch $branch): BranchResource
    {
        return BranchResource::make($branch->loadCount(['locations', 'users']));
    }

    public function destroy(Request $request, Branch $branch): JsonResponse|Response
    {
        $this->branchAccess->assertCentralAccess($request->user());

        try {
            $deleted = DB::transaction(function () use ($branch): bool {
                $lockedBranch = Branch::query()
                    ->whereKey($branch->getKey())
                    ->lockForUpdate()
                    ->firstOrFail();

                if ($lockedBranch->users()->exists()) {
                    return false;
                }

                // L3: ضمان الـ FK يكفي للدفتر — بلا مسح Schema في كل طلب.
                // كل حركات التطبيق تحمل branch_id، وحركات المواقع تُمسك
                // أيضًا بضمان FK عند حذف الموقع تباعًا.
                $hasMovements = DB::table('stock_movements')
                    ->where('branch_id', $lockedBranch->getKey())
                    ->exists();
                if ($hasMovements) {
                    return false;
                }

                // L3: الصفرية تُنظَّف (حذف الفرع يحذف مواقعه تباعًا)، وغير
                // الصفرية تُرفض برسالة مفهومة بدل 409 مبهم.
                $hasBalances = StockLevel::query()->where('branch_id', $lockedBranch->getKey())
                    ->hasNonZeroBalance()
                    ->exists();
                if ($hasBalances) {
                    throw new BusinessException('لا يمكن حذف الفرع وفيه أرصدة (متاح/محجوز/تالف/في الطريق)؛ صفّرها أولًا.');
                }
                StockLevel::query()->where('branch_id', $lockedBranch->getKey())->delete();

                $lockedBranch->delete();

                return true;
            });
        } catch (QueryException $exception) {
            if (! $this->isIntegrityConstraintViolation($exception)) {
                throw $exception;
            }

            return $this->conflictResponse();
        }

        if (! $deleted) {
            return $this->conflictResponse();
        }

        return response()->noContent();
    }

    private function isIntegrityConstraintViolation(QueryException $exception): bool
    {
        $sqlState = (string) ($exception->errorInfo[0] ?? $exception->getCode());

        return in_array($sqlState, ['23000', '23503'], true);
    }

    private function conflictResponse(): JsonResponse
    {
        return response()->json([
            'message' => 'لا يمكن حذف الفرع لارتباطه بموظفين أو حركات مخزنية.',
        ], 409);
    }
}
</file>

<file path="bags-platform/backend/app/Http/Controllers/Api/V1/Auth/UnifiedAuthController.php">
<?php

declare(strict_types=1);

namespace App\Http\Controllers\Api\V1\Auth;

use App\Enums\CustomerStatus;
use App\Enums\CustomerType;
use App\Exceptions\BusinessException;
use App\Http\Controllers\Controller;
use App\Http\Requests\Api\V1\Auth\HandoffExchangeRequest;
use App\Http\Requests\Api\V1\Auth\UnifiedLoginRequest;
use App\Http\Resources\Api\V1\Admin\UserResource;
use App\Http\Resources\Api\V1\Supplier\SupplierUserResource;
use App\Http\Resources\Store\CustomerResource;
use App\Models\Customer;
use App\Models\SupplierUser;
use App\Models\User;
use App\Services\Auth\LoginDestinationResolver;
use App\Services\Auth\StaffHandoffService;
use App\Services\Auth\StaffTokenService;
use App\Services\Auth\UnifiedAuthService;
use App\Services\CartService;
use App\Services\CustomerAuthService;
use Illuminate\Contracts\Cache\LockTimeoutException;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\DB;

class UnifiedAuthController extends Controller
{
    public function __construct(
        private readonly UnifiedAuthService $auth,
        private readonly LoginDestinationResolver $destinations,
        private readonly StaffHandoffService $handoff,
        private readonly CustomerAuthService $customerAuth,
        private readonly CartService $carts,
    ) {}

    public function login(UnifiedLoginRequest $request): JsonResponse
    {
        $data = $request->validated();
        $actor = $this->auth->attempt($data['login'], $data['password']);
        $redirect = $this->destinations->resolve($actor, $data['redirect'] ?? null);

        if ($actor instanceof User) {
            return $this->respond('staff', $redirect, null, $this->handoff->issue($actor),
                ['id' => $actor->id, 'name' => $actor->name], 'active');
        }

        if ($actor instanceof SupplierUser) {
            $actor->load('supplier');

            return $this->respond('supplier', $redirect, $this->issueSupplierToken($actor), null,
                SupplierUserResource::make($actor)->resolve($request), 'active');
        }

        /** @var Customer $actor */
        $token = $this->customerAuth->issueToken($actor, $actor->type === CustomerType::Retail ? 'store-token' : 'wholesale-token');
        // M10: الدمج best-effort بعد إصدار التوكن — فشله لا يُفشل الدخول ولا
        // يُيتّم التوكن؛ يُبلغ الفرونت بالنتيجة ليحتفظ بـ cart_session عند الفشل.
        $cartMerged = true;
        try {
            $this->carts->mergeGuestCart($actor, $request->header('X-Cart-Session'));
        } catch (\Throwable $exception) {
            report($exception);
            $cartMerged = false;
        }

        return $this->respond('customer', $redirect, $token, null,
            CustomerResource::make($actor)->resolve($request), $actor->status->value,
            $actor->type->value, $cartMerged);
    }

    public function exchange(HandoffExchangeRequest $request): JsonResponse
    {
        // L3: الكود المستهلك يُعامل كغير صالح (401)، أما أعطال البنية
        // (قاعدة/كاش) فتُترك لتُرجع 503/500 بدل ابتلاعها في 401 مضلل.
        try {
            $payload = $this->handoff->consume($request->validated()['code']);
        } catch (LockTimeoutException $exception) {
            report($exception);
            $payload = null;
        }
        $user = $payload ? User::query()->find($payload['user_id']) : null;

        if (! $user instanceof User || ! $user->is_active || $user->is_system || ! is_string($payload['credentials'] ?? null)) {
            logger()->info('staff.handoff', ['ip' => $request->ip(), 'result' => 'rejected']);

            return response()->json(['message' => 'رابط الدخول غير صالح أو انتهت صلاحيته.'], 401);
        }

        // تُحسم الوجهة (بما فيها فحص الأدوار/الفرع) قبل إصدار أي توكن حتى
        // لا يتخلف توكن يتيم عند الرفض.
        $user->load(['branch', 'roles.permissions', 'permissions']);
        $redirect = $this->destinations->resolve($user);

        $token = app(StaffTokenService::class)->issue($user, $payload['credentials']);

        logger()->info('staff.handoff', ['user_id' => $user->id, 'ip' => $request->ip(), 'result' => 'success']);

        return response()->json([
            'data' => UserResource::make($user)->resolve($request),
            'token' => $token,
            'redirect' => $redirect,
        ]);
    }

    public function me(Request $request): JsonResponse
    {
        $actor = $request->user('sanctum');

        if ($actor instanceof User) {
            abort_unless($actor->is_active && ! $actor->is_system, 403);
            $actor->load(['branch', 'roles.permissions', 'permissions']);
            $redirect = $this->destinations->resolve($actor);

            return response()->json(['actor' => ['type' => 'staff', 'subtype' => $redirect['destination']],
                'redirect' => $redirect,
                'data' => UserResource::make($actor)->resolve($request)]);
        }

        if ($actor instanceof SupplierUser) {
            // H5: أعد فحص الشركة هنا أيضًا — إيقافها بعد إصدار التوكن يجب أن
            // يمنع الجلسة فورًا لا عند انتهاء التوكن.
            abort_unless($actor->is_active && $actor->supplier_id !== null
                && $actor->supplier?->is_active === true, 403);
            $actor->load('supplier');
            $redirect = $this->destinations->resolve($actor);

            return response()->json(['actor' => ['type' => 'supplier', 'subtype' => $redirect['destination']],
                'redirect' => $redirect,
                'data' => SupplierUserResource::make($actor)->resolve($request)]);
        }

        if ($actor instanceof Customer) {
            abort_if($actor->status === CustomerStatus::Suspended, 403);
            $redirect = $this->destinations->resolve($actor);

            return response()->json([
                // M1: subtype هو الـ destination دائمًا (كما في login)، ونوع
                // العميل في حقل منفصل حتى لا يبني الفرونت الوجهة من me خطأً.
                'actor' => ['type' => 'customer', 'subtype' => $redirect['destination'],
                    'customer_type' => $actor->type->value, 'status' => $actor->status->value],
                'redirect' => $redirect,
                'data' => CustomerResource::make($actor)->resolve($request)]);
        }

        abort(401);
    }

    public function logout(Request $request): Response
    {
        $request->user('sanctum')?->currentAccessToken()?->delete();

        return response()->noContent();
    }

    private function issueSupplierToken(SupplierUser $user): string
    {
        // L1: الحد غير ذري — دخولان متزامنان يتجاوزانه. القفل داخل transaction.
        return DB::transaction(function () use ($user): string {
            $user = SupplierUser::query()->lockForUpdate()->findOrFail($user->id);
            if (! $user->is_active || $user->supplier_id === null || $user->supplier?->is_active !== true) {
                throw new BusinessException('بيانات الدخول غير صحيحة.', [], 401);
            }
            // M1: SANCTUM_EXPIRATION الفارغ يعني بلا انتهاء زمني — لا تمسح كل التوكنات.
            $expiry = config('sanctum.expiration');
            $user->tokens()->where(fn ($q) => $q->where('expires_at', '<=', now())
                ->when($expiry, fn ($q) => $q->orWhere('created_at', '<=', now()->subMinutes((int) $expiry))))->delete();
            $limit = max(1, (int) config('auth.supplier_max_tokens', 5));
            $old = $user->tokens()->orderByDesc('id')->skip($limit - 1)->pluck('id');
            if ($old->isNotEmpty()) {
                $user->tokens()->whereIn('id', $old)->delete();
            }

            return $user->createToken('supplier-token')->plainTextToken;
        });
    }

    /**
     * @param  array{app: string, path: string, destination: string}  $redirect
     * @param  array<string, mixed>  $data
     */
    private function respond(string $type, array $redirect, ?string $token, ?string $handoff, array $data, ?string $status, ?string $customerType = null, ?bool $cartMerged = null): JsonResponse
    {
        return response()->json(array_filter([
            'message' => 'تم تسجيل الدخول بنجاح',
            // M1: customer_type منفصل عن subtype (الوجهة) حتى لا يبني الفرونت
            // الوجهة من نوع العميل خطأً.
            'actor' => array_filter(['type' => $type, 'subtype' => $redirect['destination'], 'status' => $status,
                'customer_type' => $customerType], fn ($v) => $v !== null),
            'redirect' => $redirect,
            'token' => $token,
            'handoff_code' => $handoff,
            'data' => $data,
            'cart_merged' => $cartMerged,
        ], fn ($v, $k) => $v !== null || $k === 'handoff_code' || $k === 'token', ARRAY_FILTER_USE_BOTH));
    }
}
</file>

<file path="bags-platform/backend/app/Http/Controllers/Api/V1/Store/AuthController.php">
<?php

declare(strict_types=1);

namespace App\Http\Controllers\Api\V1\Store;

use App\Http\Controllers\Controller;
use App\Http\Requests\Store\ForgotPasswordRequest;
use App\Http\Requests\Store\LoginRequest;
use App\Http\Requests\Store\PhoneVerificationRequest;
use App\Http\Requests\Store\RegisterRequest;
use App\Http\Requests\Store\ResetPasswordRequest;
use App\Http\Resources\Store\CustomerResource;
use App\Jobs\SendCustomerPhoneVerification;
use App\Services\Auth\NetworkIdentity;
use App\Services\CartService;
use App\Services\CustomerAuthService;
use App\Services\CustomerPhoneVerificationService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

/** مصادقة المتجر القطاعي: تسجيل فوري معتمد، دخول، خروج، واستعادة كلمة المرور. */
class AuthController extends Controller
{
    public function __construct(
        private readonly CustomerAuthService $auth,
        private readonly CartService $carts,
        private readonly CustomerPhoneVerificationService $phoneVerification,
    ) {}

    public function register(RegisterRequest $request): JsonResponse
    {
        [$customer, $token] = DB::transaction(function () use ($request): array {
            $customer = $this->auth->registerRetail($request->validated());

            return [$customer, $this->auth->issueToken($customer, 'store-token')];
        });

        // حساب جديد = دخول فوري: تُدمج سلة الزائر إن وُجدت
        $cartMerged = true;
        try {
            $this->carts->mergeGuestCart($customer, $request->header('X-Cart-Session'));
        } catch (\Throwable $exception) {
            report($exception);
            $cartMerged = false;
        }

        return CustomerResource::make($customer)
            ->additional(['message' => 'تم إنشاء حسابك بنجاح', 'token' => $token, 'cart_merged' => $cartMerged])
            ->response()
            ->setStatusCode(201);
    }

    public function login(LoginRequest $request): CustomerResource
    {
        $customer = $this->auth->login($request->validated()['login'], $request->validated()['password']);
        $token = $this->auth->issueToken($customer, 'store-token');

        // دمج سلة الزائر (إن وُجدت بهيدر الجلسة) في سلة الحساب تلقائيًا
        $cartMerged = true;
        try {
            $this->carts->mergeGuestCart($customer, $request->header('X-Cart-Session'));
        } catch (\Throwable $exception) {
            report($exception);
            $cartMerged = false;
        }

        return CustomerResource::make($customer)
            ->additional(['message' => 'تم تسجيل الدخول بنجاح', 'token' => $token, 'cart_merged' => $cartMerged]);
    }

    /** خروج: حذف التوكن الحالي فقط (بقية الجلسات على أجهزة أخرى تظل فعالة). */
    public function logout(Request $request): JsonResponse
    {
        $request->user()->currentAccessToken()->delete();

        return response()->json(['message' => 'تم تسجيل الخروج بنجاح']);
    }

    public function forgotPassword(ForgotPasswordRequest $request): JsonResponse
    {
        $this->auth->forgotPassword($request->validated()['email'] ?? null, $request->validated()['phone'] ?? null);

        return response()->json(['message' => 'لو الحساب موجود، أرسلنا رمز الاستعادة إليه.']);
    }

    public function resetPassword(ResetPasswordRequest $request): JsonResponse
    {
        $this->auth->resetPassword($request->validated());

        return response()->json(['message' => 'تم تغيير كلمة المرور؛ سجل الدخول من جديد.']);
    }

    public function sendPhoneVerification(PhoneVerificationRequest $request): JsonResponse
    {
        SendCustomerPhoneVerification::dispatch($request->validated()['phone'], NetworkIdentity::key($request))
            ->onConnection(config('auth.customer_password_reset.connection', 'database'));

        return response()->json(['message' => 'لو الرقم متاح للتسجيل، سيتم إرسال رمز التحقق إليه.']);
    }

    public function verifyPhone(PhoneVerificationRequest $request): JsonResponse
    {
        $data = $request->validated();
        $proof = $this->phoneVerification->verify($data['phone'], $data['code']);

        return response()->json(['phone_verification_token' => $proof, 'expires_in' => 600]);
    }
}
