<file path="bags-platform/backend/app/Services/StaffAdministration.php">
<?php

declare(strict_types=1);

namespace App\Services;

use App\Enums\StaffRole;
use App\Models\User;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;
use Spatie\Permission\Models\Role;
use Spatie\Permission\PermissionRegistrar;

/**
 * Staff administration guardrails and security coordinator.
 * Manages concurrency locks, optimistic locking, role invariants, and audit logging.
 */
final class StaffAdministration
{
    /**
     * Acquire a transactional PostgreSQL advisory lock to serialize staff membership and role changes.
     * Prevents race conditions during critical checks such as last-active-admin validation.
     */
    public static function lock(): void
    {
        DB::statement("SET LOCAL lock_timeout = '5s'");
        DB::select('SELECT pg_advisory_xact_lock(79301, 1)');
    }

    /**
     * Verify record lock_version matches expected optimistic concurrency version.
     */
    public static function assertVersion(Model $record, ?int $expected): void
    {
        // Detects concurrent permission/profile updates occurring within the same second
        abort_if($expected !== null && (int) $record->lock_version !== $expected, 409,
            'تم تعديل السجل بواسطة مستخدم آخر؛ أعد التحميل قبل الحفظ.');
    }

    /**
     * Increment monotonic lock_version counter for optimistic concurrency tracking.
     */
    public static function advanceVersion(Model $record): void
    {
        $record->forceFill(['lock_version' => (int) $record->lock_version + 1])->save();
    }

    /**
     * Invalidate cached Spatie permissions across all application instances after commit.
     */
    public static function clearPermissionCacheAfterCommit(): void
    {
        DB::afterCommit(function (): void {
            try {
                app(PermissionRegistrar::class)->forgetCachedPermissions();
            } catch (\Throwable $exception) {
                report($exception);
                logger()->error('staff.permission_cache_invalidation_failed');
            }
        });
    }

    /**
     * Capture snapshot of user role assignments, branch scoping, and active status.
     *
     * @return array{roles: list<string>, branch_id: int|null, is_active: bool}
     */
    public static function userState(User $user): array
    {
        return ['roles' => $user->roles()->orderBy('name')->pluck('name')->all(),
            'branch_id' => $user->branch_id, 'is_active' => (bool) $user->is_active];
    }

    /**
     * Capture snapshot of role definition and its assigned permissions.
     *
     * @return array{name: string, permissions: list<string>}
     */
    public static function roleState(Role $role): array
    {
        return ['name' => $role->name, 'permissions' => $role->permissions()->orderBy('name')->pluck('name')->all()];
    }

    /**
     * Shared-lock roles in deterministic ID order to ensure they exist and prevent deletion during assignment.
     *
     * @param list<string> $names
     */
    public static function lockRoles(array $names): void
    {
        $roles = Role::query()->where('guard_name', 'staff')->whereIn('name', $names)
            ->orderBy('id')->sharedLock()->get();
        if ($roles->count() !== count(array_unique($names))) {
            throw ValidationException::withMessages(['roles' => 'قائمة الأدوار تغيرت؛ أعد التحميل ثم حاول مرة أخرى.']);
        }
    }

    /**
     * Re-verify active status and permission grant against database state.
     *
     * @param list<string> $permissions
     */
    public static function authorize(User $actor, array $permissions): void
    {
        $actor->refresh();
        abort_unless($actor->is_active && ! $actor->is_system && $actor->canAny($permissions), 403);
    }

    /**
     * Check if another active, non-system SuperAdmin user exists.
     * Used to prevent orphaning the system by deactivating or demoting the last admin.
     */
    public static function hasOtherActiveSuperAdmin(User $target): bool
    {
        return User::query()->whereKeyNot($target->id)->where('is_active', true)->where('is_system', false)
            ->whereHas('roles', fn ($query) => $query->where('name', StaffRole::SuperAdmin->value)->where('guard_name', 'staff'))
            ->exists();
    }

    /**
     * Record an administrative audit entry with sanitized before/after metadata.
     *
     * @param list<string> $fields
     * @param array<string, mixed> $before
     * @param array<string, mixed> $after
     */
    public static function audit(?User $actor, string $action, string $targetType, int|string|null $targetId, array $fields, array $before = [], array $after = []): void
    {
        $allowed = array_flip(['roles', 'permissions', 'name', 'branch_id', 'is_active', 'settings']);
        DB::table('staff_audit_logs')->insert([
            'actor_id' => $actor?->id,
            'action' => $action,
            'target_type' => $targetType,
            'target_id' => $targetId,
            // Sensitive fields (passwords, tokens) are stripped; only allowed state keys are stored
            'metadata' => json_encode(['fields' => array_values(array_diff($fields, ['current_password', 'expected_version'])),
                'before' => array_intersect_key($before, $allowed), 'after' => array_intersect_key($after, $allowed),
                'ip' => request()->ip(), 'method' => request()->method()], JSON_THROW_ON_ERROR),
            'created_at' => now(),
        ]);
    }
}
</file>

<file path="bags-platform/frontend/apps/backoffice/src/components/auth/ProtectedRoute.tsx">
import { useEffect, useState } from 'react';
import { resolveServiceUrl } from '@alfarid/api-client';
import { useAuthStore } from '../../stores/auth.store';

const WEB_URL = resolveServiceUrl(import.meta.env.VITE_WEB_URL ?? 'http://localhost:3000');

export function ProtectedRoute({ children }: { children: React.ReactNode }) {
  const token = useAuthStore((s) => s.token);
  const [verifiedToken, setVerifiedToken] = useState<string | null>(null);
  const [error, setError] = useState(false);
  const [attempt, setAttempt] = useState(0);

  useEffect(() => {
    if (!token) {
      window.location.replace(`${WEB_URL}/auth/login`);
      return;
    }
    let cancelled = false;
    setError(false);
    useAuthStore.getState().bootstrap()
      .then(() => { if (!cancelled) setVerifiedToken(token); })
      .catch((err) => {
        if (cancelled) return;
        if (err?.response?.status === 403) {
          useAuthStore.getState().logout();
          window.location.replace(`${WEB_URL}/auth/login`);
        } else if (err?.response?.status !== 401) setError(true);
      });
    return () => { cancelled = true; };
  }, [token, attempt]);

  if (error) return (
    <div
      role="alert"
      dir="rtl"
      style={{
        boxSizing: 'border-box',
        minHeight: '100svh',
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        padding: '24px',
        backgroundColor: '#f2eff3',
        color: '#18151c',
        textAlign: 'center',
      }}
    >
      <div
        style={{
          boxSizing: 'border-box',
          width: '100%',
          maxWidth: '380px',
          backgroundColor: '#ffffff',
          borderRadius: '22px',
          padding: '28px 24px',
          border: '1px solid rgba(24, 21, 28, 0.08)',
          boxShadow: '0 12px 32px rgba(24, 21, 28, 0.06)',
        }}
      >
        <p style={{ margin: '0 0 20px', fontSize: '15px', lineHeight: 1.7, fontWeight: 500 }}>
          تعذر التحقق من الجلسة. تحقق من الاتصال وحاول مرة أخرى.
        </p>
        <button
          type="button"
          onClick={() => setAttempt((n) => n + 1)}
          style={{
            width: '100%',
            minHeight: '48px',
            padding: '12px 20px',
            borderRadius: '999px',
            border: 0,
            backgroundColor: '#18151c',
            color: '#ffffff',
            fontSize: '14px',
            fontWeight: 600,
            cursor: 'pointer',
          }}
        >
          إعادة المحاولة
        </button>
      </div>
    </div>
  );
  if (!token || verifiedToken !== token) return (
    <div
      dir="rtl"
      style={{
        boxSizing: 'border-box',
        minHeight: '100svh',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        padding: '24px',
        backgroundColor: '#f2eff3',
        color: '#18151c',
      }}
    >
      <p
        role="status"
        style={{
          margin: 0,
          padding: '14px 24px',
          borderRadius: '999px',
          backgroundColor: '#ffffff',
          border: '1px solid rgba(24, 21, 28, 0.08)',
          fontSize: '14px',
          fontWeight: 500,
        }}
      >
        جارٍ التحقق من الجلسة…
      </p>
    </div>
  );
  return <>{children}</>;
}
</file>

<file path="bags-platform/frontend/apps/backoffice/src/pages/admin/admin-mock/api/endpoints.ts">
import { defaultApiClient as api } from '@alfarid/api-client';
import type { ApiBanner, ApiBranch, ApiPermissionGroups, ApiRole, ApiSettingsGrouped, ApiUser,
  CreateUserBody, Paginated, RoleBody, UpdateUserBody, UserListParams } from './types';

const BASE = '/api/v1/admin';

function userParams(p: UserListParams): Record<string, string | number> {
  const out: Record<string, string | number> = { page: p.page ?? 1, per_page: p.per_page ?? 8 };
  if (p.search?.trim()) out.search = p.search.trim();
  if (p.role) out.role = p.role;
  // axios بيشيل أي null، فبنبعت '' عشان Laravel يحوّله null ويفلتر على "من غير فرع"
  if (p.branch_id === 'none') out.branch_id = '';
  else if (typeof p.branch_id === 'number') out.branch_id = p.branch_id;
  if (typeof p.is_active === 'boolean') out.is_active = p.is_active ? 1 : 0;
  return out;
}

export const adminApi = {
  // Users
  listUsers: (p: UserListParams, signal?: AbortSignal) =>
    api.get<Paginated<ApiUser>>(`${BASE}/users`, { params: userParams(p), signal }).then(r => r.data),
  getUser: (id: number, signal?: AbortSignal) =>
    api.get<{ data: ApiUser }>(`${BASE}/users/${id}`, { signal }).then(r => r.data.data),
  createUser: (body: CreateUserBody) =>
    api.post<{ data: ApiUser }>(`${BASE}/users`, body).then(r => r.data.data),
  updateUser: (id: number, body: UpdateUserBody) =>
    api.patch<{ data: ApiUser }>(`${BASE}/users/${id}`, body).then(r => r.data.data),
  deactivateUser: (id: number, version: number) =>
    api.delete<{ message?: string }>(`${BASE}/users/${id}`, {data:{expected_version:version}}).then(r => r.data),
  countUsers: (p: Omit<UserListParams, 'page' | 'per_page'>, signal?: AbortSignal) =>
    api.get<Paginated<ApiUser>>(`${BASE}/users`, { params: { ...userParams(p), per_page: 1 }, signal })
      .then(r => r.data.meta.total),

  // Roles (بنلف على كل الصفحات)
  listRoles: async (signal?: AbortSignal): Promise<ApiRole[]> => {
    const all: ApiRole[] = [];
    let page = 1, last = 1;
    do {
      const r = await api.get<Paginated<ApiRole>>(`${BASE}/roles`, { params: { per_page: 100, page }, signal });
      all.push(...r.data.data);
      last = r.data.meta.last_page;
      page++;
    } while (page <= last);
    return all;
  },
  createRole: (body: Required<Pick<RoleBody, 'name'>> & RoleBody) =>
    api.post<{ data: ApiRole }>(`${BASE}/roles`, body).then(r => r.data.data),
  updateRole: (id: number, body: RoleBody) =>
    api.patch<{ data: ApiRole }>(`${BASE}/roles/${id}`, body).then(r => r.data.data),
  deleteRole: (id: number) => api.delete(`${BASE}/roles/${id}`),

  // Permissions
  listPermissions: (signal?: AbortSignal) =>
    api.get<{ data: ApiPermissionGroups }>(`${BASE}/permissions`, { signal }).then(r => r.data.data),

  // Branches
  listBranches: async (signal?: AbortSignal): Promise<ApiBranch[]> => {
    const branches: ApiBranch[] = [];
    let page = 1, last = 1;
    do {
      const response = await api.get<Paginated<ApiBranch>>(`${BASE}/branches`, {params:{per_page:100,page},signal});
      branches.push(...response.data.data); last = response.data.meta.last_page; page++;
    } while (page <= last);
    return branches;
  },

  // Settings
  getSettings: (signal?: AbortSignal) =>
    api.get<{ data: ApiSettingsGrouped }>(`${BASE}/settings`, { signal }).then(r => r.data.data),
  updateSettings: (patch: Record<string, unknown>) =>
    api.put<{ data: ApiSettingsGrouped; warnings?: string[] }>(`${BASE}/settings`, patch).then(r => r.data),

  // Banners
  listBanners: (signal?: AbortSignal) =>
    api.get<{ data: ApiBanner[] }>(`${BASE}/banners`, { signal }).then(r => r.data.data),
  createBanner: (fd: FormData, onProgress?: (p: number) => void) =>
    api.post<{ data: ApiBanner }>(`${BASE}/banners`, fd, {
      headers: { 'Content-Type': undefined },
      onUploadProgress: (e: { loaded: number; total?: number }) => onProgress?.(e.total ? (e.loaded / e.total) * 100 : 0),
    }).then(r => r.data.data),
  updateBanner: (id: number, fd: FormData, onProgress?: (p: number) => void) =>
    api.post<{ data: ApiBanner }>(`${BASE}/banners/${id}`, fd, {
      headers: { 'Content-Type': undefined },
      onUploadProgress: (e: { loaded: number; total?: number }) => onProgress?.(e.total ? (e.loaded / e.total) * 100 : 0),
    }).then(r => r.data.data),
  toggleBanner: (id: number, isActive: boolean) =>
    api.patch<{ data: ApiBanner }>(`${BASE}/banners/${id}/toggle`, { is_active: isActive }).then(r => r.data.data),
  deleteBanner: (id: number) => api.delete(`${BASE}/banners/${id}`),
  reorderBanners: (position: string, ids: number[]) =>
    api.put(`${BASE}/banners/reorder`, { position, ids }),
  listBannerCategories: (signal?: AbortSignal) =>
    api.get<{ data: Array<{ id: number; name_ar: string; name_en: string | null; children?: Array<{ id: number; name_ar: string; name_en: string | null; children?: unknown[] }> }> }>(`${BASE}/categories`, { params: { tree: 1 }, signal }).then(r => r.data.data),
  searchBannerProducts: (search: string, signal?: AbortSignal) =>
    api.get<{ data: Array<{ id: number; name_ar: string; name_en: string | null }> }>(`${BASE}/products`, { params: { search, status: 'published', per_page: 20 }, signal }).then(r => r.data.data),
};

// Standalone exports matching the banner API surface.
export const listBanners = adminApi.listBanners;
export const createBanner = adminApi.createBanner;
export const updateBanner = adminApi.updateBanner;
export const toggleBanner = adminApi.toggleBanner;
export const deleteBanner = adminApi.deleteBanner;
</file>

