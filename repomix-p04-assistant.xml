492:     /**
493:      * @return array<string, array{prefix: string, next: string, padding: string}>
494:      */
495:     private function numberingDefinitions(): array
496:     {
497:         return [
498:             'invoice' => ['prefix' => 'invoice_prefix', 'next' => 'invoice_next_number', 'padding' => 'invoice_padding'],
499:             'order' => ['prefix' => 'order_prefix', 'next' => 'order_next_number', 'padding' => 'order_padding'],
500:             'purchase_order' => ['prefix' => 'purchase_order_prefix', 'next' => 'purchase_order_next_number', 'padding' => 'purchase_order_padding'],
501:             'quotation' => ['prefix' => 'quotation_prefix', 'next' => 'quotation_next_number', 'padding' => 'quotation_padding'],
502:             'transfer' => ['prefix' => 'transfer_prefix', 'next' => 'transfer_next_number', 'padding' => 'transfer_padding'],
503:             'stocktake' => ['prefix' => 'stocktake_prefix', 'next' => 'stocktake_next_number', 'padding' => 'stocktake_padding'],
504:             'return' => ['prefix' => 'return_prefix', 'next' => 'return_next_number', 'padding' => 'return_padding'],
505:             'purchase_request' => ['prefix' => 'purchase_request_prefix', 'next' => 'purchase_request_next_number', 'padding' => 'purchase_request_padding'],
506:             'delivery' => ['prefix' => 'delivery_prefix', 'next' => 'delivery_next_number', 'padding' => 'delivery_padding'],
507:             'supplier_invoice' => ['prefix' => 'supplier_invoice_prefix', 'next' => 'supplier_invoice_next_number', 'padding' => 'supplier_invoice_padding'],
508:             'supplier_payment' => ['prefix' => 'supplier_payment_prefix',    'next' => 'supplier_payment_next_number',    'padding' => 'supplier_payment_padding'],
509:             'movement' => ['prefix' => 'movement_prefix', 'next' => 'movement_next_number', 'padding' => 'movement_padding'],
510:             'shift' => ['prefix' => 'shift_prefix',               'next' => 'shift_next_number',               'padding' => 'shift_padding'],
511:             'pos_invoice' => ['prefix' => 'pos_invoice_prefix',      'next' => 'pos_invoice_next_number',      'padding' => 'pos_invoice_padding'],
512:             'expense' => ['prefix' => 'expense_prefix',             'next' => 'expense_next_number',             'padding' => 'expense_padding'],
513:             'treasury_transfer' => ['prefix' => 'treasury_transfer_prefix',   'next' => 'treasury_transfer_next_number',   'padding' => 'treasury_transfer_padding'],
514:             'payment_notice' => ['prefix' => 'payment_notice_prefix',      'next' => 'payment_notice_next_number',      'padding' => 'payment_notice_padding'],
515:         ];
516:     }
517: 
518:     private function nextMovementNumber(): int
519:     {
520:         $sequence = DB::selectOne('SELECT last_value, is_called FROM stock_movement_number_seq');
521: 
522:         return (int) $sequence->last_value + ($sequence->is_called ? 1 : 0);
523:     }
524: 
525:     private function nextDocumentNumber(string $type): int
526:     {
527:         if (! isset(self::SEQUENCE_TYPES[$type])) {
528:             throw new InvalidArgumentException("Unsupported numbering type [{$type}].");
529:         }
530:         $sequence = DB::selectOne("SELECT last_value, is_called FROM document_{$type}_number_seq");
531: 
532:         return (int) $sequence->last_value + ($sequence->is_called ? 1 : 0);
533:     }
534: 
535:     private function counterValue(mixed $value): int
536:     {
537:         $number = (is_int($value) || is_string($value))
538:             ? filter_var($value, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => PHP_INT_MAX - 1]])
539:             : false;
540:         if ($number === false) {
541:             throw new BusinessException('قيمة عداد الترقيم يجب أن تكون عددًا صحيحًا موجبًا ضمن النطاق المسموح');
542:         }
543: 
544:         return $number;
545:     }
546: 
547:     private function castValue(?string $value, string $type): mixed
548:     {
549:         if ($value === null) {
550:             return null;
551:         }
552: 
553:         if ($type === 'json') {
554:             try {
555:                 return json_decode($value, true, 512, JSON_THROW_ON_ERROR);
556:             } catch (JsonException) {
557:                 return null;
558:             }
559:         }
560: 
561:         return match ($type) {
562:             'boolean' => filter_var($value, FILTER_VALIDATE_BOOLEAN),
563:             'integer' => (int) $value,
564:             'float' => (float) $value,
565:             default => $value,
566:         };
567:     }
568: 
569:     /** @throws JsonException */
570:     private function serializeValue(mixed $value, string $type): ?string
571:     {
572:         if ($value === null) {
573:             return null;
574:         }
575: 
576:         if ($type === 'json') {
577:             return json_encode($value, JSON_THROW_ON_ERROR);
578:         }
579: 
580:         if ($type === 'boolean') {
581:             return filter_var($value, FILTER_VALIDATE_BOOLEAN) ? '1' : '0';
582:         }
583: 
584:         return (string) $value;
585:     }
586: }
