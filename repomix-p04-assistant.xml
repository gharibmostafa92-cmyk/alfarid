 211:     private function validateArgs(string $name, array &$args): void
 212:     {
 213:         if ($name === 'create_role' && is_string($args['name'] ?? null)) {
 214:             $args['name'] = StaffRole::normalizeName($args['name']);
 215:         }
 216:         if ($name === 'create_branch' && is_string($args['code'] ?? null)) {
 217:             $args['code'] = mb_strtoupper(trim($args['code']));
 218:         }
 219:         if ($name === 'create_staff_user' && is_string($args['email'] ?? null)) {
 220:             $args['email'] = mb_strtolower(trim($args['email']));
 221:         }
 222:         if ($name === 'bulk_actions') {
 223:             Validator::make($args, ['items' => ['required', 'array', 'min:2', 'max:'.max(1, (int) $this->settings->get('ai_bulk_max_items', 25))], 'items.*.tool' => ['required', Rule::in(['update_role_permissions', 'set_user_status', 'assign_roles', 'revoke_user_sessions', 'set_location_status', 'create_location'])], 'items.*.args' => ['required', 'array']])->validate();
 224: 
 225:             return;
 226:         }
 227:         $schema = $this->definitions()[$name]['declaration']['parameters'];
 228:         $rules = [];
 229:         foreach ($schema['properties'] as $key => $property) {
 230:             $rules[$key] = [in_array($key, $schema['required'] ?? [], true) ? 'required' : 'sometimes', match ($property['type']) {
 231:                 'INTEGER' => 'integer', 'BOOLEAN' => 'boolean', 'ARRAY' => 'array', 'OBJECT' => 'array', 'NUMBER' => 'numeric', default => 'string'
 232:             }];
 233:             if ($property['type'] === 'STRING') {
 234:                 $rules[$key][] = 'max:255';
 235:             }
 236:             if ($property['type'] === 'INTEGER') {
 237:                 $rules[$key][] = 'min:1';
 238:             }
 239:             if (isset($property['enum'])) {
 240:                 $rules[$key][] = Rule::in($property['enum']);
 241:             }
 242:             if ($property['type'] === 'ARRAY') {
 243:                 $rules[$key][] = 'max:200';
 244:                 $rules[$key.'.*'] = ['string', 'distinct', 'max:255'];
 245:             }
 246:         }
 247:         if (in_array($name, ['create_role', 'update_role_permissions'], true)) {
 248:             foreach (['permissions', 'add', 'remove'] as $key) {
 249:                 if (isset($rules[$key])) {
 250:                     $rules[$key.'.*'][] = Rule::exists('permissions', 'name')->where('guard_name', 'staff');
 251:                 }
 252:             }
 253:         }
 254:         if ($name === 'assign_roles' || $name === 'create_staff_user') {
 255:             foreach (['roles', 'add', 'remove'] as $key) {
 256:                 if (isset($rules[$key])) {
 257:                     $rules[$key.'.*'][] = Rule::exists('roles', 'name')->where('guard_name', 'staff');
 258:                 }
 259:             }
 260:         }
 261:         if ($name === 'create_staff_user') {
 262:             $userRules = (new StoreUserRequest)->rules();
 263:             unset($userRules['password']);
 264:             $rules = array_replace($rules, $userRules);
 265:         }
 266:         if (in_array($name, ['create_location', 'set_location_status'], true) && isset($rules['code'])) {
 267:             // L-8: كود الموقع max:100 في الـ REST — توحيد الحد بين المسارين.
 268:             $rules['code'] = array_map(static fn ($rule) => $rule === 'max:255' ? 'max:100' : $rule, $rules['code']);
 269:         }
 270:         if ($name === 'create_branch') {
 271:             $rules = array_replace($rules, (new StoreBranchRequest)->rules());
 272:         }
 273:         if ($name === 'create_role') {
 274:             $rules = array_replace($rules, (new StoreRoleRequest)->rules());
 275:         }
 276:         Validator::make($args, $rules)->validate();
 277:         abort_if(array_diff(array_keys($args), array_keys((array) $schema['properties'])) !== [], 422, 'بيانات أداة غير مسموحة.');
 278:     }
