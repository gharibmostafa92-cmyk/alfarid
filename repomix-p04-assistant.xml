<file path="bags-platform/backend/app/Services/WholesaleRegistrationService.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Services;
  6: 
  7: use App\Enums\CustomerDocumentStatus;
  8: use App\Enums\CustomerDocumentType;
  9: use App\Enums\CustomerStatus;
 10: use App\Enums\CustomerType;
 11: use App\Events\WholesaleApplicationSubmitted;
 12: use App\Models\Customer;
 13: use App\Models\CustomerAuditLog;
 14: use App\Models\CustomerDocument;
 15: use Illuminate\Http\UploadedFile;
 16: use Illuminate\Support\Facades\DB;
 17: use Illuminate\Support\Facades\Storage;
 18: use Illuminate\Support\Str;
 19: 
 20: /**
 21:  * Wholesale customer self-registration service.
 22:  * Registers customer in Pending status and stages uploaded verification documents into private storage.
 23:  * Final approval is performed by administrators via CustomerManagementService.
 24:  */
 25: class WholesaleRegistrationService
 26: {
 27:     public function __construct(private readonly CustomerAuthService $auth) {}
 28: 
 29:     /**
 30:      * Register a new wholesale customer and store supporting verification documents.
 31:      * Staged files are moved into customer directory upon successful transaction.
 32:      *
 33:      * @param  list<UploadedFile>  $files
 34:      * @param  list<string|null>  $documentTypes  Parallel document type tags (defaults to "other")
 35:      * @return array{customer: Customer, token: string}
 36:      */
 37:     public function register(array $data, array $files, array $documentTypes = []): array
 38:     {
 39:         $files = array_values($files);
 40:         $documentTypes = array_values($documentTypes);
 41:         $storedPaths = [];
 42:         $staged = [];
 43:         $stagingDirectory = 'customer_documents/pending/'.Str::uuid();
 44: 
 45:         try {
 46:             foreach ($files as $i => $file) {
 47:                 $filename = Str::uuid().'.'.($file->extension() ?: 'bin');
 48:                 $path = Storage::disk('r2')->putFileAs($stagingDirectory, $file, $filename);
 49:                 if ($path === false) {
 50:                     throw new \RuntimeException('تعذر حفظ مستند العميل.');
 51:                 }
 52:                 $storedPaths[] = $path;
 53:                 $staged[] = [
 54:                     'filename' => $filename, 'path' => $path,
 55:                     'document_type' => $documentTypes[$i] ?? CustomerDocumentType::Other->value,
 56:                     'original_name' => CustomerDocument::safeName($file->getClientOriginalName()),
 57:                     'mime_type' => $file->getMimeType() ?? 'application/octet-stream',
 58:                 ];
 59:             }
 60: 
 61:             // Reserve the sequence value before storage I/O, without holding row locks.
 62:             $customerId = (int) DB::selectOne("SELECT nextval(pg_get_serial_sequence('customers', 'id')) AS id")->id;
 63:             foreach ($staged as &$document) {
 64:                 $path = "customer_documents/{$customerId}/".$document['filename'];
 65:                 $storedPaths[] = $path;
 66:                 if (! Storage::disk('r2')->move($document['path'], $path)) {
 67:                     throw new \RuntimeException('تعذر حفظ مستند العميل.');
 68:                 }
 69:                 $document['path'] = $path;
 70:             }
 71:             unset($document);
 72: 
 73:             $registration = DB::transaction(function () use ($data, $staged, $customerId): array {
 74:                 $this->auth->lockRegistrationEmail($data['email'] ?? null);
 75:                 $verified = app(CustomerPhoneVerificationService::class)->consume($data);
 76:                 $customer = Customer::query()->make([
 77:                     'name' => $data['name'],
 78:                     'email' => $data['email'] ?? null,
 79:                     'phone' => $data['phone'],
 80:                     'password' => $data['password'],
 81:                     'type' => CustomerType::Wholesale,
 82:                     'status' => CustomerStatus::Pending,
 83:                     'phone_verified_at' => $verified ? now() : null,
 84:                     'company_name' => $data['company_name'],
 85:                     'tax_number' => $data['tax_number'],
 86:                     'commercial_register' => $data['commercial_register'],
 87:                 ]);
 88:                 $customer->forceFill(['id' => $customerId])->save();
 89: 
 90:                 foreach ($staged as $document) {
 91:                     $customer->documents()->create([
 92:                         'document_type' => $document['document_type'],
 93:                         'file_path' => $document['path'],
 94:                         'original_name' => $document['original_name'],
 95:                         'mime_type' => $document['mime_type'],
 96:                         'status' => CustomerDocumentStatus::Pending,
 97:                     ]);
 98:                 }
 99: 
100:                 CustomerAuditLog::record($customer, 'self_registered', null, ['channel' => 'wholesale']);
101:                 DB::afterCommit(static function () use ($customer): void {
102:                     try {
103:                         WholesaleApplicationSubmitted::dispatch($customer);
104:                     } catch (\Throwable $exception) {
105:                         // The account is committed; a queue outage must not turn it into a failed registration.
106:                         report($exception);
107:                     }
108:                 });
109: 
110:                 return [
111:                     'customer' => $customer->load('documents'),
112:                     'token' => $this->auth->issueToken($customer, 'wholesale-token'),
113:                 ];
114:             });
115:         } catch (\Throwable $e) {
116:             // Transaction failure: clean up uploaded files on cloud storage to prevent orphaned assets
117:             foreach ($storedPaths as $path) {
118:                 try {
119:                     Storage::disk('r2')->delete($path);
120:                 } catch (\Throwable $exception) {
121:                     report($exception);
122:                 }
123:             }
124:             if ($storedPaths !== []) {
125:                 try {
126:                     Storage::disk('r2')->deleteDirectory($stagingDirectory);
127:                 } catch (\Throwable $exception) {
128:                     report($exception);
129:                 }
130:             }
131: 
132:             throw $e;
133:         }
134: 
135:         try {
136:             Storage::disk('r2')->deleteDirectory($stagingDirectory);
137:         } catch (\Throwable $exception) {
138:             report($exception);
139:         }
140: 
141:         return $registration;
142:     }
143: }
</file>

