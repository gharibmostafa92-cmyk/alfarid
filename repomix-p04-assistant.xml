299:     /**
300:      * Update a flat key/value map atomically and invalidate the cached settings after commit.
301:      *
302:      * @param  array<string, mixed>  $settings
303:      *
304:      * @throws JsonException
305:      */
306:     public function updateBatch(array $settings, ?array $expected = null, array $via = []): void
307:     {
308:         $this->warnings = [];
309:         DB::transaction(function () use ($settings, $expected, $via): void {
310:             $this->uncommittedSettings = true;
311:             $this->resetReadSnapshot();
312:             $movementSequenceTarget = null;
313:             /** @var array<string, int> $documentSequenceTargets */
314:             $documentSequenceTargets = [];
315:             $lockedSettings = Setting::query()
316:                 ->whereIn('key', array_keys($settings))
317:                 ->orderBy('key')
318:                 ->lockForUpdate()
319:                 ->get()
320:                 ->keyBy('key');
321: 
322:             $missingKeys = array_diff(array_keys($settings), $lockedSettings->keys()->all());
323: 
324:             if ($missingKeys !== []) {
325:                 throw new InvalidArgumentException('Settings are not initialized: '.implode(', ', $missingKeys));
326:             }
327: 
328:             $before = [];
329:             $after = [];
330:             foreach ($settings as $key => $value) {
331:                 /** @var Setting $setting */
332:                 $setting = $lockedSettings->get($key);
333:                 $current = $this->castValue($setting->value, $setting->type);
334:                 if (in_array($key, self::NUMBERING_COUNTER_KEYS, true)) {
335:                     $current = $this->get($key);
336:                 }
337:                 // M7/M8: العدادات الحية (قيم الـ sequences) بتزيد من نفسها مع
338:                 // كل فاتورة/عملية بتتنفذ — تسجيل التوقيع على القيمة الحلية
339:                 // بيورّط 409 دايمًا على الأنظمة المزدحمة. للعدادات القاعدة هي
340:                 // "الجديد ≥ الحالي" بس (فوق)، وexpected يحكم البادئة والطول
341:                 // والأنواع غير العدادية (فاتورة ضريبية مثلًا تفضل بالمساواة).
342:                 $isCounter = in_array($key, self::NUMBERING_COUNTER_KEYS, true);
343:                 if (! $isCounter && $expected !== null && (! array_key_exists($key, $expected)
344:                     || $this->comparisonValue($current, $setting->type) !== $this->comparisonValue($expected[$key], $setting->type))) {
345:                     abort(409, 'تم تغيير إعداد أو عداد منذ فتح الصفحة؛ أعد تحميل الإعدادات قبل الحفظ.');
346:                 }
347:                 $before[$key] = $current;
348: 
349:                 if (in_array($key, self::NUMBERING_COUNTER_KEYS, true)) {
350:                     $requested = $this->counterValue($value);
351:                     if ($requested > 999999999) {
