312:     private function event(AiPendingAction $action, string $kind, string $text, array $blocks, bool $stripPassword = false): void
313:     {
314:         if ($stripPassword) {
315:             // L8: لا تعتمد على regex فوق صياغة عربية قد تتغير — المؤقتة
316:             // تُعرض مرة واحدة في رد التأكيد فقط، والمخزّن نص ثابت.
317:             $text = 'تم إنشاء الموظف (الباسورد ظهر للأدمن مرة واحدة).';
318:             $blocks = array_map(function ($b) {
319:                 if (isset($b['message'])) {
320:                     $b['message'] = 'تم إنشاء الموظف.';
321:                 }
322:                 if (isset($b['generated_password'])) {
323:                     unset($b['generated_password']);
324:                 }
325: 
326:                 return $b;
327:             }, $blocks);
328:         }
329:         AiMessage::create(['conversation_id' => $action->conversation_id, 'role' => 'event', 'content' => $text, 'ui_blocks' => $blocks]);
330:     }
