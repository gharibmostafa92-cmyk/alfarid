 689:     public function executeWrite(User $actor, AiPendingAction $action, array $via): ToolOutcome
 690:     {
 691:         $args = $action->args;
 692:         $tool = $action->tool;
 693:         try {
 694:             $this->assertAiConstraints($actor, $action);
 695: 
 696:             return match ($tool) {
 697:                 'create_branch' => $this->execCreateBranch($actor, $args, $via, $action),
 698:                 'set_branch_status' => $this->execSetBranchStatus($actor, $args, $via, $action),
 699:                 'create_role' => $this->execCreateRole($actor, $args, $via, $action),
 700:                 'update_role_permissions' => $this->execUpdateRolePerms($actor, $args, $via, $action),
 701:                 'delete_role' => $this->execDeleteRole($actor, $args, $via, $action),
 702:                 'create_staff_user' => $this->execCreateStaffUser($actor, $args, $via, $action),
 703:                 'set_user_status' => $this->execSetUserStatus($actor, $args, $via, $action),
 704:                 'assign_roles' => $this->execAssignRoles($actor, $args, $via, $action),
 705:                 'revoke_user_sessions' => $this->execRevoke($actor, $args, $via, $action),
 706:                 'create_location' => $this->execCreateLocation($actor, $args, $via, $action),
 707:                 'set_location_status' => $this->execSetLocationStatus($actor, $args, $via, $action),
 708:                 'delete_location' => $this->execDeleteLocation($actor, $args, $via, $action),
 709:                 'update_settings' => $this->execUpdateSettings($actor, $args, $via, $action),
 710:                 'update_document_numbering' => $this->execUpdateDocNumbering($actor, $args, $via, $action),
 711:                 default => ToolOutcome::result(false, 'أداة غير معروفة.'),
 712:             };
 713:         } catch (HttpExceptionInterface $e) {
 714:             if ($e->getStatusCode() === 409) {
 715:                 throw $e;
 716:             }
 717: 
 718:             return ToolOutcome::result(false, $e->getMessage() ?: 'فشل التنفيذ.');
 719:         }
 720:     }
