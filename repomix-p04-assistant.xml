<file path="bags-platform/backend/app/Services/StaffAdministration.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Services;
  6: 
  7: use App\Enums\StaffRole;
  8: use App\Models\Branch;
  9: use App\Models\User;
 10: use Illuminate\Database\Eloquent\Model;
 11: use Illuminate\Support\Facades\DB;
 12: use Illuminate\Validation\ValidationException;
 13: use Spatie\Permission\Models\Role;
 14: use Spatie\Permission\PermissionRegistrar;
 15: 
 16: /**
 17:  * Staff administration guardrails and security coordinator.
 18:  * Manages concurrency locks, optimistic locking, role invariants, and audit logging.
 19:  */
 20: final class StaffAdministration
 21: {
 22:     /**
 23:      * Acquire a transactional PostgreSQL advisory lock to serialize staff membership and role changes.
 24:      * Prevents race conditions during critical checks such as last-active-admin validation.
 25:      */
 26:     public static function lock(): void
 27:     {
 28:         // L3: SET LOCAL يسري على الـ transaction كلها — 55P03 (lock timeout)
 29:         // تتحول لـ 409 قابلة لإعادة المحاولة بدل 500.
 30:         try {
 31:             DB::statement("SET LOCAL lock_timeout = '5s'");
 32:             DB::select('SELECT pg_advisory_xact_lock(79301, 1)');
 33:         } catch (\Illuminate\Database\QueryException $e) {
 34:             if (($e->errorInfo[0] ?? null) === '55P03') {
 35:                 abort(409, 'النظام مشغول حاليًا؛ حاول مرة أخرى.');
 36:             }
 37:             throw $e;
 38:         }
 39:     }
 40: 
 41:     /**
 42:      * Verify record lock_version matches expected optimistic concurrency version.
 43:      */
 44:     public static function assertVersion(Model $record, ?int $expected): void
 45:     {
 46:         // Detects concurrent permission/profile updates occurring within the same second
 47:         abort_if($expected !== null && (int) $record->lock_version !== $expected, 409,
 48:             'تم تعديل السجل بواسطة مستخدم آخر؛ أعد التحميل قبل الحفظ.');
 49:     }
 50: 
 51:     /**
 52:      * Increment monotonic lock_version counter for optimistic concurrency tracking.
 53:      */
 54:     public static function advanceVersion(Model $record): void
 55:     {
 56:         $record->forceFill(['lock_version' => (int) $record->lock_version + 1])->save();
 57:     }
 58: 
 59:     /**
 60:      * Invalidate cached Spatie permissions across all application instances after commit.
 61:      */
 62:     public static function clearPermissionCacheAfterCommit(): void
 63:     {
 64:         DB::afterCommit(function (): void {
 65:             try {
 66:                 app(PermissionRegistrar::class)->forgetCachedPermissions();
 67:             } catch (\Throwable $exception) {
 68:                 report($exception);
 69:                 logger()->error('staff.permission_cache_invalidation_failed');
 70:             }
 71:         });
 72:     }
 73: 
 74:     /**
 75:      * Capture snapshot of user role assignments, branch scoping, and active status.
 76:      *
 77:      * @return array{roles: list<string>, branch_id: int|null, is_active: bool}
 78:      */
 79:     public static function userState(User $user): array
 80:     {
 81:         return ['roles' => $user->roles()->orderBy('name')->pluck('name')->all(),
 82:             'branch_id' => $user->branch_id, 'is_active' => (bool) $user->is_active, 'email' => $user->email];
 83:     }
 84: 
 85:     /**
 86:      * Capture snapshot of role definition and its assigned permissions.
 87:      *
 88:      * @return array{name: string, permissions: list<string>}
 89:      */
 90:     /** @return array{name: string, is_active: bool} */
 91:     public static function mayGrantPermissions(?User $actor, array $permissions): bool
 92:     {
 93:         if (! $actor instanceof User) {
 94:             return false;
 95:         }
 96:         $actor->unsetRelation('roles')->unsetRelation('permissions');
 97: 
 98:         return $actor->hasRole(StaffRole::SuperAdmin->value, 'staff') || $actor->hasAllPermissions(array_values(array_unique($permissions)));
 99:     }
100: 
101:     /** @param list<string> $roles */
102:     public static function mayManageUser(mixed $actor, ?User $target = null, array $roles = []): bool
103:     {
104:         if (! $actor instanceof User) {
105:             return false;
106:         }
107:         $actor->unsetRelation('roles')->unsetRelation('permissions');
108:         if ($target?->is_system) {
109:             return false;
110:         }
111:         if ($actor->hasRole(StaffRole::SuperAdmin->value, 'staff')) {
112:             return true;
113:         }
114:         if (in_array(StaffRole::SuperAdmin->value, $roles, true) || $target?->hasRole(StaffRole::SuperAdmin->value, 'staff')) {
115:             return false;
116:         }
117:         $permissions = Role::query()->where('guard_name', 'staff')->whereIn('name', $roles)->with('permissions')->get()
118:             ->flatMap(fn (Role $role) => $role->permissions->pluck('name'));
119:         if ($target !== null) {
120:             $permissions = $permissions->merge($target->getAllPermissions()->pluck('name'));
121:         }
122: 
123:         return $actor->hasAllPermissions($permissions->unique()->all());
124:     }
125: 
126:     public static function branchState(Branch $branch): array
127:     {
128:         return ['name' => $branch->name, 'is_active' => (bool) $branch->is_active];
129:     }
130: 
131:     public static function roleState(Role $role): array
132:     {
133:         return ['name' => $role->name, 'permissions' => $role->permissions()->orderBy('name')->pluck('name')->all()];
134:     }
135: 
136:     /**
137:      * Shared-lock roles in deterministic ID order to ensure they exist and prevent deletion during assignment.
138:      *
139:      * @param  list<string>  $names
140:      */
141:     public static function lockRoles(array $names): void
142:     {
143:         $roles = Role::query()->where('guard_name', 'staff')->whereIn('name', $names)
144:             ->orderBy('id')->sharedLock()->get();
145:         if ($roles->count() !== count(array_unique($names))) {
146:             throw ValidationException::withMessages(['roles' => 'قائمة الأدوار تغيرت؛ أعد التحميل ثم حاول مرة أخرى.']);
147:         }
148:     }
149: 
150:     /**
151:      * Re-verify active status and permission grant against database state.
152:      *
153:      * @param  list<string>  $permissions
154:      */
155:     public static function authorize(User $actor, array $permissions): void
156:     {
157:         $actor->refresh();
158:         abort_unless($actor->is_active && ! $actor->is_system && $actor->canAny($permissions), 403);
159:     }
160: 
161:     /**
162:      * Check if another active, non-system SuperAdmin user exists.
163:      * Used to prevent orphaning the system by deactivating or demoting the last admin.
164:      */
165:     public static function hasOtherActiveSuperAdmin(User $target): bool
166:     {
167:         return User::query()->whereKeyNot($target->id)->where('is_active', true)->where('is_system', false)
168:             ->whereHas('roles', fn ($query) => $query->where('name', StaffRole::SuperAdmin->value)->where('guard_name', 'staff'))
169:             ->exists();
170:     }
171: 
172:     /**
173:      * Record an administrative audit entry with sanitized before/after metadata.
174:      *
175:      * @param  list<string>  $fields
176:      * @param  array<string, mixed>  $before
177:      * @param  array<string, mixed>  $after
178:      */
179:     public static function maskEmail(mixed $email): ?string
180:     {
181:         if (! is_string($email) || trim($email) === '') {
182:             return null;
183:         }
184:         [$local, $domain] = array_pad(explode('@', $email, 2), 2, '');
185: 
186:         return mb_substr($local, 0, 2).'***'.($domain !== '' ? '@'.$domain : '');
187:     }
188: 
189:     public static function audit(?User $actor, string $action, string $targetType, int|string|null $targetId, array $fields, array $before = [], array $after = [], array $via = []): void
190:     {
191:         $allowed = array_flip(['roles', 'permissions', 'name', 'branch_id', 'is_active', 'settings', 'code', 'type', 'is_active_branch', 'email']);
192:         $before = array_intersect_key($before, $allowed);
193:         $after = array_intersect_key($after, $allowed);
194:         if (array_key_exists('email', $before)) {
195:             $before['email'] = self::maskEmail($before['email']);
196:         }
197:         if (array_key_exists('email', $after)) {
198:             $after['email'] = self::maskEmail($after['email']);
199:         }
200:         DB::table('staff_audit_logs')->insert([
201:             'actor_id' => $actor?->id,
202:             'action' => $action,
203:             'target_type' => $targetType,
204:             'target_id' => $targetId,
205:             // Sensitive fields (passwords, tokens) are stripped; only allowed state keys are stored
206:             'metadata' => json_encode(['fields' => array_values(array_diff($fields, ['password', 'current_password', 'expected_version'])),
207:                 'before' => $before, 'after' => $after,
208:                 'via' => array_intersect_key($via, array_flip(['channel', 'conversation_id', 'action_id'])),
209:                 'ip' => request()->ip(), 'method' => request()->method()], JSON_THROW_ON_ERROR),
210:             'created_at' => now(),
211:         ]);
212:     }
213: }
