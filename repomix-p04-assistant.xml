 78:     /** @param array{text?:string,selection?:array<string,mixed>|null,mentions?:list<array<string,mixed>>} $turn */
 79:     public function handle(User $actor, AiConversation $conv, array $turn, ?callable $progress = null): AgentReply
 80:     {
 81:         // M-8: سقف عام للجلسات المتزامنة — كل stream يحجز worker حتى 240 ثانية،
 82:         // وبلا سقف جماعي 30 موظفًا يشلّون pool الـ FPM كله (بديل فصل الـ pool
 83:         // يتطلب بنية FPM جديدة؛ هذا الحد يعمل على أي بنية).
 84:         $maxConcurrent = max(1, (int) $this->settings->get('ai_max_concurrent_sessions', 10));
 85:         $ttl = self::MAX_CYCLE_SECONDS + 60;
 86:         $attempts = max(1, min(100, $maxConcurrent * 3 + 10));
 87:         $slot = null;
 88:         for ($attempt = 0; $attempt < $attempts; $attempt++) {
 89:             $candidate = Cache::lock('ai-agent:concurrent-slot:'.($attempt % $maxConcurrent), $ttl);
 90:             if ($candidate->get()) {
 91:                 $slot = $candidate;
 92: 
 93:                 break;
 94:             }
 95:         }
 96:         abort_if($slot === null, 429, 'في ضغط على المساعد حالياً؛ حاول بعد دقيقة.');
 97:         try {
 98:             return $this->handleWithUserLock($actor, $conv, $turn, $progress);
 99:         } finally {
100:             $slot->release();
101:         }
102:     }
103: 
104:     /** @param array{text?:string,selection?:array<string,mixed>|null,mentions?:list<array<string,mixed>>} $turn */
105:     private function handleWithUserLock(User $actor, AiConversation $conv, array $turn, ?callable $progress = null): AgentReply
106:     {
107:         $lock = Cache::lock('ai-agent:user:'.$actor->id, 600);
108:         abort_unless($lock->get(), 423, 'في طلب تاني للمساعد لسه شغال؛ استنى لما يخلص.');
109:         // H4: الـ fatal error بيتجاوز الـ finally — ندفق الـ shutdown بيقفل
110:         // القفل حتى مع انتهاء زمن التنفيذ أو انقطاع الـ SSE.
111:         // L-2: تحت Octane تتراكم الـ shutdown callbacks في الـ worker حتى
112:         // إنهائه (تسرب ذاكرة) — try/finally وحده يكفي هناك.
113:         if (! isset($_SERVER['LARAVEL_OCTANE'])) {
114:             register_shutdown_function(function () use ($lock): void {
115:                 try {
116:                     $lock->release();
117:                 } catch (\Throwable) {
118:                     // القفل خلص أصلًا أو الكاش مش متاح وقت الإنهاء — لا فعل.
119:                 }
120:             });
121:         }
122:         try {
123:             // H4: قطع اتصال السحب من غير ignore_user_abort بينهي الدورة في
124:             // نصها وسيب رسالة ناقصة من غير ردّ أدوات.
125:             ignore_user_abort(true);
126: 
127:             return $this->handleLocked($actor, $conv, $turn, $progress);
128:         } finally {
129:             $lock->release();
130:         }
131:     }
