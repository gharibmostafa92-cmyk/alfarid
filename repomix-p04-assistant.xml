14: final class UpdateRole
15: {
16:     public function __construct(private BranchAccess $access) {}
17: 
18:     /** @param array{name?:string,permissions?:list<string>|null,expected_version?:int|null} $data @param array<string,mixed> $via @return string|null failure code */
19:     public function __invoke(User $actor, Role $role, array $data, array $via = []): ?string
20:     {
21:         $permissions = $data['permissions'] ?? null;
22:         if (array_key_exists('name', $data) && StaffRole::isReserved((string) $data['name'])) {
23:             abort(403, 'هذا الاسم محجوز لدور أساسي في النظام.');
24:         }
25:         if (is_array($permissions) && ! StaffAdministration::mayGrantPermissions($actor, $permissions)) {
26:             abort(403, 'لا يمكنك إسناد صلاحيات لا تملكها.');
27:         }
28: 
29:         return DB::transaction(function () use ($actor, $role, $data, $permissions, $via): ?string {
30:             StaffAdministration::lock();
31:             StaffAdministration::authorize($actor, ['roles.update', 'roles.manage']);
32:             $this->access->assertCentralAccess($actor);
33:             $locked = Role::query()->whereKey($role->getKey())->lockForUpdate()->firstOrFail();
34:             abort_unless($locked->guard_name === 'staff', 404);
35:             StaffAdministration::assertVersion($locked, isset($data['expected_version']) ? (int) $data['expected_version'] : null);
36:             $before = StaffAdministration::roleState($locked);
37:             if ($locked->name === StaffRole::SuperAdmin->value || (StaffRole::isReserved($locked->name) && array_key_exists('name', $data))) {
38:                 return 'protected';
39:             }
40:             abort_unless(StaffAdministration::mayGrantPermissions($actor, array_unique(array_merge($locked->permissions()->pluck('name')->all(), $permissions ?? []))), 403);
41:             StaffAdministration::clearPermissionCacheAfterCommit();
42:             if (array_key_exists('name', $data)) {
43:                 $locked->name = $data['name'];
44:                 try {
45:                     $locked->save();
46:                 } catch (\Illuminate\Database\UniqueConstraintViolationException $e) {
47:                     throw \Illuminate\Validation\ValidationException::withMessages([
48:                         'name' => 'اسم الدور مستخدم بالفعل؛ أعد التحميل ثم حاول مرة أخرى.',
49:                     ]);
50:                 }
51:             }
52:             if ($permissions !== null) {
53:                 $locked->syncPermissions($permissions);
54:             }
55:             StaffAdministration::advanceVersion($locked);
56:             StaffAdministration::audit($actor, 'role.updated', 'role', $locked->id, array_keys($data), $before, StaffAdministration::roleState($locked), $via);
57: 
58:             return null;
59:         });
60:     }
61: }
