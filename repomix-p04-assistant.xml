395:     /**
396:      * Atomically return and increment the next document number for the requested type.
397:      *
398:      * @throws JsonException
399:      */
400:     public function generateNextNumber(string $type): string
401:     {
402:         if ($type === 'movement') {
403:             [$prefix, $padding] = $this->numberingConfig('movement', 'movement_prefix', 'movement_padding');
404:             $number = DB::selectOne('SELECT inventory_movement_number() AS number')->number;
405: 
406:             return $prefix.str_pad((string) $number, $padding, '0', STR_PAD_LEFT);
407:         }
408:         if (isset(self::SEQUENCE_TYPES[$type])) {
409:             $definitions = $this->numberingDefinitions();
410:             $definition = $definitions[$type];
411:             [$prefix, $padding] = $this->numberingConfig($type, $definition['prefix'], $definition['padding']);
412:             $number = DB::selectOne('SELECT document_next_number(?) AS number', [$type])->number;
413: 
414:             return $prefix.str_pad((string) $number, $padding, '0', STR_PAD_LEFT);
415:         }
416:         $definitions = $this->numberingDefinitions();
417: 
418:         if (! isset($definitions[$type])) {
419:             throw new InvalidArgumentException("Unsupported numbering type [{$type}].");
420:         }
421: 
422:         $definition = $definitions[$type];
423:         [$prefix, $padding] = $this->numberingConfig($type, $definition['prefix'], $definition['padding']);
424: 
425:         return DB::transaction(function () use ($definition, $prefix, $padding): string {
426:             // Counter row is locked and read fresh; prefix and padding are cached in request memory
427:             $nextSetting = Setting::query()
428:                 ->where('key', $definition['next'])
429:                 ->lockForUpdate()
430:                 ->first();
431: 
432:             if ($nextSetting === null) {
433:                 throw new InvalidArgumentException("Required numbering setting [{$definition['next']}] is missing.");
434:             }
435: 
436:             $nextValue = $this->counterValue($nextSetting->value);
437: 
438:             $formatted = $prefix.str_pad((string) $nextValue, $padding, '0', STR_PAD_LEFT);
439:             $nextSetting->value = (string) ($nextValue + 1);
440:             $nextSetting->save();
441: 
442:             return $formatted;
443:         }, attempts: 3);
444:     }
445: 
446:     /**
447:      * Cache numbering prefix and padding per request to reduce query overhead.
448:      *
449:      * @return array{0: string, 1: int}
450:      */
451:     private function numberingConfig(string $type, string $prefixKey, string $paddingKey): array
452:     {
453:         return $this->numberingConfig[$type] ??= (function () use ($prefixKey, $paddingKey): array {
454:             $settings = Setting::query()->whereIn('key', [$prefixKey, $paddingKey])->pluck('value', 'key');
455: 
456:             foreach ([$prefixKey, $paddingKey] as $key) {
457:                 if (! $settings->has($key)) {
458:                     throw new InvalidArgumentException("Required numbering setting [{$key}] is missing.");
459:                 }
460:             }
461: 
462:             return [(string) $settings[$prefixKey], max(0, (int) $settings[$paddingKey])];
463:         })();
464:     }
465: 
466:     public function clearCache(): void
467:     {
468:         Cache::forever(self::CACHE_VERSION_KEY, (string) Str::uuid());
469:         Cache::forget(self::CACHE_KEY); // Retire the cache key used before versioning.
470:         $this->numberingConfig = [];
471:         $this->requestCache = null;
472:         $this->resetReadSnapshot();
473:     }
