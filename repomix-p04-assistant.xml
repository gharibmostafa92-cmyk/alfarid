25:             StaffAdministration::authorize($actor, ['users.delete', 'users.manage']);
26:             $locked = User::query()->whereKey($target->getKey())->lockForUpdate()->firstOrFail();
27:             $branch = $this->branches->restrictedBranch($actor);
28:             abort_if($branch !== null && (int) $locked->branch_id !== $branch, 403);
29:             abort_if($locked->is_system, 404);
30:             if (($locked->hasRole(StaffRole::SuperAdmin->value, 'staff')
31:                 && (! $actor->hasRole(StaffRole::SuperAdmin->value, 'staff') || ! StaffAdministration::hasOtherActiveSuperAdmin($locked)))
32:                 || ! StaffAdministration::mayManageUser($actor, $locked)) {
