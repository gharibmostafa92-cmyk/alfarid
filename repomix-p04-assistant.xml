  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Models;
  6: 
  7: use App\Enums\CustomerStatus;
  8: use App\Enums\CustomerType;
  9: use App\Models\Concerns\SerializesAccountEmail;
 10: use Illuminate\Database\Eloquent\Attributes\Fillable;
 11: use Illuminate\Database\Eloquent\Attributes\Hidden;
 12: use Illuminate\Database\Eloquent\Factories\HasFactory;
 13: use Illuminate\Database\Eloquent\Relations\BelongsTo;
 14: use Illuminate\Database\Eloquent\Relations\HasMany;
 15: use Illuminate\Database\Eloquent\SoftDeletes;
 16: use Illuminate\Foundation\Auth\User as Authenticatable;
 17: use Illuminate\Notifications\Notifiable;
 18: use Laravel\Sanctum\HasApiTokens;
 19: 
 20: #[Fillable([
 21:     'name',
 22:     'email',
 23:     'phone',
 24:     'password',
 25:     'type',
 26:     'status',
 27:     'customer_group_id',
 28:     'company_name',
 29:     'tax_number',
 30:     'commercial_register',
 31:     'credit_limit',
 32:     'rejection_reason',
 33:     'suspension_reason',
 34:     'approved_at',
 35:     'approved_by',
 36:     'phone_verified_at',
 37: ])]
 38: #[Hidden(['password', 'remember_token'])]
 39: class Customer extends Authenticatable
 40: {
 41:     use HasApiTokens, HasFactory, Notifiable, SoftDeletes;
 42:     use SerializesAccountEmail;
 43: 
 44:     protected static function booted(): void
 45:     {
 46:         static::creating(function (Customer $customer): void {
 47:             if (! array_key_exists('status', $customer->getAttributes())) {
 48:                 $customer->status = in_array($customer->type, [CustomerType::Wholesale, CustomerType::Distributor], true)
 49:                     ? CustomerStatus::Pending : CustomerStatus::Approved;
 50:             }
 51:         });
 52:     }
 53: 
 54:     public function customerGroup(): BelongsTo
 55:     {
 56:         return $this->belongsTo(CustomerGroup::class);
 57:     }
 58: 
 59:     public function canShop(): bool
 60:     {
 61:         return ! in_array($this->status, [CustomerStatus::Suspended, CustomerStatus::Rejected], true);
 62:     }
 63: 
 64:     public function getEmailForPasswordReset(): string
 65:     {
 66:         return 'customer:'.$this->getKey();
 67:     }
 68: 
 69:     public function setEmailAttribute(?string $email): void
 70:     {
 71:         $normalized = $email === null ? null : mb_strtolower(trim($email));
 72:         if (($this->attributes['email'] ?? null) !== $normalized) {
 73:             $this->attributes['email_verified_at'] = null;
 74:         }
 75:         $this->attributes['email'] = $normalized;
 76:     }
 77: 
 78:     /** خريطة تحويل الأرقام العربية والفارسية إلى أرقام لاتينية */
 79:     private const ARABIC_PERSIAN_DIGITS_MAP = [
 80:         '٠' => '0', '١' => '1', '٢' => '2', '٣' => '3', '٤' => '4',
 81:         '٥' => '5', '٦' => '6', '٧' => '7', '٨' => '8', '٩' => '9',
 82:         '۰' => '0', '۱' => '1', '۲' => '2', '۳' => '3', '۴' => '4',
 83:         '۵' => '5', '۶' => '6', '۷' => '7', '۸' => '8', '۹' => '9',
 84:     ];
 85: 
 86:     public function setPhoneAttribute(string $phone): void
 87:     {
 88:         $this->attributes['phone'] = self::normalizePhone($phone);
 89:     }
 90: 
 91:     public static function normalizePhone(string $phone): string
 92:     {
 93:         $phone = strtr(trim($phone), self::ARABIC_PERSIAN_DIGITS_MAP);
 94:         $phone = preg_replace('/[\s().-]+/u', '', $phone);
 95:         if (preg_match('/^201[0125][0-9]{8}$/', $phone)) {
 96:             return '0'.substr($phone, 2);
 97:         }
 98:         if (str_starts_with($phone, '+20')) {
 99:             return '0'.substr($phone, 3);
100:         }
101:         if (str_starts_with($phone, '0020')) {
102:             return '0'.substr($phone, 4);
103:         }
104: 
105:         return $phone;
106:     }
107: 
108:     public function auditLogs(): HasMany
109:     {
110:         return $this->hasMany(CustomerAuditLog::class);
111:     }
112: 
113:     public function approver(): BelongsTo
114:     {
115:         return $this->belongsTo(User::class, 'approved_by');
116:     }
117: 
118:     public function documents(): HasMany
119:     {
120:         return $this->hasMany(CustomerDocument::class);
121:     }
122: 
123:     public function addresses(): HasMany
124:     {
125:         return $this->hasMany(CustomerAddress::class);
126:     }
127: 
128:     public function returnRequests(): HasMany
129:     {
130:         return $this->hasMany(ReturnRequest::class);
131:     }
132: 
133:     protected function casts(): array
134:     {
135:         return [
136:             'password' => 'hashed',
137:             'type' => CustomerType::class,
138:             'status' => CustomerStatus::class,
139:             'credit_limit' => 'decimal:2',
140:             'wallet_balance' => 'decimal:2',
141:             'approved_at' => 'datetime',
142:             'phone_verified_at' => 'datetime',
143:             'email_verified_at' => 'datetime',
144:         ];
145:     }
146: }
</file>

