1214:     private function prepUpdateSettings(User $actor, AiConversation $conv, array $args): ToolOutcome
1215:     {
1216:         try {
1217:             $this->branches->assertCentralAccess($actor);
1218:         } catch (\Throwable) {
1219:             return ToolOutcome::denied('تعديل الإعدادات محتاج وصول مركزي.');
1220:         }
1221:         $changes = $args['changes'] ?? [];
1222:         if (empty($changes)) {
1223:             return ToolOutcome::denied('مفيش تغييرات.');
1224:         }
1225: 
1226:         // منع تعديل AI settings بدون صلاحية
1227:         $aiKeys = array_filter(array_keys($changes), fn ($k) => str_starts_with($k, 'ai_'));
1228:         if ($aiKeys !== [] && ! $actor->can('ai_agent.settings')) {
1229:             return ToolOutcome::denied('تعديل إعدادات الذكاء الاصطناعي محتاج صلاحية ai_agent.settings.');
1230:         }
1231: 
1232:         // منع تعديل ترقيم من هنا — ليها أداة مخصوصة
1233:         $numberingKeys = array_filter(array_keys($changes), fn ($k) => str_ends_with($k, '_prefix') || str_ends_with($k, '_next_number') || str_ends_with($k, '_padding'));
1234:         if ($numberingKeys !== []) {
1235:             return ToolOutcome::denied('ترقيم المستندات يتعدل من أداة update_document_numbering.');
1236:         }
1237: 
1238:         // التحقق إن المفاتيح موجودة ومسموحة
1239:         // H1: مفاتيح expected/expected.* وai_disabled_tools.* ليست إعدادات قابلة للتعديل.
1240:         $allowedKeys = array_values(array_filter(
1241:             array_keys((new \App\Http\Requests\Api\V1\Admin\UpdateSettingsRequest)->rules()),
1242:             fn (string $key): bool => $key !== 'expected' && ! str_starts_with($key, 'expected.') && ! str_ends_with($key, '.*')
1243:         ));
1244:         $unknownKeys = array_diff(array_keys($changes), $allowedKeys);
1245:         if ($unknownKeys !== []) {
1246:             return ToolOutcome::denied('إعدادات غير معروفة: '.implode(', ', $unknownKeys));
1247:         }
1248: 
1249:         // قراءة القيم الحالية
1250:         $current = [];
1251:         foreach (array_keys($changes) as $key) {
1252:             $current[$key] = $this->settings->get($key);
1253:         }
1254: 
1255:         // H1: تطبيق نفس قواعد الـ REST على قيم الوكيل (نحو/نطاقات/حدود
1256:         // prefix وpadding) — المصدر واحد: UpdateSettingsRequest::rules().
1257:         $this->validateSettingChanges($changes);
1258: 
1259:         $warnings = [];
1260:         if (isset($changes['tax_enabled']) && ! $changes['tax_enabled']) {
1261:             $warnings[] = 'تعطيل الضرائب هيأثر على كل الفواتير الجديدة.';
1262:         }
1263:         if (isset($changes['return_window_days'])) {
1264:             if ($changes['return_window_days'] === 0) {
1265:                 $warnings[] = 'الإرجاع هيكون متوقف تماماً.';
1266:             } elseif ($changes['return_window_days'] < 0) {
1267:                 $warnings[] = 'الإرجاع هيكون بلا حد زمني.';
1268:             }
1269:         }
1270: 
1271:         return $this->makeProposal($actor, $conv, 'update_settings',
1272:             ['changes' => $changes, 'expected' => $current], [],
1273:             ['title' => 'تعديل '.count($changes).' إعداد',
1274:                 'before' => $current, 'after' => $changes,
1275:                 'warnings' => $warnings], $current, 'high');
1276:     }
