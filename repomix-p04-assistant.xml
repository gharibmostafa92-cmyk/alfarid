 420:     private function canonical(mixed $v): mixed
 421:     {
 422:         if (is_array($v)) {
 423:             $isList = array_is_list($v);
 424:             $out = array_map(fn ($x) => $this->canonical($x), $v);
 425:             if (! $isList) {
 426:                 ksort($out);
 427:             }
 428: 
 429:             return $out;
 430:         }
 431: 
 432:         return $v;
 433:     }
