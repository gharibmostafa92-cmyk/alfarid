267:     public function undo(User $actor, AiPendingAction $action): ToolOutcome
268:     {
269:         // L-6: فحص الملكية قبل قفل الصفوف — لا قفل لصفوف إجراء لا يملكه المستخدم.
270:         abort_unless($action->user_id === $actor->id, 403);
271: 
272:         return DB::transaction(function () use ($actor, $action) {
273:             StaffAdministration::lock();
274:             $locked = AiPendingAction::query()->lockForUpdate()->findOrFail($action->id);
275:             abort_unless($locked->user_id === $actor->id, 403);
276:             $this->registry->lockTargets($locked);
277: 
278:             return $this->undoLocked($actor, $locked);
279:         });
