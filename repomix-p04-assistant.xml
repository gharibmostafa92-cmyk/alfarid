1278:     /**
1279:      * H1: تحقق من قيم الإعدادات بمصدر القواعد الواحد (UpdateSettingsRequest)
1280:      * مع تجاهل مفاتيح expected وبقاعدتها اللي بتشترط وجود القيمة الأصلية.
1281:      */
1282:     private function validateSettingChanges(array $changes): void
1283:     {
1284:         $rules = array_filter(
1285:             (new UpdateSettingsRequest)->rules(),
1286:             fn (string $key): bool => $key !== 'expected' && ! str_starts_with($key, 'expected.') && ! str_ends_with($key, '.*'),
1287:             ARRAY_FILTER_USE_KEY
1288:         );
1289:         // H1: مفتاح غير معروف (من هلوسة أو حقن) يترفض هنا أيضًا في execute،
1290:         // حتى لو args اتخزنت قبل الإصلاح.
1291:         $unknown = array_diff(array_keys($changes), array_keys($rules));
1292:         if ($unknown !== []) {
1293:             throw ValidationException::withMessages(array_fill_keys($unknown, 'إعداد غير معروف.'));
1294:         }
1295:         $applicable = [];
1296:         foreach (array_keys($changes) as $key) {
1297:             $applicable[$key] = $rules[$key];
1298:         }
1299:         Validator::make($changes, $applicable)->validate();
1300:     }
