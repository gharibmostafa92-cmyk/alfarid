179:                 <span className="as-spacer" />
180:                 {dirty && <button type="button" className="as-btn as-btn--ghost" disabled={saving} onClick={() => setSettings(original)}>تراجع</button>}
181:                 <button className="as-btn as-btn--primary" disabled={saving || !dirty} type="submit">{saving ? <><span className="as-spin" />جارٍ الحفظ…</> : 'حفظ الإعدادات'}</button>
