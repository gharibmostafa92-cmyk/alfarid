 722:     private function assertAiConstraints(User $actor, AiPendingAction $action): void
 723:     {
 724:         $args = $action->args;
 725:         if (isset($args['user_id'])) {
 726:             $user = User::where('is_system', false)->findOrFail($args['user_id']);
 727:             abort_if($actor->is($user), 403, 'لا يمكن تعديل حسابك من المساعد.');
 728:             $branch = $this->branches->restrictedBranch($actor);
 729:             abort_if($branch !== null && (int) $user->branch_id !== $branch, 403);
 730:             abort_unless(StaffAdministration::mayManageUser($actor, $user), 403);
 731:             if ($action->tool === 'assign_roles') {
 732:                 abort_if($user->hasRole(StaffRole::SuperAdmin->value, 'staff'), 403, 'استخدم الشاشة لإدارة Super Admin.');
 733:             }
 734:         }
 735:         if (isset($args['role_id'])) {
 736:             // H2: الأدوار عامة على كل الفروع — إدارتها من المساعد محتاجة
 737:             // وصول مركزي، زي ما محصل في شاشة الأدوار.
 738:             $this->branches->assertCentralAccess($actor);
 739:             $role = Role::where('guard_name', 'staff')->findOrFail($args['role_id']);
 740:             abort_if(StaffRole::isReserved($role->name), 403);
 741:         }
 742:         // H2: إنشاء الأدوار بلا role_id — الفحص أعلاه لا يغطيه، والتحقق
 743:         // في prepare وحده لا يكفي وقت execute.
 744:         if (in_array($action->tool, ['create_role', 'update_role_permissions', 'delete_role'], true)) {
 745:             $this->branches->assertCentralAccess($actor);
 746:         }
 747:         $roles = array_merge($args['add'] ?? [], $args['remove'] ?? [], $args['roles'] ?? []);
 748:         if (in_array($action->tool, ['assign_roles', 'create_staff_user'], true)) {
 749:             abort_if(in_array(StaffRole::SuperAdmin->value, $roles, true), 403);
 750:         }
 751:     }
