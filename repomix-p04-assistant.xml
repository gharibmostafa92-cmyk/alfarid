762: التعطيل (F04):
763: DELETE من غير expected_version: 422.
764: تعطيل الحساب الحالي: 403.
765: تعطيل موظف معطّل أصلًا: 200 من غير ما يتأكد من النسخة.
766: تعطيل موظف عنده صلاحيات أكتر من الـAdmin: 403.
767: الأدوار والصلاحيات
768: القوائم:
769: GET /roles بيرجع أدوار staff بس، ومعاها users_count وversion وis_builtin وis_system.
770: موظف مقيّد بفرع يقدر يشوف كل الأدوار. تحتاج قرار.
771: GET /permissions بيجمّع الصلاحيات حسب البادئة.
772: الصلاحيات المسحوبة (sales.* وwarehouses.*) ما تظهرش.
773: تعديل الأدوار:
774: تعديل صلاحيات cashier مسموح، بس تغيير اسمه ممنوع.
775: أي تعديل على Super Admin ممنوع: 403.
776: version يزيد 1 مع كل تعديل.
777: مستخدم الدور يكسب أو يخسر الصلاحية على طول، من غير ما يعمل login تاني، لأن الكاش بيتمسح بعد الـcommit.
778: سيناريو فشل: مسح الكاش فشل. لازم يتسجل خطأ والعملية تفضل ناجحة.
779: الإعدادات والترقيم والضريبة
780: الضريبة (F02):
781: default_tax_rate بالقيم -0.01 و0 و100 و100.01 وnull: الحدود مقبولة والباقي 422.
782: tax_enabled وprices_include_tax بقيم booleans على شكل نص ("1"، "false").
783: حساب الضريبة في الـbackend مش موجود في النسخة. اختبر المعاينة في الواجهة كـUnit:
784: الضريبة متعطلة: net=gross.
785: شاملة الضريبة: net = gross/(1+r/100).
786: غير شاملة: tax = net*r/100.
787: اختبار خصائص بمدخلات عشوائية: لأي مبلغ ≥0 ونسبة من 0 لـ100، net + tax = gross بفرق تقريب صغير، وtax ≥ 0. الفايدة إنه بيلقط أخطاء التقريب اللي الأمثلة اليدوية بتفوّتها.
788: السياسات (F04):
789: return_window_days بالقيم -2 و-1 و0 و3650 و3651. الكود بيقول -1 = مفيش حد زمني، و0 = الإرجاع متوقف.
790: اختبر إن طلب الإرجاع بيحترم القيم دي. ده في وحدة المرتجعات، ومش متاح لي.
791: allow_self_approve_purchases.
792: المفاتيح الناقصة:
793: إعداد موجود في الـrules بس مش متضاف في قاعدة البيانات: 409 "شغّل Seeder الإعدادات".
794: قيمة عداد مخزّنة غلط ("0"): BusinessException. حدد الـstatus.
795: إعدادات المساعد:
796: ai_disabled_tools فيها اسم أداة مش موجود: 422.
797: اختبار خصائص للترقيم:
798: لأي بادئة (طول من 0 لـ30) وطول (1 لـ20) وعداد، الرقم الناتج = البادئة + العداد مكمّل بأصفار.
799: تطبيقه مرتين ما يطلّعش نفس الرقم.
800: المصادقة والـmiddleware العامة
801: صلاحية التوكن:
802: التوكن بينتهي بعد staff_token_minutes. اختبر بتجميد الوقت: دقيقة قبل الانتهاء ودقيقة بعده.
803: الـlogin القديم (auth/login) مش موجود لما LEGACY_LOGIN_ENABLED=false: 404.
804: الأداء (من غير أرقام مستهدفة، لأنها مش محددة: تحتاج قرار)
805: GET /users?search= على 50 ألف موظف. البحث LIKE '%x%' مفيهوش فهرس trigram.
806: GET /settings: بيقرأ حوالي 17 sequence مع كل طلب.
807: GET /branches بالأعداد على 500 فرع.
808: توليد 1000 رقم invoice بالتوازي: قياس الانتظار على قفل الصف.
809: ToolRegistry::definitions() بيتبني من جديد جوه UpdateSettingsRequest::rules() مع كل تحديث.
</file>

<file path="bags-platform/backend/app/Http/Controllers/Api/V1/Admin/CustomerController.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Http\Controllers\Api\V1\Admin;
  6: 
  7: use App\Enums\CustomerDocumentStatus;
  8: use App\Enums\CustomerStatus;
  9: use App\Enums\CustomerType;
 10: use App\Http\Controllers\Controller;
 11: use App\Http\Requests\Admin\Customer\ApproveCustomerRequest;
 12: use App\Http\Requests\Admin\Customer\RejectCustomerRequest;
 13: use App\Http\Requests\Admin\Customer\StoreCustomerRequest;
 14: use App\Http\Requests\Admin\Customer\SuspendCustomerRequest;
 15: use App\Http\Requests\Admin\Customer\UpdateCustomerRequest;
 16: use App\Http\Resources\Admin\CustomerResource;
 17: use App\Models\Customer;
 18: use App\Models\CustomerAuditLog;
 19: use App\Models\CustomerDocument;
 20: use App\Services\CustomerManagementService;
 21: use Illuminate\Http\JsonResponse;
 22: use Illuminate\Http\Request;
 23: use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
 24: use Illuminate\Routing\Controllers\HasMiddleware;
 25: use Illuminate\Routing\Controllers\Middleware;
 26: use Illuminate\Support\Facades\Storage;
 27: use Illuminate\Validation\Rule;
 28: use Symfony\Component\HttpFoundation\StreamedResponse;
 29: 
 30: /** إدارة العملاء واعتماد حسابات الجملة في لوحة الإدارة. */
 31: class CustomerController extends Controller implements HasMiddleware
 32: {
 33:     public function __construct(private readonly CustomerManagementService $customers) {}
 34: 
 35:     public static function middleware(): array
 36:     {
 37:         return [
 38:             new Middleware('can:customers.view', only: ['index', 'show']),
 39:             new Middleware('can:customers.documents.view', only: ['downloadDocument', 'reviewDocument', 'storeDocument']),
 40:             new Middleware('can:customers.update', only: ['storeDocument']),
 41:             new Middleware('can:customers.create', only: ['store']),
 42:             new Middleware('can:customers.update', only: ['update']),
 43:             new Middleware('can:customers.delete', only: ['destroy', 'restore']),
 44:             new Middleware('can:customers.approve', only: ['approve', 'reject', 'suspend', 'reviewDocument']),
 45:         ];
 46:     }
 47: 
 48:     public function index(Request $request): AnonymousResourceCollection
 49:     {
 50:         $filters = $request->validate([
 51:             'type' => ['nullable', Rule::enum(CustomerType::class)],
 52:             'business_only' => ['nullable', 'boolean'],
 53:             'status' => ['nullable', Rule::enum(CustomerStatus::class)],
 54:             'customer_group_id' => ['nullable', 'integer', 'min:1'],
 55:             'search' => ['nullable', 'string', 'max:255'],
 56:             'per_page' => ['nullable', 'integer', 'min:1', 'max:100'],
 57:             'trashed' => ['nullable', Rule::in(['only'])],
 58:         ]);
 59: 
 60:         return CustomerResource::collection($this->customers->paginate($filters));
 61:     }
 62: 
 63:     public function store(StoreCustomerRequest $request): JsonResponse
 64:     {
 65:         $customer = $this->customers->create($request->validated(), $request->user()->id);
 66: 
 67:         return CustomerResource::make($customer)
 68:             ->additional(['message' => 'تم إنشاء العميل بنجاح'])
 69:             ->response()
 70:             ->setStatusCode(201);
 71:     }
 72: 
 73:     public function show(Customer $customer): CustomerResource
 74:     {
 75:         return CustomerResource::make($this->customers->find($customer->id));
 76:     }
 77: 
 78:     public function update(UpdateCustomerRequest $request, Customer $customer): CustomerResource
 79:     {
 80:         return CustomerResource::make($this->customers->update($customer, $request->validated(), $request->user()->id));
 81:     }
 82: 
 83:     public function destroy(Request $request, Customer $customer): JsonResponse
 84:     {
 85:         $this->customers->delete($customer, $request->user()->id);
 86: 
 87:         return response()->json(['message' => 'تم حذف العميل بنجاح']);
 88:     }
 89: 
 90:     public function approve(ApproveCustomerRequest $request, Customer $customer): CustomerResource
 91:     {
 92:         $customer = $this->customers->approve($customer, $request->validated(), $request->user()->id);
 93: 
 94:         return CustomerResource::make($customer)->additional(['message' => 'تم اعتماد الحساب بنجاح']);
 95:     }
 96: 
 97:     public function reject(RejectCustomerRequest $request, Customer $customer): CustomerResource
 98:     {
 99:         $customer = $this->customers->reject($customer, $request->validated()['reason'], $request->user()->id);
100: 
101:         return CustomerResource::make($customer)->additional(['message' => 'تم رفض الحساب']);
102:     }
103: 
104:     public function suspend(SuspendCustomerRequest $request, Customer $customer): CustomerResource
105:     {
106:         $customer = $this->customers->suspend($customer, $request->validated()['reason'], $request->user()->id);
107: 
108:         return CustomerResource::make($customer)->additional(['message' => 'تم إيقاف الحساب وإنهاء جلساته']);
109:     }
110: 
111:     /** تنزيل مستند تحقق من التخزين الخاص (scoped: المستند تابع لهذا العميل حصرًا). */
112:     public function downloadDocument(Customer $customer, CustomerDocument $document): StreamedResponse
113:     {
114:         abort_unless(Storage::disk('r2')->exists($document->file_path), 404, 'المستند غير موجود.');
115:         CustomerAuditLog::record($customer, 'document_downloaded', request()->user()->id, ['document_id' => $document->id]);
116: 
117:         return Storage::disk('r2')->download($document->file_path, CustomerDocument::safeName($document->original_name));
118:     }
119: 
120:     public function restore(Request $request, Customer $customer): CustomerResource
121:     {
122:         return CustomerResource::make($this->customers->restore($customer, $request->user()->id));
123:     }
124: 
125:     public function reviewDocument(Request $request, Customer $customer, CustomerDocument $document): JsonResponse
126:     {
127:         $data = $request->validate([
128:             'status' => ['required', Rule::enum(CustomerDocumentStatus::class)],
129:         ]);
130:         $document = $this->customers->reviewDocument($customer, $document, $data['status'], $request->user()->id);
131: 
132:         return response()->json(['data' => ['id' => $document->id, 'status' => $document->status]]);
133:     }
134: 
135:     public function storeDocument(Request $request, Customer $customer): JsonResponse
136:     {
137:         $request->validate(['document' => ['required', 'file', 'mimes:pdf,jpg,jpeg,png', 'max:5120']]);
138:         $document = $this->customers->uploadDocument($customer, $request->file('document'), (int) $request->user()->id);
139: 
140:         return response()->json(['data' => ['id' => $document->id, 'status' => $document->status]], 201);
141:     }
142: }
</file>

