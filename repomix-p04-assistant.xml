 50: 
 51:   // نفس منطق البحث الأصلي (debounce 200ms) + حالة تحميل.
 52:   useEffect(() => {
 53:     setOptions([]); setSearchError(''); setActive(0);
 54:     if (!marker) { setLoading(false); return; }
 55:     let live = true;
 56:     setLoading(true);
 57:     const timer = setTimeout(() => {
 58:       assistantApi.mentions(query ?? '').then(result => {
 59:         if (!live) return;
 60:         const { key, entity } = markerMeta[marker];
 61:         setOptions((result[key] ?? []).slice(0, 10).map(o => ({ entity, id: o.id, label: o.label, meta: o.meta })));
 62:       }).catch(() => { if (live) setSearchError('تعذر تحميل الاقتراحات.'); })
 63:         .finally(() => { if (live) setLoading(false); });
