 472:     private function prepareWrite(User $actor, AiConversation $conv, string $tool, array $args): ToolOutcome
 473:     {
 474:         $this->assertAiConstraints($actor, new AiPendingAction(['tool' => $tool, 'args' => $args]));
 475:         // Forbidden constants
 476:         if ($tool === 'assign_roles' || $tool === 'create_staff_user') {
 477:             $names = array_merge($args['add'] ?? [], $args['roles'] ?? []);
 478:             if (in_array(StaffRole::SuperAdmin->value, $names, true)) {
 479:                 return ToolOutcome::denied('المساعد مش بيقدر يدّي دور Super Admin. استخدم شاشة الموظفين.');
 480:             }
 481:         }
 482:         if (in_array($tool, ['set_user_status', 'assign_roles', 'revoke_user_sessions'], true) && (int) ($args['user_id'] ?? 0) === $actor->id) {
 483:             return ToolOutcome::denied('مش تقدر تعدّل حسابك من المساعد. استخدم الشاشة العادية.');
 484:         }
 485:         if ($tool === 'assign_roles' && in_array(StaffRole::SuperAdmin->value, $args['remove'] ?? [], true)) {
 486:             return ToolOutcome::denied('المساعد مش بيقدر يشيل دور Super Admin. استخدم شاشة الموظفين.');
 487:         }
 488: 
 489:         return match ($tool) {
 490:             'create_branch' => $this->prepCreateBranch($actor, $conv, $args),
 491:             'set_branch_status' => $this->prepSetBranchStatus($actor, $conv, $args),
 492:             'create_role' => $this->prepCreateRole($actor, $conv, $args),
 493:             'update_role_permissions' => $this->prepUpdateRolePerms($actor, $conv, $args),
 494:             'delete_role' => $this->prepDeleteRole($actor, $conv, $args),
 495:             'create_staff_user' => $this->prepCreateStaffUser($actor, $conv, $args),
 496:             'set_user_status' => $this->prepSetUserStatus($actor, $conv, $args),
 497:             'assign_roles' => $this->prepAssignRoles($actor, $conv, $args),
 498:             'revoke_user_sessions' => $this->prepRevokeSessions($actor, $conv, $args),
 499:             'create_location' => $this->prepCreateLocation($actor, $conv, $args),
 500:             'set_location_status' => $this->prepSetLocationStatus($actor, $conv, $args),
 501:             'delete_location' => $this->prepDeleteLocation($actor, $conv, $args),
 502:             'update_settings' => $this->prepUpdateSettings($actor, $conv, $args),
 503:             'update_document_numbering' => $this->prepUpdateDocNumbering($actor, $conv, $args),
 504:             default => ToolOutcome::denied('أداة كتابة غير معروفة.'),
 505:         };
 506:     }
