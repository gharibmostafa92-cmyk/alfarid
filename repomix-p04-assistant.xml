 701: export function PriceImportModal({ open, priceListId, onClose, onSaved }: { open: boolean; priceListId: number; onClose: () => void; onSaved: () => void }) {
 702:   const toast = useToast();
 703:   const { busy, run } = useAction();
 704:   const [file, setFile] = useState<File | null>(null);
 705:   const [report, setReport] = useState<PriceListImportReport | null>(null);
 706:   if (!open) return null;
 707:   const doImport = async () => {
 708:     if (!file) return toast('اختر ملف CSV', 'red');
 709:     if (file.size > 10 * 1024 * 1024) return toast('حجم الملف يتجاوز 10MB', 'red');
 710:     const r = await run(() => priceListsApi.import(priceListId, file), { toast, success: 'تم الاستيراد' });
 711:     if (r) { setReport((r as any).data ?? (r as any)); onSaved(); }
 712:   };
 713:   return (
 714:     <Modal open onClose={onClose} title="استيراد قوائم الأسعار" icon="upload" width={540}
 715:       footer={<><button className="btn btn-soft" onClick={onClose}>إغلاق</button><button className="btn btn-dark" disabled={busy || !file} onClick={doImport}>رفع واستيراد</button></>}>
 716:       <div className="space-y-4">
 717:         <Dropzone accept=".csv" max="10MB" label="اسحب ملف CSV هنا" onFile={setFile} />
 718:         {report && (
 719:           <div>
 720:             <div className="lbl mb-2">نتيجة الاستيراد</div>
