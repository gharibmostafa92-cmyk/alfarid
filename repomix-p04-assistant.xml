297:     /** @param \Illuminate\Support\Collection<int, \App\Models\AiMessage> $messages @return \Illuminate\Support\Collection<int, \App\Models\AiMessage> */
298:     private function fitHistoryBudget($messages, int $budget): mixed
299:     {
300:         if ($messages->isEmpty()) {
301:             return $messages;
302:         }
303:         $size = fn ($m): int => mb_strlen((string) $m->content)
304:             + ($m->provider_parts ? mb_strlen(json_encode($m->provider_parts, JSON_UNESCAPED_UNICODE) ?: '') : 0);
305:         $hasCalls = fn ($m): bool => $m->role === 'model' && is_array($m->provider_parts)
306:             && collect($m->provider_parts)->pluck('functionCall')->filter()->isNotEmpty();
307:         $keep = [];
308:         $total = 0;
309:         $i = $messages->count() - 1;
310:         while ($i >= 0) {
311:             // رد الأداة يُسحب مع استدعاء الموديل السابق له — وحدة ذرية.
312:             if ($messages[$i]->role === 'tool' && $i - 1 >= 0 && $hasCalls($messages[$i - 1])) {
313:                 $unit = [$i - 1, $i];
314:                 $i -= 2;
315:             } else {
316:                 $unit = [$i];
317:                 $i--;
318:             }
319:             $cost = array_sum(array_map(fn ($j) => $size($messages[$j]), $unit));
320:             if ($keep !== [] && $total + $cost > $budget) {
321:                 break;
322:             }
323:             foreach ($unit as $j) {
324:                 $keep[] = $j;
325:             }
326:             $total += $cost;
327:         }
328:         sort($keep);
329:         // NOTE: Eloquent Collection::only() يطابق مفاتيح النماذج لا المواضع —
330:         // الترشيح هنا موضعي حصرًا.
331:         return $messages->filter(fn ($m, $key) => in_array($key, $keep, true))->values();
332:     }
