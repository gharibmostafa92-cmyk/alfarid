 102:     /** @return list<array<string,mixed>> */
 103:     public function declarationsFor(User $actor): array
 104:     {
 105:         $disabled = $this->settings->get('ai_disabled_tools', []);
 106:         if (! is_array($disabled)) {
 107:             $disabled = [];
 108:         }
 109:         $out = [];
 110:         foreach ($this->definitions() as $name => $def) {
 111:             if (in_array($name, $disabled, true)) {
 112:                 continue;
 113:             }
 114:             if ($def['kind'] === ToolKind::Write && ! $actor->can('ai_agent.execute')) {
 115:                 continue;
 116:             }
 117:             if (! $actor->canAny($def['permissions'])) {
 118:                 continue;
 119:             }
 120:             $out[] = $def['declaration'];
 121:         }
 122: 
 123:         return $out;
 124:     }
 125: 
 126:     public function isWrite(string $name): bool
 127:     {
 128:         return ($this->definitions()[$name]['kind'] ?? null) === ToolKind::Write;
 129:     }
 130: 
 131:     /** @param array{name:string,args:array<string,mixed>} $call */
 132:     public function dispatch(User $actor, AiConversation $conv, array $call): ToolOutcome
 133:     {
 134:         $outcome = $this->dispatchAllowed($actor, $conv, $call);
 135:         // L11: سجل denied لرفض الصلاحيات فقط — أخطاء التحقق و"مش موجود"
 136:         // من prompt injection كانت تملأ سجل التدقيق (6 خطوات × أدوات).
 137:         if ($outcome->type === 'denied' && $outcome->auditable) {
 138:             StaffAdministration::audit($actor, 'administration.denied', 'ai_conversation', $conv->id, [], via: ['channel' => 'ai', 'conversation_id' => $conv->id]);
 139:         }
 140: 
 141:         return $outcome;
 142:     }
 143: 
 144:     private function dispatchAllowed(User $actor, AiConversation $conv, array $call): ToolOutcome
 145:     {
 146:         $name = $call['name'];
 147:         $args = $call['args'] ?? [];
 148:         $defs = $this->definitions();
 149:         if (! isset($defs[$name])) {
 150:             return ToolOutcome::denied('أداة غير معروفة.', auditable: false);
 151:         }
 152:         $disabled = $this->settings->get('ai_disabled_tools', []);
 153:         if (is_array($disabled) && in_array($name, $disabled, true)) {
 154:             return ToolOutcome::denied('الأداة دي مقفولة من الإعدادات.', auditable: false);
 155:         }
 156:         if ($defs[$name]['kind'] === ToolKind::Write && ! $actor->can('ai_agent.execute')) {
 157:             return ToolOutcome::denied('محتاج صلاحية ai_agent.execute لتنفيذ تعديلات.');
 158:         }
 159:         if (! $actor->canAny($defs[$name]['permissions'])) {
 160:             return ToolOutcome::denied('معندكش الصلاحية الأصلية للأداة دي.');
 161:         }
 162:         try {
 163:             try {
 164:                 $this->validateArgs($name, $args);
 165:             } catch (ValidationException $e) {
 166:                 return ToolOutcome::denied(collect($e->errors())->flatten()->implode(' '), auditable: false);
 167:             }
 168: 
 169:             return match ($name) {
 170:                 'find_entities' => $this->findEntities($actor, $args),
 171:                 'list_branches' => $this->entityTable('branches', $this->resolver->branches($actor, '', $args)),
 172:                 'list_roles' => $this->entityTable('roles', $this->resolver->roles()),
 173:                 'list_permissions' => $this->permissionsTable(),
 174:                 'list_staff' => $this->entityTable('staff', $this->resolver->users($actor, (string) ($args['query'] ?? ''))),
 175:                 'explain_user_access' => $this->explainUser($actor, $args),
 176:                 'who_can' => $this->whoCan($actor, $args),
 177:                 'compare_roles' => $this->compareRoles($args),
 178:                 'recent_audit' => $this->recentAudit($actor, $args),
 179:                 'ask_user_to_choose' => $this->picker($actor, $args),
 180:                 'bulk_actions' => $this->prepareBulk($actor, $conv, $args),
 181:                 'list_locations' => $this->listLocations($actor, $args),
 182:                 'view_settings' => $this->viewSettings($actor, $args),
 183:                 'view_document_numbering' => $this->viewDocumentNumbering($actor, $args),
 184:                 default => $this->prepareWrite($actor, $conv, $name, $args),
 185:             };
 186:         } catch (ValidationException $e) {
 187:             return ToolOutcome::denied(collect($e->errors())->flatten()->implode(' '), auditable: false);
 188:         } catch (HttpExceptionInterface $e) {
 189:             $auditable = in_array($e->getStatusCode(), [401, 403], true);
 190: 
 191:             return ToolOutcome::denied($e->getMessage() ?: 'مرفوض.', auditable: $auditable);
 192:         } catch (\Throwable $e) {
 193:             report($e);
 194: 
 195:             return ToolOutcome::denied('حصل خطأ أثناء تنفيذ الأداة.', auditable: false);
 196:         }
 197:     }
