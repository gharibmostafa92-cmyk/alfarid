169:       )}
170:     </AuthFrame>
171:   );
172: };
173: 
174: const readResetParams = () => {
175:   if (typeof window === 'undefined') return { token: '', login: '' };
176:   const p = new URLSearchParams(window.location.search);
177:   return { token: p.get('token') || '', login: p.get('email') || p.get('phone') || '' };
178: };
179: 
180: export const ResetPassword = ({ onBack, linkState = 'valid', onForgot, onResetSubmit }) => {
181:   const [{ token: urlToken, login: urlLogin }] = useState(readResetParams);
182:   const [show, setShow] = useState(false);
183:   const [login, setLogin] = useState(urlLogin);
184:   const [p1, setP1] = useState(''); const [p2, setP2] = useState('');
185:   const [errs, setErrs] = useState({});
186:   const [busy, setBusy] = useState(false);
187:   const [done, setDone] = useState(false);
188:   const token = urlToken;
189:   const submit = async (e) => {
190:     e.preventDefault();
191:     const er = {};
192:     if (!login.trim()) er.login = 'أدخل البريد الإلكتروني أو رقم الموبايل.';
193:     if (!token) er.token = 'رابط إعادة التعيين ناقص الرمز (token).';
194:     if (p1.length < 8) er.p1 = 'كلمة المرور لازم تكون 8 حروف على الأقل.';
195:     if (p1 !== p2) er.p2 = 'تأكيد كلمة المرور غير مطابق.';
196:     setErrs(er);
197:     if (Object.keys(er).length) return;
198:     if (!onResetSubmit) { setErrs({ ...er, token: 'خدمة إعادة التعيين غير متاحة حاليًا.' }); return; }
199:     setBusy(true);
200:     try {
201:       await onResetSubmit(login.trim(), token, p1, p2);
202:       setDone(true);
203:     } catch (err) {
204:       const info = apiError(err);
205:       const mapped = {};
206:       const fields = { password: 'p1', password_confirmation: 'p2', email: 'login', phone: 'login' };
207:       Object.entries(info.fields || {}).forEach(([k, msgs]) => { mapped[fields[k] || k] = Array.isArray(msgs) ? msgs[0] : String(msgs); });
208:       setErrs({ ...mapped, ...(Object.keys(mapped).length ? {} : { p1: info.message }) });
209:     } finally {
210:       setBusy(false);
211:     }
212:   };
213:   const rules = [[p1.length >= 8, '8 حروف على الأقل'], [/[A-Za-z]/.test(p1) && /\d/.test(p1), 'حروف وأرقام'], [p1 && p1 === p2, 'التأكيد مطابق']];
214:   if (linkState !== 'valid' || !token) return (
215:     <AuthFrame>
216:       <h1 className="luxury-title">{linkState === 'expired' ? 'انتهت صلاحية الرابط' : 'الرابط غير صالح'}</h1>
217:       <p className="luxury-sub">{linkState === 'expired' ? 'روابط إعادة التعيين صالحة لمدة 60 دقيقة فقط. اطلب رابط جديد.' : 'الرابط ده مستخدم قبل كده أو ناقص. اطلب رابط جديد من صفحة استعادة كلمة المرور.'}</p>
218:       <p className="luxury-form-error" role="alert">لا يمكن إعادة تعيين كلمة المرور بهذا الرابط.</p>
219:       <button className="pill-btn-primary" style={{ marginTop: 22 }} onClick={onForgot}>طلب رابط جديد</button>
220:       <div className="luxury-bottom-switch"><button className="luxury-switch-link" onClick={onBack}>العودة لتسجيل الدخول</button></div>
221:     </AuthFrame>
222:   );
223:   return (
224:     <AuthFrame>
225:       <h1 className="luxury-title">{done ? 'تم تغيير كلمة المرور' : 'إعادة تعيين كلمة المرور'}</h1>
226:       <p className="luxury-sub">{done ? 'تقدر دلوقتي تسجل الدخول بكلمة المرور الجديدة.' : 'اختر كلمة مرور جديدة لحسابك.'}</p>
227:       {done ? (
228:         <div className="luxury-auth-fields">
229:           <p className="luxury-success" role="status"><span className="luxury-verified-badge">تم التحديث بنجاح</span></p>
230:           <button className="pill-btn-primary" onClick={onBack}>تسجيل الدخول</button>
231:         </div>
232:       ) : (
233:         <form className="luxury-form" onSubmit={submit} noValidate>
234:           <div>
235:             <label className="luxury-field-label">البريد الإلكتروني أو رقم الموبايل<span className="luxury-req-mark">*</span></label>
236:             <input className="pill-input" dir="ltr" value={login} onChange={(e) => setLogin(e.target.value)} aria-invalid={!!errs.login} />
237:             {errs.login && <p className="luxury-field-error" role="alert">{errs.login}</p>}
238:             {errs.token && <p className="luxury-field-error" role="alert">{errs.token}</p>}
239:           </div>
240:           {[['p1', 'كلمة المرور الجديدة', p1, setP1], ['p2', 'تأكيد كلمة المرور', p2, setP2]].map(([k, l, v, set]) => (
241:             <div key={k}>
242:               <label className="luxury-field-label">{l}<span className="luxury-req-mark">*</span></label>
243:               <div className="luxury-pwd-wrap">
244:                 <input className="pill-input" style={{ paddingLeft: 52 }} type={show ? 'text' : 'password'} value={v} onChange={(e) => set(e.target.value)} aria-invalid={!!errs[k]} />
245:                 <button type="button" className="luxury-eye-btn" style={{ right: 'auto', left: 8 }} onClick={() => setShow(!show)} aria-label="إظهار كلمة المرور"><i className={`fa-regular ${show ? 'fa-eye-slash' : 'fa-eye'}`} /></button>
246:               </div>
247:               {errs[k] && <p className="luxury-field-error" role="alert">{errs[k]}</p>}
248:             </div>
249:           ))}
250:           <ul className="as-rules">{rules.map(([ok, l]) => <li key={l} className={ok ? 'ok' : ''}><i className={`fa-solid ${ok ? 'fa-check' : 'fa-circle'}`} />{l}</li>)}</ul>
251:           <button className="pill-btn-primary" disabled={busy}>{busy ? 'جارٍ الحفظ…' : 'حفظ كلمة المرور'}</button>
252:           <div className="luxury-bottom-switch"><button type="button" className="luxury-switch-link" onClick={onBack}>العودة لتسجيل الدخول</button></div>
253:         </form>
254:       )}
255:     </AuthFrame>
256:   );
257: };
</file>

<file path="bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Ai/AiConversationController.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Http\Controllers\Api\V1\Admin\Ai;
 6: 
 7: use App\Http\Controllers\Controller;
 8: use App\Models\AiConversation;
 9: use App\Services\BranchAccess;
