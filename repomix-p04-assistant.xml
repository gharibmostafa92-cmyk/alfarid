271:     /**
272:      * M7: سقف حجم نتائج الأدوات — نتيجة ضخمة تعبّي التاريخ وترفع تكلفة الـ
273:      * token بتقريبًا تربيعيًا. الجزء المقطوع راجع للأداة كنص مفهوم.
274:      */
275:     private function cappedToolResponses(array $parts): array
276:     {
277:         $cap = max(1024, (int) $this->settings->get('ai_tool_result_max_chars', 16000));
278:         foreach ($parts as $index => $part) {
279:             if (json_encode($part, JSON_UNESCAPED_UNICODE) !== false
280:                 && strlen(json_encode($part, JSON_UNESCAPED_UNICODE)) <= $cap) {
281:                 continue;
282:             }
283:             $response = $part['functionResponse'] ?? null;
284:             if (! is_array($response)) {
285:                 continue;
286:             }
287:             $name = (string) ($response['name'] ?? 'unknown');
288:             $parts[$index] = ['functionResponse' => [
289:                 'name' => $name,
290:                 'response' => ['error' => 'نتيجة الأداة اتجاوزت الحد ('.$cap.' رمز). حدّد بحثك أو جيب البيانات خبطة خبطة.'],
291:             ] + (isset($response['id']) && is_string($response['id']) ? ['id' => $response['id']] : [])];
292:         }
293: 
294:         return $parts;
295:     }
