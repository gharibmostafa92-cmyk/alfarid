 684:                       <Icon name="edit" size={13} />
 685:                     </button>
 686:                   </RowActions>
 687:                 ),
 688:               },
 689:             ]}
 690:           />
 691:         </Card>
 692:       )}
 693:       {form && <PriceListForm row={form.id ? (form as PriceListRow) : null} onClose={() => setForm(null)} onSaved={() => lists.reload()} />}
 694:       {gform && (
