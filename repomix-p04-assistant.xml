282:     private function undoLocked(User $actor, AiPendingAction $action): ToolOutcome
283:     {
284:         abort_unless($action->user_id === $actor->id, 403);
285:         $this->authorizeTool($actor, $action);
286:         abort_unless($this->registry->canUndo($action), 409);
287:         abort_unless(isset($action->result['undo_state']) && hash_equals($action->result['undo_state'], $this->registry->targetState($action)), 409, 'السجل اتعدل بعد التنفيذ؛ التراجع مش آمن.');
288:         abort_unless($action->status === 'executed' && $action->executed_at && $action->executed_at->copy()->addMinutes(15)->isFuture(), 409, 'التراجع مش متاح.');
289:         abort_unless($actor->can('ai_agent.execute'), 403);
290:         $via = ['channel' => 'ai', 'conversation_id' => $action->conversation_id, 'action_id' => $action->id];
291:         try {
292:             $outcome = $this->registry->executeUndo($actor, $action, $via);
293:         } catch (HttpExceptionInterface $e) {
294:             if ($e->getStatusCode() === 409) {
295:                 $this->event($action, 'result', 'التراجع اترفض عشان السجل اتعدل.', [['type' => 'result', 'ok' => false, 'message' => 'التراجع اترفض: السجل اتعدل بعد التنفيذ.']]);
296:                 throw $e;
297:             } throw $e;
298:         }
299:         if ($outcome->type === 'result') {
300:             $action->forceFill(['status' => 'undone'])->save();
301:             $this->event($action, 'result', 'تم التراجع.', [['type' => 'result', 'ok' => true, 'message' => 'تم التراجع.']]);
302:         }
303: 
304:         return $outcome;
305:     }
