 18: /**
 19:  * Central settings and document numbering configuration service.
 20:  *
 21:  * Caches static system settings and manages atomic generation of sequential document identifiers
 22:  * (orders, transfers, movements, invoices) via PostgreSQL sequences and optimistic concurrency locking.
 23:  */
 24: class SettingService
 25: {
 26:     /** @var array<string, array{0: string, 1: int}> Cached numbering prefix and padding config per request to avoid repeated lookups. */
 27:     private array $numberingConfig = [];
 28: 
 29:     private ?array $transactionSnapshot = null;
 30: 
 31:     private bool $uncommittedSettings = false;
 32: 
 33:     /** M-6: ذاكرة على مستوى الطلب للنسخة المثبتة — الخدمة scoped فلا تتسرب بين الطلبات. */
 34:     private ?array $requestCache = null;
 35: 
 36:     public function resetReadSnapshot(bool $transactionBoundary = false): void
 37:     {
 38:         $this->transactionSnapshot = null;
 39:         if ($transactionBoundary) {
 40:             $this->uncommittedSettings = false;
 41:             $this->requestCache = null;
 42:         }
 43:     }
 44: 
 45:     /** @var list<string> */
 46:     public array $warnings = [];
 47: 
 48:     private const CACHE_KEY = 'app_settings_static';
 49: 
 50:     private const CACHE_VERSION_KEY = 'app_settings_static_version';
 51: 
 52:     private const CACHE_TTL_SECONDS = 3600;
 53: 
 54:     /** @var list<string> */
 55:     private const NUMBERING_COUNTER_KEYS = [
 56:         'shift_next_number',
 57:         'expense_next_number',
 58:         'treasury_transfer_next_number',
 59:         'payment_notice_next_number',
 60:         'pos_invoice_next_number',
 61:         'invoice_next_number',
 62:         'order_next_number',
 63:         'purchase_order_next_number',
 64:         'quotation_next_number',
 65:         'movement_next_number',
 66:         'transfer_next_number',
 67:         'stocktake_next_number',
 68:         'return_next_number',
 69:         'purchase_request_next_number',
 70:         'delivery_next_number',
 71:         'supplier_invoice_next_number',
 72:         'supplier_payment_next_number',
 73:     ];
 74: 
 75:     /** Internal documents numbered via dedicated PostgreSQL sequences to prevent long transaction row locks. */
 76:     private const SEQUENCE_TYPES = [
 77:         'order' => 'order_next_number',
 78:         'purchase_order' => 'purchase_order_next_number',
 79:         'quotation' => 'quotation_next_number',
 80:         'transfer' => 'transfer_next_number',
 81:         'stocktake' => 'stocktake_next_number',
 82:         'return' => 'return_next_number',
 83:         'purchase_request' => 'purchase_request_next_number',
 84:         'delivery' => 'delivery_next_number',
 85:         'supplier_invoice' => 'supplier_invoice_next_number',
 86:         'supplier_payment' => 'supplier_payment_next_number',
 87:         // H5: نقاط البيع المرتفعة الحجم على sequences — فجوات مقبولة لتجنب
 88:         // اختناق صف واحد عند كل عملية بيع/مصروف/تحويل خزينة.
 89:         'shift' => 'shift_next_number',
 90:         'pos_invoice' => 'pos_invoice_next_number',
 91:         'expense' => 'expense_next_number',
 92:         'treasury_transfer' => 'treasury_transfer_next_number',
 93:         'payment_notice' => 'payment_notice_next_number',
 94:     ];
 95:     // H5: فاتورة الضريبية (invoice) مش دخيلة هنا — تفضل على قفل الصف لأن
 96:     // الترقيم المتصل شرط قانوني.
 97: 
 98:     /** @var array<string, array{0: string, 1: string}> */
 99:     private const NUMBERING_TARGETS = [
100:         'order' => ['orders', 'order_number'],
101:         'purchase_order' => ['purchase_orders', 'po_number'],
102:         'quotation' => ['quotations', 'quotation_number'],
103:         'transfer' => ['stock_transfers', 'transfer_number'],
104:         'stocktake' => ['stocktakes', 'stocktake_number'],
105:         'return' => ['return_requests', 'return_number'],
106:         'purchase_request' => ['purchase_requests', 'request_number'],
107:         'delivery' => ['supplier_deliveries', 'delivery_number'],
108:         'supplier_invoice' => ['supplier_invoices', 'invoice_number'],
109:         'supplier_payment' => ['supplier_payments', 'payment_number'],
110:         'shift' => ['pos_shifts', 'shift_number'],
111:         'expense' => ['expenses', 'expense_number'],
112:         'treasury_transfer' => ['treasury_transfers', 'transfer_number'],
113:         'payment_notice' => ['wholesale_payment_notices', 'notice_number'],
114:         'movement' => ['stock_movements', 'reference_number'],
115:     ];
116: 
117:     /**
118:      * M9: تصفير الحالة الداخلية للخدمة (نفسها snapshot/عداد/عداد الوكيل).
119:      */
120:     public function forgetMemoryState(): void
121:     {
122:         $this->numberingConfig = [];
123:         $this->resetReadSnapshot(true);
124:     }
125: 
126:     /**
127:      * Return all settings grouped by their group name, with values cast to their declared types.
128:      * Numbering counters are read fresh because they change for every generated document number.
129:      *
130:      * @return array<string, array<string, mixed>>
131:      */
132:     public function getAllGrouped(): array
133:     {
134:         $grouped = $this->staticSettings();
135: 
136:         $counters = Setting::query()
137:             ->whereIn('key', self::NUMBERING_COUNTER_KEYS)
138:             ->orderBy('key')
139:             ->get()
140:             ->mapWithKeys(fn (Setting $setting): array => [
141:                 $setting->key => $this->castValue($setting->value, $setting->type),
142:             ])
143:             ->all();
144: 
145:         if (isset($counters['movement_next_number'])) {
146:             $counters['movement_next_number'] = $this->nextMovementNumber();
147:         }
148:         foreach (self::SEQUENCE_TYPES as $type => $key) {
149:             if (isset($counters[$key])) {
150:                 $counters[$key] = $this->nextDocumentNumber($type);
151:             }
152:         }
153: 
154:         if ($counters !== []) {
155:             $grouped['numbering'] = array_merge($grouped['numbering'] ?? [], $counters);
156:             ksort($grouped['numbering']);
157:         }
158: 
159:         return $grouped;
160:     }
161: 
162:     private function staticSettings(): array
163:     {
164:         $read = function (): array {
165:             return Setting::query()
166:                 ->whereNotIn('key', self::NUMBERING_COUNTER_KEYS)
167:                 ->orderBy('group')
168:                 ->orderBy('key')
169:                 ->get()
170:                 ->groupBy('group')
171:                 ->map(fn ($settings): array => $settings
172:                     ->mapWithKeys(fn (Setting $setting): array => [
173:                         $setting->key => $this->castValue($setting->value, $setting->type),
174:                     ])
175:                     ->all())
176:                 ->all();
177:         };
178: 
179:         $inTransaction = DB::transactionLevel() > 0;
180:         if ($inTransaction && $this->transactionSnapshot !== null) {
181:             return $this->transactionSnapshot;
182:         }
183:         if ($inTransaction && $this->uncommittedSettings) {
184:             return $this->transactionSnapshot = $read();
185:         }
186:         $version = Cache::get(self::CACHE_VERSION_KEY);
187:         if (! is_string($version)) {
188:             Cache::add(self::CACHE_VERSION_KEY, (string) Str::uuid());
189:             $version = Cache::get(self::CACHE_VERSION_KEY);
190:         }
191: 
192:         // M-6: خارج الـ transactions تُحفظ النتيجة في ذاكرة الطلب — كل get()
193:         // كان يكلف رحلتين للكاش وفك تسلسل المصفوفة كاملة.
194:         if ($this->requestCache !== null) {
195:             return $this->requestCache;
196:         }
197:         $key = self::CACHE_KEY.':'.$version;
198:         if ($inTransaction) {
199:             // Reuse committed cache values, but never publish an uncommitted cache miss.
200:             return $this->transactionSnapshot = Cache::get($key) ?? $read();
201:         }
202: 
203:         $result = Cache::remember($key, self::CACHE_TTL_SECONDS, $read);
204:         // كاتب متأخر قد يدير النسخة أثناء القراءة — لقطة قديمة لا تُحفظ
205:         // في ذاكرة الطلب، وإلا التصقت القيمة القديمة بباقي الطلب.
206:         if (Cache::get(self::CACHE_VERSION_KEY) === $version) {
207:             $this->requestCache = $result;
208:         }
209: 
210:         return $result;
211:     }
212: 
213:     public function get(string $key, mixed $default = null): mixed
214:     {
215:         if (in_array($key, self::NUMBERING_COUNTER_KEYS, true)) {
216:             if ($key === 'movement_next_number') {
217:                 return $this->nextMovementNumber();
218:             }
219:             $type = array_search($key, self::SEQUENCE_TYPES, true);
220:             if (is_string($type)) {
221:                 return $this->nextDocumentNumber($type);
222:             }
223:             $setting = Setting::query()->where('key', $key)->first();
224: 
225:             return $setting ? $this->castValue($setting->value, $setting->type) : $default;
226:         }
227:         foreach ($this->staticSettings() as $settings) {
228:             if (array_key_exists($key, $settings)) {
229:                 return $settings[$key];
230:             }
231:         }
232: 
233:         return $default;
234:     }
235: 
236:     public function getBool(string $key, bool $default = false): bool
237:     {
238:         return filter_var($this->get($key, $default), FILTER_VALIDATE_BOOLEAN);
239:     }
