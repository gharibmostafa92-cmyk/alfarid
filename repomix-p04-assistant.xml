1305:         StaffAdministration::authorize($actor, ['settings.manage']);
1306:         if (array_filter(array_keys($args['changes']), fn ($key) => str_starts_with($key, 'ai_')) !== []) {
1307:             StaffAdministration::authorize($actor, ['ai_agent.settings']);
1308:         }
1309:         // H1: إعادة التحقق وقت التأكيد تحمي من args خزّنت قبل الإصلاح.
1310:         $this->validateSettingChanges($args['changes']);
1311:         // L6: التدقيق يعرف إن التعديل جه من قناة المساعد.
1312:         $this->settings->updateBatch($args['changes'], $args['expected'], $via);
1313: 
1314:         return ToolOutcome::result(true, 'تم تحديث الإعدادات.',
1315:             ['updated_keys' => array_keys($args['changes'])],
1316:             ['type' => 'result', 'ok' => true,
1317:                 'message' => 'تم تحديث '.count($args['changes']).' إعداد.',
1318:                 'deep_link' => '/settings']);
1319:     }
1320: 
1321:     private function prepUpdateDocNumbering(User $actor, AiConversation $conv, array $args): ToolOutcome
1322:     {
1323:         try {
1324:             $this->branches->assertCentralAccess($actor);
1325:         } catch (\Throwable) {
1326:             return ToolOutcome::denied('تعديل الترقيم محتاج وصول مركزي.');
1327:         }
1328:         $type = (string) ($args['type'] ?? '');
1329:         if ($type === '') {
1330:             return ToolOutcome::denied('نوع المستند مطلوب.');
1331:         }
1332: 
1333:         $changes = [];
1334:         $current = [];
1335:         if (isset($args['prefix'])) {
1336:             $key = $type.'_prefix';
1337:             $changes[$key] = (string) $args['prefix'];
1338:             $current[$key] = $this->settings->get($key, '');
1339:         }
1340:         if (isset($args['next_number'])) {
1341:             $key = $type.'_next_number';
1342:             $changes[$key] = (int) $args['next_number'];
1343:             $current[$key] = $this->settings->get($key, 1);
1344:         }
1345:         if (isset($args['padding'])) {
1346:             $key = $type.'_padding';
1347:             $changes[$key] = (int) $args['padding'];
1348:             $current[$key] = $this->settings->get($key, 6);
1349:         }
1350: 
1351:         if (empty($changes)) {
1352:             return ToolOutcome::denied('حدد قيمة واحدة على الأقل (prefix أو next_number أو padding).');
1353:         }
1354:         // H1: مسار الترقيم مطبّق عليه حدود الـ REST: بادئة 30 رمزًا
1355:         // كحد أقصى، padding من 1 لـ 20، عداد بين 1 و999999999.
1356:         $this->validateSettingChanges($changes);
1357: 
1358:         $warnings = [];
1359:         if (isset($args['next_number'])) {
1360:             $currentNext = $current[$type.'_next_number'] ?? 1;
1361:             if ($args['next_number'] < $currentNext) {
1362:                 $warnings[] = 'العداد لا ينخفض — لو القيمة أقل من الحالية هتتجاهل.';
1363:             }
1364:         }
1365: 
1366:         // بناء عينة الرقم الجديد
1367:         $newPrefix = $changes[$type.'_prefix'] ?? $this->settings->get($type.'_prefix', '');
1368:         $newNext = $changes[$type.'_next_number'] ?? $this->settings->get($type.'_next_number', 1);
1369:         $newPadding = $changes[$type.'_padding'] ?? $this->settings->get($type.'_padding', 6);
1370:         $sample = $newPrefix.str_pad((string) $newNext, $newPadding, '0', STR_PAD_LEFT);
1371: 
1372:         return $this->makeProposal($actor, $conv, 'update_document_numbering',
1373:             ['type' => $type, 'changes' => $changes, 'expected' => $current], [],
1374:             ['title' => 'تعديل ترقيم '.$type,
1375:                 'before' => $current, 'after' => array_merge($changes, ['sample' => $sample]),
1376:                 'warnings' => $warnings], $current, 'high');
1377:     }
1378: 
1379:     private function execUpdateDocNumbering(User $actor, array $args, array $via, AiPendingAction $action): ToolOutcome
1380:     {
1381:         $this->branches->assertCentralAccess($actor);
1382:         StaffAdministration::authorize($actor, ['settings.manage']);
1383:         // H1: إعادة التحقق وقت التأكيد.
1384:         $this->validateSettingChanges($args['changes']);
1385:         // L6: التدقيق يعرف إن التعديل جه من قناة المساعد.
1386:         $this->settings->updateBatch($args['changes'], $args['expected'], $via);
1387: 
1388:         return ToolOutcome::result(true, 'تم تحديث ترقيم '.$args['type'].'.',
1389:             ['type' => $args['type'], 'updated_keys' => array_keys($args['changes'])],
1390:             ['type' => 'result', 'ok' => true,
1391:                 'message' => 'تم تحديث ترقيم '.$args['type'].'.',
1392:                 'deep_link' => '/settings']);
1393:     }
1394: 
1395:     public function executeUndo(User $actor, AiPendingAction $action, array $via): ToolOutcome
1396:     {
1397:         $inv = $action->inverse ?? [];
1398:         $tool = $action->tool;
1399:         $args = $action->args;
1400:         try {
1401:             $this->assertAiConstraints($actor, $action);
1402:             if ($tool === 'set_branch_status' && isset($inv['is_active'])) {
1403:                 $b = Branch::findOrFail($args['branch_id']);
1404:                 app(UpdateBranch::class)($actor, $b, ['is_active' => (bool) $inv['is_active']], $via);
1405: 
1406:                 return ToolOutcome::result(true, 'تم التراجع.');
1407:             }
1408:             if ($tool === 'update_role_permissions' && isset($inv['permissions'])) {
1409:                 $r = Role::findOrFail($args['role_id']);
1410:                 $f = app(UpdateRole::class)($actor, $r, ['permissions' => $inv['permissions']], $via);
1411: 
1412:                 return $f ? ToolOutcome::result(false, 'الدور محمي.') : ToolOutcome::result(true, 'تم التراجع.');
1413:             }
1414:             if ($tool === 'set_user_status' && isset($inv['is_active'])) {
1415:                 $u = User::findOrFail($args['user_id']);
1416:                 $f = app(UpdateStaffUser::class)($actor, $u, ['is_active' => (bool) $inv['is_active']], $via);
1417: 
1418:                 return $f ? ToolOutcome::result(false, 'مش مسموح.') : ToolOutcome::result(true, 'تم التراجع.');
1419:             }
1420:             if ($tool === 'assign_roles' && isset($inv['roles'])) {
1421:                 $u = User::findOrFail($args['user_id']);
1422:                 $f = app(UpdateStaffUser::class)($actor, $u, ['roles' => $inv['roles']], $via);
1423: 
1424:                 return $f ? ToolOutcome::result(false, 'مش مسموح.') : ToolOutcome::result(true, 'تم التراجع.');
1425:             }
1426:             if ($tool === 'set_location_status' && isset($inv['is_active'])) {
1427:                 // H3: التراجع يمر بنفس القاعدة المشتركة (مع قفل الصف داخل الـ action).
1428:                 app(\App\Actions\Locations\SetLocationStatus::class)(
1429:                     $actor, Location::findOrFail($args['location_id']), (bool) $inv['is_active'], $via);
1430: 
1431:                 return ToolOutcome::result(true, 'تم التراجع.');
1432:             }
1433: 
1434:             return ToolOutcome::result(false, 'العملية دي مفيهاش تراجع تلقائي.');
1435:         } catch (HttpExceptionInterface $e) {
1436:             if ($e->getStatusCode() === 409) {
1437:                 throw $e;
1438:             }
1439: 
1440:             return ToolOutcome::result(false, $e->getMessage() ?: 'فشل التراجع.');
1441:         }
1442:     }
1443: }
