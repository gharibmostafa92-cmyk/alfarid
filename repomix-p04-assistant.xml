 955:   const saveRow = async (r: any) => {
 956:     await run(() => itemsApi.update(r.id, { product_variant_id: r.variantId, min_qty: Number(r.min), price: Number(r.price), starts_at: r.from || null, ends_at: r.to || null }),
 957:       { toast, success: 'تم حفظ البند' });
