551: .as-admin-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
552: .as-form { display: grid; gap: 0; }
553: .as-field { display: grid; grid-template-columns: 1fr minmax(120px, 160px); align-items: center; gap: .5rem 1rem; padding: .85rem 1rem; border-bottom: 1px solid var(--as-border); }
