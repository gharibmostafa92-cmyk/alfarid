 753:     private function checkVersion(string $key, mixed $expected, $model): void
 754:     {
 755:         if (str_starts_with($key, 'branch:')) {
 756:             abort_if($this->branchVersion($model) !== $expected, 409, 'حد عدّل السجل ده بعد الاقتراح.');
 757:         } elseif (str_starts_with($key, 'location:')) {
 758:             // H3: الموقع نسختة lock هي بصمة الحالة، بتقارن كذا في قفل الصف.
 759:             abort_if($this->hashArgs(['is_active' => (bool) $model->is_active]) !== $expected, 409, 'حد عدّل السجل ده بعد الاقتراح.');
 760:         } else {
 761:             abort_if((int) $model->lock_version !== $expected, 409, 'حد عدّل السجل ده بعد الاقتراح.');
 762:         }
 763:     }
