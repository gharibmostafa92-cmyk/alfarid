<file path="bags-platform/backend/app/Actions/Branches/UpdateBranch.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Actions\Branches;
 6: 
 7: use App\Enums\PosShiftStatus;
 8: use App\Exceptions\BusinessException;
 9: use App\Models\Branch;
10: use App\Models\PosShift;
11: use App\Models\StockLevel;
12: use App\Models\StockTransfer;
13: use App\Models\Treasury;
14: use App\Models\User;
15: use App\Services\BranchAccess;
16: use App\Services\StaffAdministration;
17: use Illuminate\Support\Facades\DB;
18: 
19: final class UpdateBranch
20: {
21:     public function __construct(private BranchAccess $access) {}
22: 
23:     /** @param array<string,mixed> $data @param array<string,mixed> $via */
24:     public function __invoke(User $actor, Branch $branch, array $data, array $via = [], ?string $expectedUpdatedAt = null): Branch
25:     {
26:         $this->access->assertCentralAccess($actor);
27:         DB::transaction(function () use ($actor, $branch, $data, $via, $expectedUpdatedAt): void {
28:             StaffAdministration::lock();
29:             StaffAdministration::authorize($actor, ['branches.update', 'branches.manage']);
30:             $this->access->assertCentralAccess($actor);
31:             $locked = Branch::query()->lockForUpdate()->findOrFail($branch->id);
32:             // M3: قفل توافقي حقيقي بالـ lock_version (بدقة أقل من الثانية)،
33:             // مع دعم expectedUpdatedAt القديم احتياطًا.
34:             $expectedLockVersion = $data['lock_version'] ?? null;
35:             unset($data['lock_version']);
36:             if ($expectedLockVersion !== null) {
37:                 abort_if((int) $locked->lock_version !== (int) $expectedLockVersion, 409, 'تم تعديل السجل بواسطة مستخدم آخر؛ أعد التحميل قبل الحفظ.');
38:             } elseif ($expectedUpdatedAt !== null && $locked->updated_at?->toIso8601String() !== $expectedUpdatedAt) {
39:                 abort(409, 'تم تعديل السجل بواسطة مستخدم آخر؛ أعد التحميل قبل الحفظ.');
40:             }
41:             $before = StaffAdministration::branchState($locked);
42:             // city_id wins over free text so the two columns cannot drift.
43:             if (array_key_exists('city_id', $data) && ! empty($data['city_id'])
44:                 && ($city = \App\Models\City::query()->find($data['city_id']))) {
45:                 $data['city'] = $city->name_ar ?: $city->name_en;
46:             }
47:             if (array_key_exists('is_active', $data) && ! $data['is_active'] && (
48:                 StockLevel::query()->where('branch_id', $locked->id)->where('in_transit', '>', 0)->exists()
49:                 || StockTransfer::query()->where('to_branch_id', $locked->id)->where('status', 'shipped')->exists()
50:             )) {
51:                 throw new BusinessException('لا يمكن تعطيل الفرع قبل استلام التحويلات المشحونة إليه.');
52:             }
53:             // M-12: وردية POS مفتوحة أو خزينة بها رصيد — موظفو الفرع المعطّل
54:             // ممنوعون من أي وصول (fail-closed) فلن يستطيعوا إغلاقها بعده.
55:             if (array_key_exists('is_active', $data) && ! $data['is_active']) {
56:                 if (PosShift::query()->where('branch_id', $locked->id)->where('status', PosShiftStatus::Open->value)->exists()) {
57:                     throw new BusinessException('لا يمكن تعطيل الفرع وبه وردية POS مفتوحة؛ أغلقها أولًا.');
58:                 }
59:                 if (Treasury::query()->where('branch_id', $locked->id)->where('current_balance', '!=', 0)->exists()) {
60:                     throw new BusinessException('لا يمكن تعطيل الفرع وخزائنه بها أرصدة؛ صفّرها أولًا.');
61:                 }
62:             }
63:             // branch.deactivated is recorded only on a real true -> false transition.
64:             $wasActive = (bool) $locked->is_active;
65:             // Changing a branch into a warehouse while POS shifts are open is
66:             // rejected: open shifts cannot be closed from a deactivated branch.
67:             if (array_key_exists('type', $data) && (string) $locked->type->value === 'branch'
68:                 && (string) ($data['type'] instanceof \App\Enums\BranchType ? $data['type']->value : $data['type']) === 'warehouse'
69:                 && PosShift::query()->where('branch_id', $locked->id)->where('status', PosShiftStatus::Open->value)->exists()) {
70:                 throw new BusinessException('لا يمكن تحويل الفرع إلى مخزن وبه وردية POS مفتوحة؛ أغلقها أولًا.');
71:             }
72:             $locked->update($data);
73:             $deactivated = array_key_exists('is_active', $data) && ! (bool) $data['is_active'] && $wasActive;
74:             $action = $deactivated ? 'branch.deactivated' : 'branch.updated';
75:             StaffAdministration::audit($actor, $action, 'branch', $locked->id, array_keys($data), $before, StaffAdministration::branchState($locked), $via);
76:         });
77: 
78:         return $branch->refresh();
79:     }
80: }
</file>

<file path="bags-platform/backend/app/Actions/Staff/CreateStaffUser.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Actions\Staff;
 6: 
 7: use App\Enums\StaffRole;
 8: use App\Models\Branch;
 9: use App\Models\User;
10: use App\Services\BranchAccess;
11: use App\Services\StaffAdministration;
12: use Illuminate\Support\Arr;
13: use Illuminate\Support\Facades\DB;
14: use Illuminate\Support\Facades\Hash;
15: use Illuminate\Support\Str;
16: 
17: final class CreateStaffUser
18: {
19:     public function __construct(private BranchAccess $branches) {}
20: 
21:     /** @param array<string,mixed> $validated @param array<string,mixed> $via @return array{user:User,plain_password:?string} */
22:     public function __invoke(User $actor, array $validated, array $via = [], bool $generatePassword = false): array
23:     {
24:         $roles = $validated['roles'] ?? [];
25:         $branch = $this->branches->restrictedBranch($actor);
26:         abort_if($branch !== null && (int) ($validated['branch_id'] ?? 0) !== $branch, 403);
27:         // M4: منع تعيين موظف جديد على فرع معطّل.
28:         $targetBranchId = (int) ($validated['branch_id'] ?? 0);
29:         if ($targetBranchId > 0) {
30:             abort_unless((bool) (Branch::query()->find($targetBranchId)?->is_active), 422, 'لا يمكن تعيين موظف على فرع متوقف.');
31:         }
32:         if (in_array(StaffRole::SuperAdmin->value, $roles, true) && ! $actor->hasRole(StaffRole::SuperAdmin->value, 'staff')) {
33:             abort(403, 'يجب أن تكون Super Admin لإسناد هذا الدور.');
34:         }
35:         abort_unless(StaffAdministration::mayManageUser($actor, roles: $roles), 403, 'لا يمكنك إدارة حساب أو إسناد دور يمتلك صلاحيات لا تملكها.');
36:         $plain = null;
37:         $attrs = Arr::except($validated, ['roles']);
38:         $attrs['is_active'] ??= true;
39:         if ($generatePassword) {
40:             $plain = Str::password(16);
41:             $attrs['password'] = $plain;
42:             // L8: المؤقتة المولّدة يجب تدويرها في أول دخول.
43:             $attrs['must_change_password'] = true;
44:         }
45:         $attrs['password'] = Hash::make($attrs['password']);
46:         $user = DB::transaction(function () use ($attrs, $roles, $actor, $via): User {
47:             StaffAdministration::lock();
48:             StaffAdministration::authorize($actor, ['users.create', 'users.manage']);
49:             $branch = $this->branches->restrictedBranch($actor);
50:             abort_if($branch !== null && (int) ($attrs['branch_id'] ?? 0) !== $branch, 403);
51:             StaffAdministration::lockRoles($roles);
52:             abort_unless(StaffAdministration::mayManageUser($actor, roles: $roles), 403);
53:             // M-14: الفحص عند الاقتراح قد يسبق التأكيد بدقائق — أعد تشغيل
54:             // قاعدة تفرد البريد (داخل users وعبر أنواع الحسابات) تحت القفل.
55:             \Illuminate\Support\Facades\Validator::make(
56:                 ['email' => $attrs['email'] ?? null],
57:                 ['email' => ['required', 'email', 'max:255', \Illuminate\Validation\Rule::unique('users', 'email'), new \App\Rules\EmailNotUsedByOtherAccountType('users')]]
58:             )->validate();
59:             try {
60:                 $user = User::create($attrs);
61:             } catch (\Illuminate\Database\UniqueConstraintViolationException $e) {
62:                 throw \Illuminate\Validation\ValidationException::withMessages([
63:                     'email' => 'هذا البريد مستخدم بحساب آخر في النظام.',
64:                 ]);
65:             }
66:             $user->syncRoles($roles);
67:             StaffAdministration::audit($actor, 'user.created', 'user', $user->id, array_keys($attrs + ['roles' => $roles]), [], StaffAdministration::userState($user), $via);
68: 
69:             return $user;
70:         });
71: 
72:         return ['user' => $user, 'plain_password' => $plain];
73:     }
74: }
</file>

<file path="bags-platform/backend/app/Actions/Staff/UpdateStaffUser.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Actions\Staff;
  6: 
  7: use App\Enums\StaffRole;
  8: use App\Models\Branch;
  9: use App\Models\User;
 10: use App\Rules\EmailNotUsedByOtherAccountType;
 11: use App\Services\BranchAccess;
 12: use App\Services\StaffAdministration;
 13: use Illuminate\Support\Arr;
 14: use Illuminate\Support\Facades\DB;
 15: use Illuminate\Support\Facades\Validator;
 16: use Illuminate\Validation\Rule;
 17: use Illuminate\Validation\ValidationException;
 18: 
 19: final class UpdateStaffUser
 20: {
 21:     public function __construct(private BranchAccess $branches) {}
 22: 
 23:     /**
 24:      * Credentials are validated and hashed by the REST caller; AI may never supply them.
 25:      *
 26:      * L8: $selfRotation allows a password-only self change (verified current
 27:      * password) without users.update — otherwise a freshly created staff
 28:      * member could never clear must_change_password.
 29:      */
 30:     public function __invoke(User $actor, User $target, array $validated, array $via = [], ?string $verifiedPasswordHash = null, bool $selfRotation = false): ?string
 31:     {
 32:         abort_if($target->is_system, 404);
 33:         if (($via['channel'] ?? null) === 'ai') {
 34:             abort_if(array_intersect(array_keys($validated), ['email', 'password', 'current_password']) !== [] || $actor->is($target), 403);
 35:         }
 36:         abort_if($actor->is($target) && (array_key_exists('roles', $validated) || array_key_exists('is_active', $validated)), 403, 'لا يمكنك تغيير أدوارك أو حالة تنشيط حسابك الحالي.');
 37:         $user = $target;
 38:         $currentUser = $actor;
 39:         $roles = $validated['roles'] ?? null;
 40:         $userAttributes = Arr::except($validated, ['roles', 'current_password', 'expected_version']);
 41:         $isSuperAdminRequester = $actor->hasRole(StaffRole::SuperAdmin->value, 'staff');
 42:         $assigningSuperAdmin = is_array($roles) && in_array(StaffRole::SuperAdmin->value, $roles, true);
 43: 
 44:         return DB::transaction(function () use (
 45:             $user,
 46:             $userAttributes,
 47:             $roles,
 48:             $currentUser,
 49:             $isSuperAdminRequester,
 50:             $assigningSuperAdmin,
 51:             $validated,
 52:             $verifiedPasswordHash, $via, $selfRotation,
 53:         ): ?string {
 54:             StaffAdministration::lock();
 55:             if (! $selfRotation) {
 56:                 StaffAdministration::authorize($currentUser, ['users.update', 'users.manage']);
 57:             } else {
 58:                 // Rotation-only: actor must be active and operating on self.
 59:                 abort_unless($currentUser->is_active && ! $currentUser->is_system && $currentUser->is($user), 403);
 60:                 // Rotation-only payloads change nothing but the password.
 61:                 abort_if($roles !== null || array_diff(array_keys($userAttributes), ['password', 'must_change_password']) !== [], 403);
 62:             }
 63:             $isSuperAdminRequester = $currentUser->hasRole(StaffRole::SuperAdmin->value, 'staff');
 64:             $lockedUser = User::query()->whereKey($user->getKey())->lockForUpdate()->firstOrFail();
 65:             abort_if($lockedUser->is_system, 404);
 66:             $branch = $this->branches->restrictedBranch($currentUser);
 67:             abort_if($branch !== null && (int) $lockedUser->branch_id !== $branch, 403);
 68:             StaffAdministration::assertVersion($lockedUser, isset($validated['expected_version']) ? (int) $validated['expected_version'] : null);
 69:             $before = StaffAdministration::userState($lockedUser);
 70:             $ownCredentialsChanged = $currentUser->is($lockedUser) && (isset($userAttributes['password'])
 71:                 || (isset($userAttributes['email']) && $userAttributes['email'] !== $lockedUser->email));
 72:             if ($ownCredentialsChanged && ($verifiedPasswordHash === null
 73:                 || ! hash_equals($lockedUser->password, $verifiedPasswordHash))) {
 74:                 throw ValidationException::withMessages(['current_password' => 'أدخل كلمة المرور الحالية الصحيحة لتغيير بيانات الدخول.']);
 75:             }
 76:             if (array_key_exists('branch_id', $userAttributes)) {
 77:                 $branch = $this->branches->restrictedBranch($currentUser);
 78:                 abort_if($branch !== null && (int) ($userAttributes['branch_id'] ?? 0) !== $branch, 403);
 79:                 // M4: نقل موظف لفرع معطّل مرفوض.
 80:                 $newBranchId = (int) ($userAttributes['branch_id'] ?? 0);
 81:                 if ($newBranchId > 0 && $newBranchId !== (int) $lockedUser->branch_id) {
 82:                     abort_unless((bool) (Branch::query()->find($newBranchId)?->is_active), 422, 'لا يمكن تعيين موظف على فرع متوقف.');
 83:                 }
 84:             }
 85:             if ($roles !== null) {
 86:                 StaffAdministration::lockRoles($roles);
 87:             }
 88:             $targetIsSuperAdmin = $lockedUser->hasRole(StaffRole::SuperAdmin->value, 'staff');
 89: 
 90:             if ($targetIsSuperAdmin && (
 91:                 (array_key_exists('is_active', $userAttributes) && ! (bool) $userAttributes['is_active'])
 92:                 || ($roles !== null && ! in_array(StaffRole::SuperAdmin->value, $roles, true))
 93:             )) {
 94:                 if (! $isSuperAdminRequester || ! StaffAdministration::hasOtherActiveSuperAdmin($lockedUser)) {
 95:                     return 'protected_super_admin';
 96:                 }
 97:             }
 98: 
 99:             if (! $isSuperAdminRequester && (
100:                 $targetIsSuperAdmin || $assigningSuperAdmin
101:             )) {
102:                 return 'protected';
103:             }
104: 
105:             if (! StaffAdministration::mayManageUser($currentUser, $lockedUser, $roles ?? [])) {
106:                 return 'insufficient_permissions';
107:             }
108: 
109:             $emailChanged = isset($userAttributes['email']) && $userAttributes['email'] !== $lockedUser->email;
110:             if ($emailChanged) {
111:                 Validator::make(
112:                     ['email' => $userAttributes['email']],
113:                     ['email' => ['required', 'email', 'max:255', Rule::unique('users', 'email')->ignore($lockedUser->id), new EmailNotUsedByOtherAccountType('users')]]
114:                 )->validate();
115:             }
116:             $passwordChanged = array_key_exists('password', $userAttributes);
117:             if ($passwordChanged) {
118:                 // L8: تدوير ذاتي يُسقط الإجبار؛ تعيين إداري لكلمة سر موظف
119:                 // آخر يُشغّله (لم يخترها بنفسه).
120:                 $userAttributes['must_change_password'] = ! $currentUser->is($lockedUser);
121:             }
122:             $lockedUser->update($userAttributes);
123: 
124:             $rolesChanged = false;
125:             if ($roles !== null) {
126:                 $requestedRoles = $roles;
127:                 sort($requestedRoles);
128:                 $currentRoles = $before['roles'];
129:                 sort($currentRoles);
130:                 $rolesChanged = $requestedRoles !== $currentRoles;
131:                 if ($rolesChanged) {
132:                     $lockedUser->syncRoles($roles);
133:                 }
134:             }
135:             if ($rolesChanged && ! $lockedUser->wasChanged('lock_version')) {
136:                 // Roles live on the pivot table: a roles-only change issues no
137:                 // users-row UPDATE, so TracksEditVersion never fires. Force the
138:                 // bump to keep the optimistic-concurrency contract (version+1
139:                 // per update) that the API and the AI expected_versions rely on.
140:                 StaffAdministration::advanceVersion($lockedUser);
141:             }
142: 
143:             $deactivated = array_key_exists('is_active', $userAttributes)
144:                 && ! (bool) $userAttributes['is_active'];
145: 
146:             StaffAdministration::audit($currentUser, 'user.updated', 'user', $lockedUser->id, array_keys($userAttributes + ($roles !== null ? ['roles' => $roles] : [])), $before, StaffAdministration::userState($lockedUser), $via);
147: 
148:             if ($passwordChanged || $emailChanged || $deactivated || $rolesChanged) {
149:                 // Self password rotation keeps the current session alive so the
150:                 // user is not logged out right after clearing must_change_password.
151:                 $keepTokenId = $selfRotation ? ($via['current_token_id'] ?? null) : null;
152:                 if ($keepTokenId !== null) {
153:                     $lockedUser->tokens()->whereKeyNot($keepTokenId)->delete();
154:                 } else {
155:                     $lockedUser->tokens()->delete();
156:                 }
157:             }
158: 
159:             return null;
160:         });
161:     }
162: }
</file>

<file path="bags-platform/backend/app/Console/Commands/PruneCustomerArtifacts.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Console\Commands;
  6: 
  7: use App\Models\Customer;
  8: use Illuminate\Console\Command;
  9: use Illuminate\Support\Facades\DB;
 10: use Illuminate\Support\Facades\Storage;
 11: use Throwable;
 12: 
 13: class PruneCustomerArtifacts extends Command
 14: {
 15:     protected $signature = 'customers:prune-artifacts';
 16: 
 17:     protected $description = 'Remove abandoned private staging files, expired phone challenges and old message counters';
 18: 
 19:     public function handle(): int
 20:     {
 21:         $failures = 0;
 22:         $disk = Storage::disk('r2');
 23: 
 24:         // M11: isolate each stage — an R2 exception in the storage sweep must
 25:         // not cancel the DB cleanups below. Customer existence is resolved in
 26:         // batches of 500 instead of one exists() per directory.
 27:         try {
 28:             foreach ($disk->directories('customer_documents/pending') as $directory) {
 29:                 if (! preg_match('~^customer_documents/pending/[a-f0-9-]{36}$~D', $directory)) {
 30:                     continue;
 31:                 }
 32:                 try {
 33:                     $newest = 0;
 34:                     foreach ($disk->allFiles($directory) as $file) {
 35:                         $newest = max($newest, $disk->lastModified($file));
 36:                     }
 37:                     if ($newest < now()->subHour()->timestamp) {
 38:                         $disk->deleteDirectory($directory);
 39:                     }
 40:                 } catch (Throwable $exception) {
 41:                     $failures++;
 42:                     report($exception);
 43:                     $this->error('Could not process '.$directory.'; rerun after checking storage access.');
 44:                 }
 45:             }
 46:         } catch (Throwable $exception) {
 47:             $failures++;
 48:             report($exception);
 49:             $this->error('Pending customer documents listing failed: '.$exception->getMessage());
 50:         }
 51: 
 52:         try {
 53:             $candidateIds = [];
 54:             $dirById = [];
 55:             foreach ($disk->directories('customer_documents') as $directory) {
 56:                 if (preg_match('~^customer_documents/([0-9]+)$~D', $directory, $matches)) {
 57:                     $candidateIds[] = (int) $matches[1];
 58:                     $dirById[(int) $matches[1]] = $directory;
 59:                 }
 60:             }
 61:             $existing = [];
 62:             foreach (array_chunk(array_values(array_unique($candidateIds)), 500) as $chunk) {
 63:                 foreach (Customer::withTrashed()->whereIn('id', $chunk)->pluck('id') as $id) {
 64:                     $existing[(int) $id] = true;
 65:                 }
 66:             }
 67:             foreach ($dirById as $customerId => $directory) {
 68:                 if (isset($existing[$customerId])) {
 69:                     continue;
 70:                 }
 71:                 try {
 72:                     $newest = 0;
 73:                     foreach ($disk->allFiles($directory) as $file) {
 74:                         $newest = max($newest, $disk->lastModified($file));
 75:                     }
 76:                     if ($newest < now()->subHour()->timestamp) {
 77:                         $disk->deleteDirectory($directory);
 78:                     }
 79:                 } catch (Throwable $exception) {
 80:                     $failures++;
 81:                     report($exception);
 82:                     $this->error('Could not process '.$directory.'; rerun after checking storage access.');
 83:                 }
 84:             }
 85:         } catch (Throwable $exception) {
 86:             $failures++;
 87:             report($exception);
 88:             $this->error('Customer documents listing failed: '.$exception->getMessage());
 89:         }
 90: 
 91:         try {
 92:             DB::table('customer_phone_verifications')->where('expires_at', '<', now()->subHour())->delete();
 93:             DB::table('customer_message_budgets')->where('date', '<', now()->subDays(30)->toDateString())->delete();
 94:             DB::table('customer_audit_logs')->whereIn('action', ['login_failed', 'login_succeeded', 'token_issued'])
 95:                 ->where('created_at', '<', now()->subDays(90))
 96:                 ->select('id')->chunkById(1000, function ($rows): void {
 97:                     DB::table('customer_audit_logs')->whereIn('id', $rows->pluck('id'))->delete();
 98:                 });
 99:         } catch (Throwable $exception) {
100:             $failures++;
101:             report($exception);
102:             $this->error('Customer database artifact cleanup failed: '.$exception->getMessage());
103:         }
104: 
105:         $this->info('Expired customer artifacts pruned.');
106: 
107:         return $failures === 0 ? self::SUCCESS : self::FAILURE;
108:     }
109: }
</file>

<file path="bags-platform/backend/app/Services/Ai/GeminiClient.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Services\Ai;
  6: 
  7: use Illuminate\Http\Client\ConnectionException;
  8: use Illuminate\Http\UploadedFile;
  9: use Illuminate\Support\Facades\Http;
 10: use InvalidArgumentException;
 11: use LogicException;
 12: 
 13: class GeminiClient
 14: {
 15:     /**
 16:      * @param  list<UploadedFile>  $images
 17:      * @return array{text: string, model: string, usage: array{input_tokens: int, output_tokens: int, total_tokens: int}}
 18:      */
 19:     public function generate(string $prompt, array $images = [], ?string $system = null, ?string $model = null): array
 20:     {
 21:         $key = (string) config('services.gemini.api_key');
 22:         $model ??= config('services.gemini.model');
 23:         if ($key === '' || ! is_string($model) || ! preg_match('/^[a-zA-Z0-9._-]+$/', $model)) {
 24:             throw new LogicException('إعدادات Gemini غير مكتملة.');
 25:         }
 26:         if (trim($prompt) === '') {
 27:             throw new InvalidArgumentException('نص الطلب مطلوب.');
 28:         }
 29:         if (count($images) > config('services.gemini.max_images', 5)) {
 30:             throw new InvalidArgumentException('الحد الأقصى 5 صور في الطلب.');
 31:         }
 32: 
 33:         $parts = [['text' => $prompt]];
 34:         foreach ($images as $image) {
 35:             if (! $image instanceof UploadedFile || ! $image->isValid()
 36:                 || ! in_array($image->getMimeType(), ['image/jpeg', 'image/png', 'image/webp'], true)
 37:                 || $image->getSize() > config('services.gemini.max_image_bytes', 4 * 1024 * 1024)) {
 38:                 throw new InvalidArgumentException('الصورة يجب أن تكون JPG أو PNG أو WebP وبحد أقصى 4MB.');
 39:             }
 40:             $parts[] = ['inlineData' => ['mimeType' => $image->getMimeType(), 'data' => base64_encode($image->getContent())]];
 41:         }
 42: 
 43:         $payload = [
 44:             'contents' => [['role' => 'user', 'parts' => $parts]],
 45:             'generationConfig' => [
 46:                 'temperature' => 0.4,
 47:                 'maxOutputTokens' => (int) config('services.gemini.max_output_tokens', 2048),
 48:             ],
 49:         ];
 50:         if ($system !== null && trim($system) !== '') {
 51:             $payload['systemInstruction'] = ['parts' => [['text' => $system]]];
 52:         }
 53: 
 54:         for ($attempt = 0; $attempt < 2; $attempt++) {
 55:             try {
 56:                 $response = Http::acceptJson()->asJson()->withHeaders(['x-goog-api-key' => $key])
 57:                     ->withOptions(['verify' => config('services.integrations.ca_bundle') ?: true])
 58:                     ->connectTimeout(5)->timeout(max(1, (int) config('services.gemini.timeout_seconds', 20)))
 59:                     ->post('https://generativelanguage.googleapis.com/v1beta/models/'.rawurlencode($model).':generateContent', $payload);
 60:             } catch (ConnectionException) {
 61:                 if ($attempt === 0) {
 62:                     // L-10: إعادة المحاولة بعد timeout قد تُحاسَب مرتين لدى
 63:                     // المزود — تُسجَّل هنا بدل الصمت.
 64:                     logger()->warning('gemini.request_retry', ['method' => 'generate', 'reason' => 'connection_timeout']);
 65: 
 66:                     continue;
 67:                 }
 68:                 throw new GeminiException('تعذّر الاتصال بخدمة Gemini.');
 69:             }
 70:             if (($response->status() === 429 || $response->serverError()) && $attempt === 0) {
 71:                 logger()->warning('gemini.request_retry', ['method' => 'generate', 'reason' => 'http_'.$response->status()]);
 72:                 usleep(250000);
 73: 
 74:                 continue;
 75:             }
 76:             if (! $response->successful()) {
 77:                 throw new GeminiException('تعذّر تنفيذ طلب Gemini.', $response->status());
 78:             }
 79: 
 80:             $candidate = $response->json('candidates.0', []);
 81:             if (($candidate['finishReason'] ?? null) !== 'STOP') {
 82:                 throw new GeminiException('لم ترجع خدمة Gemini إجابة مكتملة.');
 83:             }
 84:             $text = collect($candidate['content']['parts'] ?? [])
 85:                 ->reject(fn ($part) => ! empty($part['thought']))
 86:                 ->pluck('text')->filter(fn ($part) => is_string($part))->implode('');
 87:             if (trim($text) === '') {
 88:                 throw new GeminiException('لم ترجع خدمة Gemini إجابة نصية.');
 89:             }
 90: 
 91:             $usage = $response->json('usageMetadata', []);
 92:             $input = (int) ($usage['promptTokenCount'] ?? 0);
 93:             $output = (int) ($usage['candidatesTokenCount'] ?? 0);
 94: 
 95:             return ['text' => trim($text), 'model' => $model, 'usage' => [
 96:                 'input_tokens' => $input, 'output_tokens' => $output,
 97:                 'total_tokens' => (int) ($usage['totalTokenCount'] ?? $input + $output),
 98:             ]];
 99:         }
100: 
101:         throw new GeminiException('تعذّر تنفيذ طلب Gemini.');
102:     }
103: 
104:     /**
105:      * @param  list<array{role:string, parts:list<array<string,mixed>>}>  $contents
106:      * @param  list<array<string,mixed>>  $functionDeclarations
107:      * @return array{parts:list<array<string,mixed>>, text:string, calls:list<array{name:string,args:array<string,mixed>}>, usage:array{input_tokens:int,output_tokens:int,total_tokens:int}, finish:string, model:string}
108:      */
109:     public function converse(array $contents, array $functionDeclarations = [], ?string $system = null, ?string $model = null): array
110:     {
111:         $key = (string) config('services.gemini.api_key');
112:         $model ??= config('services.gemini.model');
113:         if ($key === '' || ! is_string($model) || ! preg_match('/^[a-zA-Z0-9._-]+$/', $model)) {
114:             throw new LogicException('إعدادات Gemini غير مكتملة.');
115:         }
116:         if ($contents === []) {
117:             throw new InvalidArgumentException('محتوى المحادثة مطلوب.');
118:         }
119:         // Associative JSON decoding loses the distinction between {} and [].
120:         // Gemini requires these fields to remain maps, including after database replay.
121:         foreach ($contents as $turnIndex => $turn) {
122:             foreach ($turn['parts'] as $partIndex => $part) {
123:                 foreach (['functionCall' => 'args', 'functionResponse' => 'response'] as $node => $field) {
124:                     if (isset($part[$node][$field]) && is_array($part[$node][$field])) {
125:                         $contents[$turnIndex]['parts'][$partIndex][$node][$field] = (object) $part[$node][$field];
126:                     }
127:                 }
128:             }
129:         }
130:         // M-9: حد الإخراج من الإعدادات (كما في generate) لا مثبتًا — نماذج
131:         // التفكير (Gemini 2.5) تحسب توكنز التفكير ضمنه فتظهر MAX_TOKENS زورًا.
132:         $maxOutputTokens = max(1024, (int) config('services.gemini.max_output_tokens', 2048));
133:         $generationConfig = ['temperature' => 0.2, 'maxOutputTokens' => $maxOutputTokens];
134:         if (is_string($model) && preg_match('/^gemini-2\.5/i', $model) === 1) {
135:             $generationConfig['thinkingConfig'] = ['thinkingBudget' => min(1024, (int) ($maxOutputTokens / 4))];
136:         }
137:         $payload = [
138:             'contents' => $contents,
139:             'generationConfig' => $generationConfig,
140:         ];
141:         if ($functionDeclarations) {
142:             $payload['tools'] = [['functionDeclarations' => $functionDeclarations]];
143:             $payload['toolConfig'] = ['functionCallingConfig' => ['mode' => 'AUTO']];
144:         }
145:         if ($system !== null && trim($system) !== '') {
146:             $payload['systemInstruction'] = ['parts' => [['text' => $system]]];
147:         }
148:         for ($attempt = 0; $attempt < 2; $attempt++) {
149:             try {
150:                 $response = Http::acceptJson()->asJson()->withHeaders(['x-goog-api-key' => $key])
151:                     ->withOptions(['verify' => config('services.integrations.ca_bundle') ?: true])
152:                     ->connectTimeout(5)->timeout(max(1, (int) config('services.gemini.timeout_seconds', 20)))
153:                     ->post('https://generativelanguage.googleapis.com/v1beta/models/'.rawurlencode($model).':generateContent', $payload);
154:             } catch (ConnectionException) {
155:                 if ($attempt === 0) {
156:                     // L-10: إعادة المحاولة بعد timeout قد تُحاسَب مرتين لدى
157:                     // المزود — تُسجَّل هنا بدل الصمت.
158:                     logger()->warning('gemini.request_retry', ['method' => 'converse', 'reason' => 'connection_timeout']);
159: 
160:                     continue;
161:                 }
162:                 throw new GeminiException('تعذّر الاتصال بخدمة Gemini.');
163:             }
164:             if (($response->status() === 429 || $response->serverError()) && $attempt === 0) {
165:                 logger()->warning('gemini.request_retry', ['method' => 'converse', 'reason' => 'http_'.$response->status()]);
166:                 usleep(250000);
167: 
168:                 continue;
169:             }
170:             if (! $response->successful()) {
171:                 throw new GeminiException('تعذّر تنفيذ طلب Gemini.', $response->status());
172:             }
173:             $candidate = $response->json('candidates.0', []);
174:             $finish = (string) ($candidate['finishReason'] ?? '');
175:             $usage = $response->json('usageMetadata', []);
176:             // M7: حضّر قياس الاستخدام قبل أي باب خروج — الرد غير المكتمل
177:             // (MAX_TOKENS/SAFETY...) كمان بيكلف توكنز لازم تدخل الميزانية.
178:             $measured = [
179:                 'input_tokens' => (int) ($usage['promptTokenCount'] ?? 0),
180:                 'output_tokens' => (int) ($usage['candidatesTokenCount'] ?? 0),
181:                 'total_tokens' => (int) ($usage['totalTokenCount'] ?? 0),
182:             ];
183:             if ($finish !== 'STOP') {
184:                 throw GeminiException::withUsage('لم ترجع خدمة Gemini إجابة مكتملة.', $measured, $response->status());
185:             }
186:             $parts = $candidate['content']['parts'] ?? [];
187:             if (! is_array($parts)) {
188:                 $parts = [];
189:             }
190:             $text = collect($parts)->reject(fn ($p) => ! empty($p['thought']))->pluck('text')->filter(fn ($p) => is_string($p))->implode('');
191:             $calls = [];
192:             foreach ($parts as $part) {
193:                 if (is_array($part) && isset($part['functionCall']['name'])) {
194:                     $calls[] = ['name' => (string) $part['functionCall']['name'], 'args' => is_array($part['functionCall']['args'] ?? null) ? $part['functionCall']['args'] : []];
195:                     if (isset($part['functionCall']['id']) && is_string($part['functionCall']['id'])) {
196:                         $calls[array_key_last($calls)]['id'] = $part['functionCall']['id'];
197:                     }
198:                 }
199:             }
200:             if (! $calls && trim($text) === '') {
201:                 throw GeminiException::withUsage('لم ترجع خدمة Gemini إجابة مكتملة.', $measured);
202:             }
203:             $input = $measured['input_tokens'];
204:             $output = $measured['output_tokens'];
205:             $output = max($output, $measured['total_tokens'] - $input);
206: 
207:             return ['parts' => $parts, 'text' => trim($text), 'calls' => $calls, 'finish' => $finish, 'model' => $model,
208:                 'usage' => ['input_tokens' => $input, 'output_tokens' => $output, 'total_tokens' => max($measured['total_tokens'], $input + $output)]];
209:         }
210:         throw new GeminiException('تعذّر تنفيذ طلب Gemini.');
211:     }
212: }
</file>

