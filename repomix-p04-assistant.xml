29:             if (StaffRole::isReserved($locked->name)) {
30:                 return 'protected';
31:             }
32:             abort_unless(StaffAdministration::mayGrantPermissions($actor, $locked->permissions()->pluck('name')->all()), 403);
33:             if ($locked->users()->exists()) {
34:                 return 'in_use';
35:             }
36:             StaffAdministration::audit($actor, 'role.deleted', 'role', $locked->id, ['name', 'permissions'], StaffAdministration::roleState($locked), [], $via);
37:             $locked->delete();
38:             StaffAdministration::clearPermissionCacheAfterCommit();
39: 
40:             return 'deleted';
41:         });
42:     }
43: }
