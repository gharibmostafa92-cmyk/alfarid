<file path="bags-platform/frontend/apps/backoffice/src/pages/admin/assistant/api.ts">
 1: import { defaultApiClient as api } from '@alfarid/api-client';
 2: import { parseAgentEvents } from './stream';
 3: const BASE = '/api/v1/admin/ai';
 4: export interface UiBlock { type: string; [k: string]: unknown }
 5: export interface ConvMsg { id: number; role: string; content: string | null; ui_blocks: UiBlock[] | null; created_at: string }
 6: export interface Conv { id: number; user_id: number; is_pinned: boolean; title: string | null; model: string; total_tokens: number; last_message_at: string | null; messages?: ConvMsg[]; pending_actions?: { id: string; status: string; expires_at: string }[] }
 7: export interface AgentSettings { ai_enabled: boolean; ai_daily_token_budget_per_user: number; ai_disabled_tools: string[]; ai_action_ttl_minutes: number; ai_retention_days: number; ai_bulk_max_items: number }
 8: export const assistantApi = {
 9:   list: () => api.get<{ data: Conv[] }>(`${BASE}/conversations`).then(r => r.data.data ?? (r.data as unknown as Conv[])),
10:   listPaginated: (page = 1, q = '', all = false) => api.get<{ data: Conv[]; last_page: number }>(`${BASE}/conversations`, { params: { page, per_page: 20, q, ...(all ? { all: 1 } : {}) } }).then(r => r.data),
11:   pin: (id: number, is_pinned: boolean) => api.patch(`${BASE}/conversations/${id}/pin`, { is_pinned }),
12:   settings: () => api.get<{ data: AgentSettings; tools: string[] }>(`${BASE}/settings`).then(r => r.data),
13:   saveSettings: (data: AgentSettings, expected: AgentSettings) => api.put(`${BASE}/settings`, { ...data, expected }),
14:   usage: (all: boolean) => api.get<{ data: { day: string; input_tokens: number; output_tokens: number }[] }>(`${BASE}/usage`, { params: { ...(all ? { all: 1 } : {}) } }).then(r => r.data.data),
15:   create: () => api.post<{ data: Conv }>(`${BASE}/conversations`).then(r => r.data.data),
16:   show: (id: number) => api.get<{ data: Conv }>(`${BASE}/conversations/${id}`).then(r => r.data.data),
17:   remove: (id: number) => api.delete(`${BASE}/conversations/${id}`),
18:   send: (id: number, body: { text: string; selection?: { entity: string; id: number | string; label?: string }; mentions?: { entity: string; id: number | string }[] }) =>
19:     api.post<{ data: { text: string; ui_blocks: UiBlock[]; message_id: number } }>(`${BASE}/conversations/${id}/messages`, body, { timeout: 600000 }).then(r => r.data.data),
20:   stream: async (id: number, body: { text: string; selection?: { entity: string; id: number | string; label?: string }; mentions?: { entity: string; id: number | string }[] }, onStatus: (message: string) => void) => {
21:     const response = await api.post<string>(`${BASE}/conversations/${id}/stream`, body, {
22:       timeout: 600000, responseType: 'text', headers: { Accept: 'text/event-stream' },
23:       onDownloadProgress: progress => {
24:         const text = (progress.event?.target as XMLHttpRequest | undefined)?.responseText;
25:         if (typeof text !== 'string') return;
26:         const statuses = parseAgentEvents(text).filter(e => e.event === 'status');
27:         const latest = statuses.at(-1)?.data.message;
28:         if (typeof latest === 'string') onStatus(latest);
29:       },
30:     });
31:     const events = parseAgentEvents(response.data);
32:     const failure = events.find(e => e.event === 'error');
33:     if (failure) throw { response: { data: { message: String(failure.data.message) } } };
34:     if (!events.some(e => e.event === 'reply')) throw new Error('المحادثة انقطعت قبل اكتمال الرد.');
35:   },
36:   confirm: (actionId: string, typed_confirmation?: string, selected_items?: string[]) =>
37:     api.post<{ data: { ok: boolean; message: string; result: Record<string, unknown>; ui_block: UiBlock; status: string } }>(`${BASE}/actions/${actionId}/confirm`, { typed_confirmation, selected_items }).then(r => r.data.data),
38:   cancel: (actionId: string) => api.post<{ data: { status: string } }>(`${BASE}/actions/${actionId}/cancel`).then(r => r.data.data),
39:   undo: (actionId: string) => api.post<{ data: { ok: boolean; message: string; status: string } }>(`${BASE}/actions/${actionId}/undo`).then(r => r.data.data),
40:   mentions: (q: string) => api.get<{ data: Record<string, { id: number | string; label: string; meta?: string }[]> }>(`${BASE}/mentions`, { params: { q } }).then(r => r.data.data),
41: };
</file>

