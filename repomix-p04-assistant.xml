13: 
14: class AiConversationController extends Controller
15: {
16:     public function __construct(private readonly BranchAccess $branchAccess) {}
17: 
18:     public function index(Request $request): JsonResponse
19:     {
20:         $actor = $request->user('staff');
21:         $data = $request->validate(['q' => ['nullable', 'string', 'max:100'], 'all' => ['sometimes', 'boolean']]);
22:         $query = AiConversation::query()->withCount('messages')->when(! empty($data['q']), fn ($q) => $q->where('title', 'ilike', \App\Services\SearchTerm::pattern($data['q'])))->orderByDesc('is_pinned')->orderByDesc('last_message_at')->orderByDesc('id');
23:         if ($request->query('all') && $actor->can('ai_agent.logs.view')) {
24:             // M11: عرض محادثات الآخرين بيفضح جداول موظفين وفروع — مين مقيّد بفرع مالوش وصول مركزي.
25:             $this->branchAccess->assertCentralAccess($actor);
26:         } else {
27:             $query->where('user_id', $actor->id);
28:         }
29:         $perPage = min(100, max(1, (int) $request->query('per_page', 15)));
30: 
31:         return response()->json($query->paginate($perPage));
32:     }
33: 
34:     public function store(Request $request): JsonResponse
35:     {
36:         $conv = AiConversation::create(['user_id' => $request->user('staff')->id, 'model' => (string) config('services.gemini.model')]);
37: 
38:         return response()->json(['data' => $conv], 201);
39:     }
40: 
41:     public function show(Request $request, AiConversation $conversation): JsonResponse
42:     {
43:         $this->authorizeView($request, $conversation);
44: 
45:         // L-7: حد أعلى (أحدث 200) — كل رسالة جديدة كانت تعيد تحميل
46:         // المحادثة كاملة بلا حد.
47:         $conversation->load(['messages' => fn ($q) => $q->where('role', '!=', 'tool')->where(fn ($m) => $m->whereNotNull('content')->orWhereNotNull('ui_blocks'))->orderByDesc('id')->limit(200), 'pendingActions' => fn ($q) => $q->select('id', 'conversation_id', 'status', 'expires_at')]);
48:         $conversation->setRelation('messages', $conversation->messages->sortBy('id')->values());
49: 
50:         return response()->json(['data' => $conversation]);
51:     }
52: 
53:     public function destroy(Request $request, AiConversation $conversation): Response
54:     {
55:         abort_unless($conversation->user_id === $request->user('staff')->id, 403);
56:         $conversation->delete();
57: 
58:         return response()->noContent();
59:     }
60: 
61:     public function pin(Request $request, AiConversation $conversation): JsonResponse
62:     {
63:         abort_unless($conversation->user_id === $request->user('staff')->id, 403);
64:         $data = $request->validate(['is_pinned' => ['required', 'boolean']]);
65:         $conversation->forceFill($data)->save();
66: 
67:         return response()->json(['data' => $conversation]);
