<file path="bags-platform/backend/app/Services/CustomerGroupService.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Services;
 6: 
 7: use App\Exceptions\BusinessException;
 8: use App\Models\CustomerGroup;
 9: use Illuminate\Contracts\Pagination\LengthAwarePaginator;
10: use Illuminate\Database\QueryException;
11: use Illuminate\Support\Facades\DB;
12: 
13: /**
14:  * Manages customer groups and their wholesale discount configurations.
15:  */
16: class CustomerGroupService
17: {
18:     /**
19:      * Paginate customer groups with search filtering and active counts.
20:      */
21:     public function paginate(array $filters): LengthAwarePaginator
22:     {
23:         return CustomerGroup::query()
24:             ->withCount('customers')
25:             ->when($filters['search'] ?? null, fn ($q, $v) => $q->where(fn ($search) => $search
26:                 ->whereLike('name', SearchTerm::pattern($v), caseSensitive: false)
27:                 ->orWhereLike('code', SearchTerm::pattern($v), caseSensitive: false)))
28:             ->when(array_key_exists('is_active', $filters) && $filters['is_active'] !== null, fn ($q) => $q->where('is_active', $filters['is_active']))
29:             ->orderBy('name')
30:             ->orderBy('id')
31:             ->paginate($filters['per_page'] ?? 15);
32:     }
33: 
34:     /**
35:      * Create a new customer group record.
36:      */
37:     public function create(array $data): CustomerGroup
38:     {
39:         $data = array_filter($data, fn ($value, $key) => $value !== null || ! in_array($key, ['discount_percentage', 'is_active'], true), ARRAY_FILTER_USE_BOTH);
40: 
41:         return CustomerGroup::query()->create($data);
42:     }
43: 
44:     /**
45:      * Update customer group attributes.
46:      */
47:     public function update(CustomerGroup $group, array $data): CustomerGroup
48:     {
49:         $group->update($data);
50: 
51:         return $group;
52:     }
53: 
54:     /**
55:      * Delete customer group safely under lock, preventing orphaned customer associations.
56:      *
57:      * @throws BusinessException If assigned to customers or price lists
58:      */
59:     public function delete(CustomerGroup $group): void
60:     {
61:         try {
62:             DB::transaction(function () use ($group): void {
63:                 // Lock row before existence check to prevent concurrent customer assignment that would silently lose group via nullOnDelete
64:                 $group = CustomerGroup::query()->lockForUpdate()->findOrFail($group->id);
65: 
66:                 if ($group->customers()->exists()) {
67:                     throw new BusinessException('لا يمكن حذف مجموعة مرتبطة بعملاء؛ انقل العملاء أولًا أو عطّل المجموعة.');
68:                 }
69: 
70:                 if ($group->priceLists()->exists()) {
71:                     throw new BusinessException('لا يمكن حذف مجموعة مرتبطة بقوائم أسعار.');
72:                 }
73: 
74:                 $group->delete();
75:             });
76:         } catch (QueryException $e) {
77:             // Convert foreign key violation (PostgreSQL 23503) into friendly 422 business error
78:             if (($e->errorInfo[0] ?? $e->getCode()) === '23503') {
79:                 throw new BusinessException('لا يمكن حذف مجموعة مرتبطة بعملاء أو قوائم أسعار.');
80:             }
81: 
82:             throw $e;
83:         }
84:     }
85: }
</file>

<file path="bags-platform/docs/plans/gemini-superadmin-agent-chat-plan.md">
  1: # المساعد الإداري الذكي — التنفيذ الحالي
  2: 
  3: هذا المستند يحل محل الخطة القديمة التي كانت تقصر المساعد على Super Admin. المواصفات الأصلية موجودة في `task.txt` بجذر المستودع.
  4: 
  5: ## الهوية والصلاحيات
  6: 
  7: - المساعد يعمل بهوية الموظف الحالي. `ai_agent.use` يتيح المحادثة، وأدوات القراءة تحتاج صلاحية عرض نوع البيانات نفسه.
  8: - التعديل يحتاج `ai_agent.execute` بالإضافة إلى صلاحية العملية الأصلية، مع إعادة التحقق عند التأكيد والتراجع.
  9: - `ai_agent.settings` لإعدادات المساعد في الإدارة المركزية، و`ai_agent.logs.view` لمراجعة محادثات الموظفين واستهلاكهم.
 10: - لا يمكن للمساعد تعديل حساب المنفذ نفسه، أو إعطاء أو إزالة دور Super Admin، أو تعديل الأدوار المحجوزة، أو تغيير بيانات الدخول. حماية آخر Super Admin تبقى مطبقة.
 11: - أنواع الفروع تأتي مباشرة من `BranchType`: `branch` و`warehouse`، وليست `retail` أو`office`.
 12: 
 13: ## التنفيذ
 14: 
 15: - `/assistant` شاشة RTL داخل Vortix، تتضمن بحث المحادثات وتثبيتها وحذفها، Markdown بدون HTML أو صور خارجية، ومنشن `@` للموظفين و`#` للفروع و`!` للأدوار، وأوامر سريعة عبر `/`.
 16: - `GeminiClient::generate()` يحتفظ بعقده السابق. `converse()` يدعم function calling، ويحفظ الأجزاء الأصلية والتوقيعات، ويقبل استدعاءات الأدوات بدون نص.
 17: - `AgentOrchestrator` يحتفظ بأزواج الاستدعاء والنتيجة، ويحد السياق الحديث مع مقتطفات من الأقدم. سقف الحلقة ست خطوات، مع قفل لكل مستخدم وفحص الميزانية في كل خطوة.
 18: - جميع تعديلات الموظفين والأدوار والفروع ومواقع التخزين والإعدادات تمر عبر `Actions` مشتركة مع REST. تجهيز الاقتراح لا يغير الكيان المستهدف.
 19: - `ai_pending_actions` يحفظ المعاملات وHMAC والإصدارات والمعاينة. التأكيد يستخدم النسخة المخزنة تحت قفل، ويمنع إعادة التنفيذ. إلغاء العملية يسجل حدثاً في المحادثة.
 20: - التراجع متاح 15 دقيقة لتعديل حالة الفرع أو الموظف أو موقع التخزين، وصلاحيات الدور، وأدوار الموظف. يتحقق من بصمة الحالة بعد التنفيذ قبل استعادة القيم السابقة. الإنشاء والحذف وإلغاء الجلسات وتعديل الإعدادات لا تعرض تراجعاً آلياً.
 21: - `bulk_actions` يجمع اقتراحات محدودة بـ`ai_bulk_max_items`. يستطيع المستخدم استبعاد عناصر. لكل عنصر معاملة مستقلة ونتيجة مستقلة؛ فشل عنصر لا يلغي نجاح الباقي.
 22: - كلمة المرور المولدة عند إنشاء موظف تظهر في استجابة التأكيد مرة واحدة فقط، ولا تحفظ في سجل المحادثة أو نتيجة الإجراء أو ترسل إلى Gemini.
 23: - النتائج والرفض تسجل في `staff_audit_logs`، مع `via.channel=ai` ومعرفي المحادثة والإجراء عند التنفيذ.
 24: - تنظيف المحادثات يومي الساعة 05:10 بتوقيت العمل. الحذف بعد فترة الاحتفاظ فعلي ويشمل الرسائل والإجراءات التابعة والمحادثات المحذوفة من الواجهة.
 25: 
 26: ## API
 27: 
 28: كل المسارات التالية تحت `/api/v1/admin/ai` وتحتاج جلسة موظف و`ai_agent.use`:
 29: 
 30: | المسار | الوظيفة |
 31: | --- | --- |
 32: | GET/POST `conversations` | القائمة والإنشاء؛ `q` للبحث و`all=1` للمراجعين |
 33: | GET/DELETE `conversations/{conversation}` | العرض أو الحذف؛ حذف محادثتك فقط |
 34: | PATCH `conversations/{conversation}/pin` | تثبيت محادثتك عبر `is_pinned` |
 35: | POST `conversations/{conversation}/messages` | إرسال رسالة JSON |
 36: | POST `conversations/{conversation}/stream` | إرسال رسالة مع SSE: `status` ثم `reply` أو `error` |
 37: | POST `actions/{action}/confirm` | التأكيد؛ `typed_confirmation` و`selected_items` للمجموعة |
 38: | POST `actions/{action}/cancel` | الإلغاء |
 39: | POST `actions/{action}/undo` | التراجع |
 40: | GET `mentions` | مراجع حقيقية مقيدة بصلاحيات العرض والنطاق |
 41: | GET `usage` | استهلاك آخر 30 يوماً؛ `all=1` للمراجعين |
 42: | GET/PUT `settings` | إعدادات المساعد بصلاحية `ai_agent.settings` والوصول المركزي |
 43: 
 44: نتائج الأدوات وأجزاء المزود الداخلية لا تظهر كرسائل للمستخدم. مراجع الاختيارات والمنشن تعاد مطابقتها على السيرفر، وبيانات الموظفين في القراءة تعرض البريد بشكل مقنع.
 45: 
 46: ## أدوات المساعد
 47: 
 48: ### الأدوات الأصلية (P02)
 49: | الأداة | النوع | الوصف |
 50: | --- | --- | --- |
 51: | `find_entities` | قراءة | بحث عن فروع أو موظفين أو أدوار أو صلاحيات أو مواقع تخزين |
 52: | `list_branches` | قراءة | قائمة الفروع |
 53: | `list_roles` | قراءة | قائمة الأدوار |
 54: | `list_permissions` | قراءة | كتالوج الصلاحيات |
 55: | `list_staff` | قراءة | قائمة الموظفين |
 56: | `explain_user_access` | قراءة | شرح أدوار وصلاحيات موظف |
 57: | `who_can` | قراءة | مين معاه صلاحية معينة |
 58: | `compare_roles` | قراءة | مقارنة صلاحيات دورين |
 59: | `recent_audit` | قراءة | آخر أحداث سجل التدقيق |
 60: | `ask_user_to_choose` | واجهة | اختيار كيان من قائمة |
 61: | `create_branch` | كتابة | إنشاء فرع |
 62: | `set_branch_status` | كتابة | تفعيل/تعطيل فرع |
 63: | `create_role` | كتابة | إنشاء دور |
 64: | `update_role_permissions` | كتابة | تعديل صلاحيات دور |
 65: | `delete_role` | كتابة | حذف دور |
 66: | `create_staff_user` | كتابة | إنشاء موظف |
 67: | `set_user_status` | كتابة | تفعيل/تعطيل موظف |
 68: | `assign_roles` | كتابة | تعديل أدوار موظف |
 69: | `revoke_user_sessions` | كتابة | تسجيل خروج موظف |
 70: | `bulk_actions` | كتابة | مجموعة تعديلات مستقلة |
 71: 
 72: ### أدوات P03 — المؤسسة والإدارة
 73: | الأداة | النوع | الوصف |
 74: | --- | --- | --- |
 75: | `list_locations` | قراءة | عرض مواقع التخزين في فرع |
 76: | `create_location` | كتابة | إنشاء موقع تخزين |
 77: | `set_location_status` | كتابة | تفعيل/تعطيل موقع (يدعم التراجع) |
 78: | `delete_location` | كتابة | حذف موقع (يرفض لو فيه أرصدة أو حركات) |
 79: | `view_settings` | قراءة | عرض إعدادات المؤسسة بالمجموعات |
 80: | `view_document_numbering` | قراءة | عرض بادئات المستندات وعدّاداتها (16 نوع) |
 81: | `update_settings` | كتابة | تعديل إعدادات (هوية، ضرائب، سياسات) |
 82: | `update_document_numbering` | كتابة | تعديل بادئة/عداد/طول ترقيم مستند |
 83: 
 84: ## التشغيل والتحقق
 85: 
 86: طبّق migrations المساعد، ثم شغّل:
 87: 
 88: ```sh
 89: php artisan db:seed --class=AiAgentPermissionSeeder
 90: php artisan db:seed --class=SettingSeeder
 91: ```
 92: 
 93: الـseeder الأول يضيف صلاحيات المساعد ويمنحها لدور Super Admin الموجود، دون إعادة مزامنة بقية صلاحيات الأدوار. الـseeder الثاني يضيف الإعدادات الناقصة فقط.
 94: 
 95: اضبط `GEMINI_API_KEY` و`GEMINI_MODEL`، ثم فعّل المساعد من «الاستهلاك والإعدادات». الإعداد الافتراضي `ai_enabled=false`. شغّل Laravel scheduler في بيئة الاستضافة لتنفيذ التنظيف.
 96: 
 97: ```sh
 98: php artisan test --compact --filter=AiAgentTest
 99: php artisan test --compact --filter=GeminiClientTest
100: php artisan ai:evaluate --check
101: # تقييم حي دون تنفيذ أي أدوات أو تعديل بيانات التطبيق:
102: php artisan ai:evaluate --actor=STAFF_ID --min-accuracy=0.85
103: ```
104: 
105: من مجلد `frontend`:
106: 
107: ```sh
108: pnpm --filter @alfarid/backoffice build
109: node --test tests/assistant.test.cjs
110: node tests/assistant.e2e.cjs
111: ```
112: 
113: اختبار المتصفح يستخدم استجابات API معزولة، ويغطي Vortix والتأكيد والمنشن والعمليات الجماعية والأخطاء والإعدادات والسجلات وأربع مقاسات شاشة.
114: 
115: يتضمن `tests/Fixtures/ai-agent-egyptian.json` ستين حالة بالمصري. Workflow التقييم يتحقق من البيانات في PR، ويشغّل التقييم الحي على `main` أو يدوياً؛ يحتاج secret باسم `GEMINI_API_KEY` وvariable باسم `GEMINI_MODEL` أو اختيار الموديل عند التشغيل اليدوي. دقة النموذج الحية لا يمكن استنتاجها من الاختبارات المزيفة.
116: 
117: تم التحقق حياً من إعدادات التطوير الحالية: المفتاح الموجود صالح، ومختلف عن المفتاح التاريخي في الـdemo، والموديل المضبوط `gemini-3.1-flash-lite`. نجحت دورة functionCall → functionResponse → رد نصي نهائي ببيانات تجريبية دون تعديل كيانات التطبيق. إذا لم يكن المفتاح التاريخي قد أُلغي من حساب Google بالفعل، فإزالته من الملف وحدها لا تلغيه عند المزود.
118: 
119: التقييم يدعم خطوات البحث الوسيطة (حتى ست خطوات)، ويقارن صلاحيات التعديل المطلوبة بدقة، ولا يستدعي أي Action فعلي. المعدل الافتراضي 10 طلبات للمزود في الدقيقة (`--rpm=10`) لتقليل أخطاء 429. يمكن عزل حالة عبر `--case=egy-7-1`.
120: 
121: ## نتيجة التحقق المحلية — 2026-10-30
122: 
123: - نجح الفحص الشامل للـBackend: 1355 اختباراً و18174 assertion. بعده نجحت مجموعات التغييرات الإضافية: AiAgentTest (26)، وGeminiClientTest (10)، وEntityResolverTest (2)، مع إعادة فحص الموظفين وحمايات الإدارة بعد توحيد Actions.
124: - نجح بناء Backoffice وTypeScript، واختبارات العمليات (39) والجلسات (15) وعقود الإدارة (3) ومحلل SSE. نجح اختبار المتصفح على 320 و768 و1024 و1440، بما يشمل التأكيد، المنشن، العمليات الجماعية، حفظ المسودة عند فشل الطلب، السجلات، التثبيت، وروابط الموظفين ووصول الكاشير المصرح له.
125: - التقييم الحي للموديل gemini-3.1-flash-lite: 58/60 = 96.7%، متجاوزاً حد 85%، دون أخطاء مزود في الدفعة الأخيرة ودون تنفيذ أي تعديلات فعلية. الحالتان غير المطابقتين كانتا صياغة اسم فرع أسوان، واختيار عرض قائمة بدلاً من picker.
126: - فحص التنسيق وgit diff --check ناجحان. migrations وصلاحيات وإعدادات المساعد مطبقة على التطوير المحلي، مع إبقاء ai_enabled=false حسب الافتراضي المحدد.
</file>

