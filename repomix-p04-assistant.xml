 770:     public function lockTargets(AiPendingAction $action): void
 771:     {
 772:         foreach ($action->expected_versions ?? [] as $key => $version) {
 773:             [$type, $id] = explode(':', $key, 2);
 774:             $model = match ($type) {
 775:                 'branch' => Branch::class, 'user' => User::class, 'role' => Role::class, 'location' => Location::class, default => null
 776:             };
 777:             abort_unless($model, 409);
 778:             $record = $model::query()->lockForUpdate()->find($id);
 779:             abort_unless($record, 409, 'السجل اتحذف.');
 780:             if ($action->status === 'pending') {
 781:                 $this->checkVersion($key, $version, $record);
 782:             }
 783:         }
 784:     }
