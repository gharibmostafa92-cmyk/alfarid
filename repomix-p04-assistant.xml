 435:     private function makeProposal(User $actor, AiConversation $conv, string $tool, array $args, array $expected, array $preview, ?array $inverse, string $risk): ToolOutcome
 436:     {
 437:         if (in_array($tool, ['create_staff_user', 'assign_roles', 'set_user_status'], true)) {
 438:             $names = array_merge($args['roles'] ?? [], $tool === 'assign_roles' ? ($args['add'] ?? []) : []);
 439:             if (isset($args['user_id'])) {
 440:                 $names = array_merge($names, User::findOrFail($args['user_id'])->roles()->pluck('name')->all());
 441:             }
 442:             foreach (Role::where('guard_name', 'staff')->whereIn('name', $names)->get() as $role) {
 443:                 $expected['role:'.$role->id] = (int) $role->lock_version;
 444:             }
 445:         }
 446:         $ttl = max(1, (int) $this->settings->get('ai_action_ttl_minutes', 10));
 447:         $action = AiPendingAction::create([
 448:             'conversation_id' => $conv->id, 'user_id' => $actor->id, 'tool' => $tool, 'args' => $args,
 449:             'expected_versions' => $expected, 'preview' => $preview, 'inverse' => $inverse,
 450:             'args_hash' => $this->hashArgs($args), 'risk' => $risk, 'status' => 'pending', 'expires_at' => now()->addMinutes($ttl),
 451:         ]);
 452:         $typed = null;
 453:         if ($tool === 'set_branch_status' && isset($args['branch_id'])) {
 454:             $b = Branch::find($args['branch_id']);
 455:             $typed = $b?->code;
 456:         }
 457:         if ($tool === 'delete_role' && isset($args['role_id'])) {
 458:             $r = Role::find($args['role_id']);
 459:             $typed = $r?->name;
 460:         }
 461:         $block = ['type' => 'confirm_action', 'action_id' => $action->id, 'tool' => $tool, 'risk' => $risk, 'title' => $preview['title'] ?? $tool, 'before' => $preview['before'] ?? null, 'after' => $preview['after'] ?? null, 'warnings' => $preview['warnings'] ?? [], 'expires_at' => $action->expires_at->toIso8601String()];
 462:         if ($risk === 'high' && $typed) {
 463:             $block['typed_confirmation'] = $typed;
 464:         }
 465:         if (isset($preview['permission_diff'])) {
 466:             $block = array_merge($block, ['type' => 'permission_diff'] + $block + $preview['permission_diff']);
 467:         }
 468: 
 469:         return ToolOutcome::proposal($block, ['pending_action_id' => $action->id]);
 470:     }
