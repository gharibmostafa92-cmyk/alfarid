 16: 
 17: final class EvaluateAiAgent extends Command
 18: {
 19:     protected $signature = 'ai:evaluate {--actor= : Staff ID to evaluate permissions for} {--model=} {--case=* : Evaluate selected case IDs} {--rpm=10 : Maximum provider requests per minute during evaluation} {--check : Validate the dataset without contacting Gemini} {--min-accuracy=0.85}';
 20: 
 21:     private float $lastRequestAt = 0;
 22: 
 23:     protected $description = 'Evaluate Egyptian Arabic tool selection without executing tools or changing application data';
 24: 
 25:     public function handle(GeminiClient $gemini, ToolRegistry $registry, AgentOrchestrator $orchestrator): int
 26:     {
 27:         $dataset = json_decode(file_get_contents(base_path('tests/Fixtures/ai-agent-egyptian.json')), true, flags: JSON_THROW_ON_ERROR);
 28:         $definitions = $registry->definitions();
 29:         $ids = [];
 30:         foreach ($dataset['cases'] as $case) {
 31:             if (empty($case['id']) || in_array($case['id'], $ids, true) || ! is_string($case['text']) || ! is_array($case['args']) || ($case['tool'] !== null && ! isset($definitions[$case['tool']]))) {
 32:                 $this->error('Invalid evaluation dataset.');
 33: 
 34:                 return self::FAILURE;
 35:             }
 36:             $ids[] = $case['id'];
 37:         }
 38:         if (count($ids) < 60) {
 39:             $this->error('At least 60 evaluation cases are required.');
 40: 
 41:             return self::FAILURE;
 42:         }
 43:         if ($this->option('check')) {
 44:             $this->info(count($ids).' evaluation cases validated; no provider calls made.');
 45: 
 46:             return self::SUCCESS;
 47:         }
 48:         $cases = $dataset['cases'];
 49:         if ($selected = $this->option('case')) {
 50:             $cases = array_values(array_filter($cases, fn ($case) => in_array($case['id'], $selected, true)));
 51:             if (count($cases) !== count(array_unique($selected))) {
 52:                 $this->error('Unknown case ID.');
 53: 
 54:                 return self::FAILURE;
 55:             }
 56:             $ids = array_column($cases, 'id');
 57:         }
 58:         $minimum = (float) $this->option('min-accuracy');
 59:         if (! ctype_digit((string) $this->option('rpm')) || (int) $this->option('rpm') < 1) {
 60:             $this->error('rpm must be a positive integer.');
 61: 
 62:             return self::FAILURE;
 63:         }
 64:         if ($minimum < 0 || $minimum > 1) {
 65:             $this->error('min-accuracy must be between 0 and 1.');
 66: 
 67:             return self::FAILURE;
 68:         }
 69:         $actor = $this->option('actor') ? User::findOrFail($this->option('actor')) : User::role(StaffRole::SuperAdmin->value, 'staff')->where('is_active', true)->firstOrFail();
 70:         $declarations = $registry->declarationsFor($actor);
 71:         $system = $orchestrator->systemPrompt($actor)."\nبيانات محاكاة مرجعية موثوقة لاختبار اختيار الأدوات. يمكنك طلب أدوات البحث قبل اقتراح التعديل؛ لا تؤكد تنفيذ أي تعديل: ".json_encode($dataset['context'], JSON_UNESCAPED_UNICODE);
 72:         $passed = 0;
 73:         $errors = 0;
 74:         foreach ($cases as $case) {
 75:             try {
 76:                 $observed = [];
 77:                 $match = $this->evaluateCase($gemini, $registry, $declarations, $system, $dataset['context'], $case, $observed);
 78:                 $passed += $match ? 1 : 0;
 79:                 $this->line($case['id'].': '.($match ? 'PASS' : 'FAIL').' ('.implode(' → ', $observed).')');
 80:             } catch (\Throwable $exception) {
 81:                 report($exception);
 82:                 $errors++;
 83:                 $status = $exception instanceof GeminiException ? $exception->providerStatus : null;
 84:                 $this->error($case['id'].': provider request failed'.($status ? ' (HTTP '.$status.')' : '').'.');
 85:             }
 86:         }
 87:         $accuracy = $passed / count($ids);
 88:         $this->info(sprintf('Accuracy: %.1f%% (%d/%d); required %.1f%%', $accuracy * 100, $passed, count($ids), $minimum * 100));
 89:         if ($errors) {
 90:             $this->warn($errors.' cases could not complete because of provider errors.');
 91:         }
 92: 
 93:         return $accuracy >= $minimum ? self::SUCCESS : self::FAILURE;
 94:     }
 95: 
 96:     private function evaluateCase(GeminiClient $gemini, ToolRegistry $registry, array $declarations, string $system, array $context, array $case, array &$observed): bool
 97:     {
 98:         $history = [['role' => 'user', 'parts' => [['text' => $case['text']]]]];
 99:         for ($step = 0; $step < 6; $step++) {
100:             $interval = 60 / (int) $this->option('rpm');
101:             $delay = $interval - (microtime(true) - $this->lastRequestAt);
102:             if ($delay > 0) {
103:                 usleep((int) ($delay * 1000000));
104:             }
105:             $this->lastRequestAt = microtime(true);
106:             $response = $gemini->converse($history, $declarations, $system, $this->option('model') ?: null);
107:             if (! $response['calls']) {
108:                 return $case['tool'] === null;
109:             }
110:             $history[] = ['role' => 'model', 'parts' => $response['parts']];
111:             $responses = [];
112:             $matched = false;
113:             foreach ($response['calls'] as $call) {
114:                 $observed[] = $call['name'];
115:                 $args = $call['args'];
116:                 if ($call['name'] === 'set_branch_status' && ! isset($args['branch_id']) && isset($args['branch_query'])) {
117:                     $results = $this->fixtureResponse($context, ['name' => 'find_entities', 'args' => ['type' => 'branch', 'query' => $args['branch_query']]])['results'];
118:                     if (count($results) === 1) {
119:                         $args['branch_id'] = $results[0]['id'];
120:                     }
121:                 }
122:                 if (in_array($call['name'], ['list_locations', 'create_location']) && ! isset($args['branch_id']) && isset($args['branch_query'])) {
123:                     $results = $this->fixtureResponse($context, ['name' => 'find_entities', 'args' => ['type' => 'branch', 'query' => $args['branch_query']]])['results'];
124:                     if (count($results) === 1) {
125:                         $args['branch_id'] = $results[0]['id'];
126:                     }
127:                 }
128:                 $correct = $call['name'] === $case['tool'] && $this->containsArgs($args, $case['args']);
129:                 // Never call dispatch/execute here. An unexpected write invalidates the case.
130:                 if ($registry->isWrite($call['name']) && ! $correct) {
131:                     return false;
132:                 }
133:                 $matched = $matched || $correct;
134:                 $responses = array_merge($responses, ToolOutcome::data($this->fixtureResponse($context, $call))->asFunctionResponse($call)['parts']);
135:             }
136:             if ($matched) {
137:                 return true;
138:             }
139:             $history[] = ['role' => 'user', 'parts' => $responses];
140:         }
141: 
142:         return false;
143:     }
144: 
145:     private function fixtureResponse(array $context, array $call): array
146:     {
147:         $normalize = fn ($value) => EntityResolver::normalizeForSearch((string) $value);
148:         if ($call['name'] === 'list_permissions' || ($call['name'] === 'find_entities' && ($call['args']['type'] ?? '') === 'permission')) {
149:             return ['permissions' => ['inventory.view', 'inventory.adjust', 'pos.discount', 'products.view_cost', 'inventory.cost']];
150:         }
151:         $key = match ($call['name']) {
152:             'list_branches' => 'branches', 'list_staff' => 'users', 'list_roles' => 'roles',
153:             'find_entities' => match ($call['args']['type'] ?? '') {
154:                 'branch' => 'branches', 'user' => 'users', 'role' => 'roles', 'location' => 'locations', default => ''
155:             },
156:             'list_locations' => 'locations',
157:             default => '',
158:         };
159:         if ($call['name'] === 'view_settings' || $call['name'] === 'update_settings') {
160:             return ['settings' => ['tax_rate' => '15', 'tax_name' => 'ضريبة القيمة المضافة', 'tax_included' => 'true', 'return_window_days' => '14'], 'executed' => $call['name'] === 'update_settings'];
161:         }
162:         if ($call['name'] === 'view_document_numbering' || $call['name'] === 'update_document_numbering') {
163:             $type = $call['args']['type'] ?? 'invoice';
164:             return ['numbering' => ['type' => $type, 'prefix' => 'INV-', 'next_number' => 1, 'padding' => 5], 'executed' => $call['name'] === 'update_document_numbering'];
165:         }
166:         if (in_array($call['name'], ['create_location', 'set_location_status', 'delete_location'])) {
167:             return ['executed' => false, 'message' => 'يحتاج تأكيد'];
168:         }
169:         if (! $key) {
170:             return ['context' => $context, 'executed' => false];
171:         }
172:         $query = $normalize($call['args']['query'] ?? '');
173:         $items = $context[$key] ?? [];
174:         // For locations, filter by branch_id if provided
175:         if ($key === 'locations' && isset($call['args']['branch_id'])) {
176:             $items = array_values(array_filter($items, fn ($item) => ($item['branch_id'] ?? null) === $call['args']['branch_id']));
177:         }
178:         $items = array_values(array_filter($items, fn ($item) => $query === '' || str_contains($normalize($item['name'].' '.($item['code'] ?? '')), $query)));
179:         $items = array_map(fn ($item) => ['id' => $item['id'], 'label' => $item['name'], 'meta' => $item['code'] ?? ''], $items);
180: 
181:         return [$call['name'] === 'find_entities' ? 'results' : $key => $items];
182:     }
183: 
184:     private function containsArgs(array $actual, array $expected): bool
185:     {
186:         foreach ($expected as $key => $value) {
187:             if (! array_key_exists($key, $actual)) {
188:                 return false;
189:             }
190:             if (is_array($value)) {
191:                 if (array_is_list($value)) {
192:                     if (! is_array($actual[$key])) {
193:                         return false;
194:                     }
195:                     $left = $actual[$key];
196:                     $right = $value;
197:                     sort($left);
198:                     sort($right);
199:                     if ($left !== $right) {
200:                         return false;
201:                     }
202: 
203:                     continue;
204:                 }
205:                 if (! is_array($actual[$key]) || ! $this->containsArgs($actual[$key], $value)) {
206:                     return false;
207:                 }
208:             } elseif ($actual[$key] !== $value) {
209:                 return false;
210:             }
211:         }
212: 
213:         return true;
214:     }
215: }
</file>

<file path="bags-platform/backend/app/Console/Commands/NormalizeCustomerPhones.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Console\Commands;
 6: 
 7: use App\Models\Customer;
 8: use App\Models\CustomerAuditLog;
 9: use Illuminate\Console\Command;
10: use Illuminate\Support\Facades\DB;
11: 
12: class NormalizeCustomerPhones extends Command
13: {
14:     protected $signature = 'customers:normalize-phones {--apply : Apply a collision-free normalization plan in batches}';
15: 
16:     protected $description = 'Check legacy Egyptian mobile numbers for normalization collisions before updating them';
17: 
18:     public function handle(): int
19:     {
20:         // Pin the temporary table to one connection under transaction pooling.
21:         return DB::transaction(fn (): int => $this->normalize());
22:     }
23: 
24:     private function normalize(): int
25:     {
26:         DB::statement("CREATE TEMP TABLE customer_phone_normalization ON COMMIT DROP AS
27:             WITH cleaned AS (
28:                 SELECT id, phone AS before, regexp_replace(translate(TRIM(phone),
29:                     '٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹', '01234567890123456789'), '[[:space:]().-]+', '', 'g') AS value
30:                 FROM customers
31:             )
32:             SELECT id, before, CASE
33:                 WHEN before ~ '^legacy-[0-9]+$' THEN before
34:                 WHEN value ~ '^201[0125][0-9]{8}$' THEN '0' || SUBSTRING(value FROM 3)
35:                 WHEN value LIKE '+20%' THEN '0' || SUBSTRING(value FROM 4)
36:                 WHEN value LIKE '0020%' THEN '0' || SUBSTRING(value FROM 5)
37:                 ELSE value END AS after FROM cleaned");
38:         try {
39:             DB::statement('ALTER TABLE customer_phone_normalization ADD PRIMARY KEY (id)');
40:             $plan = DB::table('customer_phone_normalization');
41:             $invalid = (clone $plan)->whereRaw("after !~ '^(01[0125][0-9]{8}|legacy-[0-9]+)$'")->limit(20)->pluck('id')->all();
42:             $collisions = (clone $plan)->selectRaw('after')->groupBy('after')->havingRaw('COUNT(*) > 1')->limit(20)->pluck('after')->all();
43:             if ($invalid !== [] || $collisions !== []) {
44:                 $this->error('Manual repair required. Invalid customer IDs (first 20): '.json_encode($invalid).'; normalized collisions: '.count($collisions));
45: 
46:                 return self::FAILURE;
47:             }
48:             $changes = (clone $plan)->whereColumn('before', '!=', 'after');
49:             $this->info((clone $changes)->count().' phone numbers need normalization.');
50:             if ($this->option('apply')) {
51:                 foreach ($changes->orderBy('id')->lazyById(500)->chunk(500) as $batch) {
52:                     DB::transaction(function () use ($batch): void {
53:                         foreach ($batch as $change) {
54:                             $customer = Customer::withTrashed()->lockForUpdate()->findOrFail($change->id);
55:                             if ($customer->phone !== $change->before) {
56:                                 throw new \RuntimeException('A customer changed during normalization; rerun the preflight.');
57:                             }
58:                             $customer->phone = $change->after;
59:                             $customer->save();
60:                             CustomerAuditLog::record($customer, 'phone_normalized', null);
61:                         }
62:                     });
63:                 }
64:             }
65: 
66:             return self::SUCCESS;
67:         } finally {
68:             DB::statement('DROP TABLE IF EXISTS customer_phone_normalization');
69:         }
70:     }
71: }
</file>

