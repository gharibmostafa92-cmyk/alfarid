118: /* 3. دعم تفضيل النظام الداكن في حال لم يتم تحديد data-theme صراحة */
119: @media (prefers-color-scheme: dark) {
120:   :root:not([data-theme='light']) .assistant:not([data-theme='light']) {
121:     color-scheme: dark;
122:     --as-primary: var(--accent-orange, #e65328);
123:     --as-primary-hover: #ff6838;
124:     --as-primary-soft: var(--accent-orange-light, rgba(230, 83, 40, 0.18));
125:     --as-primary-ring: rgba(230, 83, 40, 0.45);
126:     --as-accent: #f0683d;
127: 
128:     --as-bg: var(--bg-card, #17141a);
129:     --as-surface: var(--bg-card, #17141a);
130:     --as-surface-2: var(--bg-subcard, #1c1920);
131:     --as-surface-3: var(--bg-subcard-hover, #25212a);
132:     --as-border: var(--border-subtle, rgba(255, 255, 255, 0.08));
133:     --as-border-strong: var(--border-field, rgba(255, 255, 255, 0.14));
134: 
135:     --as-text: var(--text-primary, #f5f3f7);
136:     --as-muted: var(--text-secondary, #b0abb8);
137:     --as-faint: var(--text-muted, #8e8896);
138: 
139:     --as-success: #34d399;
140:     --as-success-soft: rgba(6, 78, 59, 0.45);
141:     --as-warning: #fbbf24;
142:     --as-warning-soft: rgba(180, 83, 9, 0.25);
143:     --as-danger: #fb7185;
144:     --as-danger-soft: rgba(136, 19, 55, 0.45);
145:     --as-info: #818cf8;
146:     --as-info-soft: rgba(67, 56, 202, 0.25);
147: 
148:     --as-user-bubble: #26222c;
149:     --as-user-text: #f5f3f7;
150: 
151:     --as-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
152:     --as-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.5);
153:     --as-shadow-lg: 0 20px 48px -10px rgba(0, 0, 0, 0.7);
154:   }
