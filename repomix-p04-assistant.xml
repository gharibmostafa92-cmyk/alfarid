 10: use App\Models\Branch;
 11: use App\Models\User;
 12: use App\Services\SettingService;
 13: use App\Services\StaffAdministration;
 14: use Illuminate\Auth\Access\AuthorizationException;
 15: use Illuminate\Database\Eloquent\ModelNotFoundException;
 16: use Illuminate\Database\QueryException;
 17: use Illuminate\Database\UniqueConstraintViolationException;
 18: use Illuminate\Support\Facades\DB;
 19: use Illuminate\Validation\ValidationException;
 20: use Spatie\Permission\Exceptions\RoleAlreadyExists;
 21: use Spatie\Permission\Models\Role;
