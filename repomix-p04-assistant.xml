106:   const count = slash ? commands.length : options.length;
107:   const onKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
108:     if (popOpen && count > 0) {
109:       if (e.key === 'ArrowDown') { e.preventDefault(); setActive(a => (a + 1) % count); return; }
110:       if (e.key === 'ArrowUp') { e.preventDefault(); setActive(a => (a - 1 + count) % count); return; }
