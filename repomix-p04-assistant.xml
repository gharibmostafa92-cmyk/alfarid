 1: import { signedAttachmentUrl } from '@alfarid/api-client';
 2: 
 3: export const num = (v) => (v === null || v === undefined || v === '' ? null : Number(v));
 4: export const day = (iso) => (iso ? String(iso).slice(0, 10) : null);
 5: export const calendarDay = (date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
 6: export const today = () => calendarDay(new Date());
 7: 
 8: export function apiError(e) {
 9:   const r = e?.response;
10:   return {
11:     status: r?.status,
12:     message: r?.data?.message || 'حصل خطأ غير متوقع، حاول تاني.',
13:     fields: r?.data?.errors || {},
14:     code: r?.data?.code || r?.data?.errors?.code,
15:   };
16: }
17: 
18: export async function saveBlob(promise, fallbackName) {
19:   const res = await promise;
20:   const signedUrl = await signedAttachmentUrl(res);
21:   if (signedUrl) {
22:     const link = document.createElement('a');
23:     link.href = signedUrl;
24:     link.rel = 'noreferrer';
25:     document.body.appendChild(link);
26:     link.click();
27:     link.remove();
28:     return;
29:   }
30:   const cd = res.headers?.['content-disposition'] || '';
31:   const name = /filename="([^"]+)"/i.exec(cd)?.[1] || /filename=([^;\s]+)/i.exec(cd)?.[1] || fallbackName;
32:   const url = URL.createObjectURL(res.data);
33:   const a = document.createElement('a'); a.href = url; a.download = name; a.click();
34:   setTimeout(() => URL.revokeObjectURL(url), 1000);
35: }
36: 
37: export const pageMeta = (meta) => ({ page: meta?.current_page ?? 1, pages: meta?.last_page ?? 1, total: meta?.total ?? 0, per: meta?.per_page ?? 15 });
38: 
39: export async function allPages(fetchPage, signal) {
40:   const items = [];
41:   let page = 1;
42:   let pages = 1;
43:   do {
44:     const response = await fetchPage(page, signal);
45:     items.push(...(response.data || []));
46:     pages = response.meta?.last_page ?? 1;
47:     page += 1;
48:   } while (page <= pages && !signal?.aborted);
49:   return items;
50: }
</file>

