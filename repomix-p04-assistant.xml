 23: 
 24: final class PendingActionService
 25: {
 26:     public function __construct(private ToolRegistry $registry, private SettingService $settings) {}
 27: 
 28:     public function confirm(User $actor, AiPendingAction $action, ?string $typed = null, ?array $selectedItems = null): ToolOutcome
 29:     {
 30:         if ($action->tool === 'bulk_actions') {
 31:             return $this->confirmBulk($actor, $action, $typed, $selectedItems);
 32:         }
 33:         try {
 34:             $result = DB::transaction(function () use ($actor, $action, $typed) {
 35:                 StaffAdministration::lock();
 36:                 $locked = AiPendingAction::query()->lockForUpdate()->findOrFail($action->id);
 37:                 try {
 38:                     return $this->confirmLocked($actor, $locked, $typed);
 39:                 } catch (HttpExceptionInterface $e) {
 40:                     return $e;
 41:                 }
 42:             });
 43:         } catch (\Throwable $e) {
 44:             // M-3: unexpected errors must not leave the proposal stuck in
 45:             // pending — record the failure outside the rolled-back transaction.
 46:             if (! $e instanceof HttpExceptionInterface) {
 47:                 AiPendingAction::whereKey($action->id)->where('status', 'pending')
 48:                     ->update(['status' => 'failed', 'result' => ['message' => 'تعذّر التنفيذ بسبب خطأ غير متوقع؛ اطلب اقتراحًا جديدًا.']]);
 49:             }
 50:             throw $e;
 51:         }
 52:         if ($result instanceof \Throwable) {
 53:             throw $result;
 54:         }
 55: 
 56:         return $result;
 57:     }
 58: 
 59:     private function confirmBulk(User $actor, AiPendingAction $action, ?string $typed, ?array $selectedItems): ToolOutcome
 60:     {
