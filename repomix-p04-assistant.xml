145:     const pending = !status || status === 'pending';
146:     const required = typeof block.typed_confirmation === 'string' ? block.typed_confirmation : '';
147:     const disabled = busy || !execute || !pending || expired;
148:     const warnings = (block.warnings ?? []) as string[];
149:     const addList = (block.add ?? []) as string[];
150:     const removeList = (block.remove ?? []) as string[];
151:     const sensitive = !!required || warnings.length > 0 || addList.some(isSensitive);
152:     const state = !pending ? status! : expired ? 'expired' : 'pending';
153:     const level = seconds <= 15 ? 'crit' : seconds <= 60 ? 'warn' : 'ok';
154:     const typedOk = !required || typed === required;
155:     const icon = block.type === 'permission_diff' ? 'key' : block.type === 'bulk_plan' ? 'layers' : 'shield';
156:     const kindLabel = block.type === 'permission_diff' ? 'تعديل صلاحيات' : block.type === 'bulk_plan' ? 'عملية جماعية' : 'تعديل يحتاج تأكيد';
157:     const allOn = selected.length === items.length;
158: 
159:     return (
160:       <section className="as-block" aria-label="مراجعة وتأكيد العملية" data-state={state} data-sensitive={pending && !expired && sensitive}>
161:         <header className="as-block-head">
162:           <span className="as-block-ic"><Icon name={state === 'executed' ? 'check' : state === 'expired' ? 'clock' : icon} /></span>
163:           <div className="as-block-title">
164:             <h3>{String(block.title ?? 'تأكيد العملية')}</h3>
165:             <span>{kindLabel}{sensitive && pending && !expired ? ' · عملية حساسة' : ''}</span>
166:           </div>
167:           {!pending && <span className={`as-badge as-badge--${statusTone[status!] ?? ''}`}>{statusLabels[status!] ?? status}</span>}
168:           {pending && expired && <span className="as-badge as-badge--warning">انتهت المهلة</span>}
169:         </header>
170: 
171:         <div className="as-block-body">
172:           {block.type === 'permission_diff' && (
173:             <>
174:               <div className="as-perm-grid">
175:                 {(['add', 'remove'] as const).map(key => {
176:                   const list = key === 'add' ? addList : removeList;
177:                   return (
178:                     <div className="as-perm-col" data-kind={key} key={key}>
179:                       <h4><Icon name={key === 'add' ? 'plus' : 'minus'} size={14} />{key === 'add' ? 'إضافة' : 'إزالة'} <span className="as-num">({list.length})</span></h4>
180:                       {list.length ? (
181:                         <ul>
182:                           {list.map(p => (
183:                             <li key={p}>
184:                               <div>{permLabel(p)} {isSensitive(p) && <span className="as-badge as-badge--warning"><Icon name="alert" size={12} />حساسة</span>}</div>
185:                               <code>{p}</code>
186:                             </li>
187:                           ))}
188:                         </ul>
189:                       ) : <p className="as-none">لا يوجد</p>}
190:                     </div>
191:                   );
192:                 })}
193:               </div>
194:               <span className="as-affected"><Icon name="user" size={15} />الموظفين المتأثرين: <b className="as-num">{String(block.affected_users ?? 0)}</b></span>
195:             </>
196:           )}
197: 
198:           {block.type === 'bulk_plan' && (
199:             <fieldset disabled={disabled}>
200:               <legend className="as-sr">العناصر المشمولة بالعملية</legend>
201:               <div className="as-bulk-bar" style={{ marginBottom: '.6rem' }}>
202:                 <label style={{ display: 'inline-flex', alignItems: 'center', gap: '.45rem', cursor: 'pointer' }}>
203:                   <input type="checkbox" className="as-check" checked={allOn} ref={el => { if (el) el.indeterminate = selected.length > 0 && !allOn; }} onChange={() => setSelected(allOn ? [] : items.map(i => i.key))} />
204:                   تحديد الكل
205:                 </label>
206:                 <span className="as-progress" aria-hidden="true"><span style={{ width: `${items.length ? (selected.length / items.length) * 100 : 0}%` }} /></span>
207:                 <span className="as-num">{selected.length} من {items.length} مختار</span>
208:               </div>
209:               <div className="as-bulk-list">
210:                 {items.map(item => {
211:                   const on = selected.includes(item.key);
212:                   return (
213:                     <div className="as-bulk-item" key={item.key} data-on={on}>
214:                       <label className="as-bulk-item-head">
215:                         <input type="checkbox" className="as-check" checked={on} onChange={e => setSelected(ids => (e.target.checked ? [...ids, item.key] : ids.filter(id => id !== item.key)))} />
216:                         <span>{item.label}{item.change && <small style={{ display: 'block', color: 'var(--as-muted)', fontWeight: 400, fontSize: '.76rem' }}>{item.change}</small>}</span>
217:                         <button type="button" className="as-iconbtn" aria-expanded={!!open[item.key]} aria-label={`عرض تفاصيل ${item.label}`} onClick={e => { e.preventDefault(); setOpen(o => ({ ...o, [item.key]: !o[item.key] })); }}>
218:                           <Icon name="chevron" size={16} />
219:                         </button>
220:                       </label>
221:                       {open[item.key] && <DiffTable before={item.before} after={item.after} />}
222:                     </div>
223:                   );
224:                 })}
225:               </div>
226:             </fieldset>
227:           )}
228: 
229:           {block.type === 'confirm_action' && Boolean(block.before || block.after) && <DiffTable before={block.before} after={block.after} />}
230: 
231:           {warnings.map((w, i) => (
232:             <div className="as-alert as-alert--warning" role="note" key={i}>
233:               <Icon name="alert" size={16} />
234:               <div className="as-alert-body"><strong>تنبيه أمني</strong><span>{w}</span></div>
235:             </div>
236:           ))}
237: 
238:           {pending && !expired && required && (
239:             <div className="as-typed">
240:               <label htmlFor={`typed-${String(block.action_id)}`}><Icon name="lock" size={15} />للتأكيد اكتب <b dir="ltr">{required}</b> في الخانة</label>
241:               <div className="as-typed-field" data-match={typed === required}>
242:                 <input id={`typed-${String(block.action_id)}`} className="as-input" value={typed} onChange={e => setTyped(e.target.value)} disabled={disabled} dir="ltr" autoComplete="off" spellCheck={false} placeholder={required} onPaste={e => e.preventDefault()} />
243:                 {typed === required && <Icon name="check" size={16} />}
244:               </div>
245:             </div>
246:           )}
247: 
248:           {pending && expired && (
249:             <div className="as-alert as-alert--info" role="status">
250:               <Icon name="refresh" size={16} />
251:               <div className="as-alert-body"><strong>انتهت صلاحية التأكيد</strong><span>لحماية بياناتك، الاقتراح ده مبقاش قابل للتنفيذ. اطلب من المساعد اقتراح جديد.</span></div>
252:             </div>
253:           )}
254:           {pending && !expired && !execute && (
255:             <div className="as-alert as-alert--info" role="note">
256:               <Icon name="lock" size={16} />
257:               <div className="as-alert-body"><span>معندكش صلاحية تنفيذ عمليات المساعد — تقدر تراجع التفاصيل بس.</span></div>
258:             </div>
259:           )}
260:         </div>
261: 
262:         {pending && !expired && (
263:           <footer className="as-block-foot">
264:             <button
265:               type="button"
266:               className="as-btn as-btn--primary"
267:               disabled={disabled || !typedOk || (block.type === 'bulk_plan' && !selected.length)}
268:               onClick={() => onAction('confirm', String(block.action_id), required ? typed : undefined, block.type === 'bulk_plan' ? selected : undefined)}
269:             >
270:               <Icon name="check" size={16} />
271:               {block.type === 'bulk_plan' ? `تنفيذ على ${selected.length}` : 'تأكيد التنفيذ'}
272:             </button>
273:             <button type="button" className="as-btn" disabled={busy || !pending || expired} onClick={() => onAction('cancel', String(block.action_id))}>إلغاء</button>
274:             <span className="as-spacer" />
275:             <span className="as-timer as-num" data-level={level} role="timer" aria-label={`متبقي ${fmtClock(seconds)} على انتهاء المهلة`}>
276:               <Ring fraction={ttlTotal.current ? seconds / ttlTotal.current : 1} size={18} />
277:               متبقي {fmtClock(seconds)}
278:             </span>
279:           </footer>
280:         )}
281:         <span className="as-sr" role="status">{!pending ? statusLabels[status!] ?? status : expired ? 'انتهت صلاحية التأكيد؛ اطلب اقتراح جديد.' : ''}</span>
282:       </section>
283:     );
284:   }
285: 
286:   /* ---------------- Result ---------------- */
287:   if (block.type === 'result') {
288:     // L7: روابط الفروع والمواقع كانت تُسقط — الـ regex يقبلها الآن.
289:     const link = typeof block.deep_link === 'string' && /^\/(users|roles|settings|branches)(\?|$)/.test(block.deep_link) ? block.deep_link : undefined;
290:     const undo = typeof block.undo_action_id === 'string' ? block.undo_action_id : undefined;
291:     const undoUntil = Date.parse(String(block.undo_available_until));
292:     const undoSec = Math.max(0, Math.ceil((undoUntil - now) / 1000));
293:     if (undoTotal.current === null && undoSec > 0) undoTotal.current = undoSec;
294:     const undone = status === 'undone';
295:     const undoLive = undo && !undone && undoUntil > now;
296:     const ok = !!block.ok;
297:     const okCount = items.filter(i => i.ok).length;
298:     return (
299:       <section className="as-block" role="status" data-state={undone ? 'undone' : ok ? 'executed' : 'failed'}>
300:         <header className="as-block-head">
301:           <span className="as-block-ic"><Icon name={undone ? 'undo' : ok ? 'check' : 'alert'} /></span>
302:           <div className="as-block-title">
303:             <h3>{undone ? 'تم التراجع عن العملية' : ok ? 'تم التنفيذ بنجاح' : 'تعذر التنفيذ'}</h3>
304:             <span>{String(block.message ?? '')}</span>
305:           </div>
306:           {items.length > 0 && <span className={`as-badge as-badge--${okCount === items.length ? 'success' : okCount ? 'warning' : 'danger'}`}><span className="as-num">{okCount}/{items.length}</span> نجح</span>}
307:         </header>
308:         {items.length > 0 && (
309:           <div className="as-block-body">
310:             <ul className="as-result-list">
311:               {items.map((item, index) => (
312:                 <li key={index} data-ok={!!item.ok}><Icon name={item.ok ? 'check' : 'x'} size={15} /><span>{item.message}</span></li>
313:               ))}
314:             </ul>
315:           </div>
316:         )}
317:         {(link || (undoLive && execute)) && (
318:           <>
319:             {undoLive && execute && <div className="as-undo-bar" aria-hidden="true"><span style={{ width: `${undoTotal.current ? (undoSec / undoTotal.current) * 100 : 100}%` }} /></div>}
320:             <footer className="as-block-foot">
321:               {link && <a className="as-btn as-btn--sm" href={`#${link}`} style={{ textDecoration: 'none' }}><Icon name="external" size={15} />افتح في الشاشة</a>}
322:               <span className="as-spacer" />
323:               {undoLive && execute && (
324:                 <span className="as-undo">
325:                   <span className="as-num" style={{ fontSize: '.78rem', color: 'var(--as-muted)' }}>متاح {fmtClock(undoSec)}</span>
326:                   <button type="button" className="as-btn as-btn--sm" disabled={busy} onClick={() => onAction('undo', undo!)}><Icon name="undo" size={15} />تراجع</button>
327:                 </span>
328:               )}
329:             </footer>
330:           </>
331:         )}
332:       </section>
333:     );
334:   }
335: 
336:   /* ---------------- Table ---------------- */
337:   if (block.type === 'table') {
338:     const columns = (block.columns ?? []) as string[];
339:     const rows = (block.rows ?? []) as (string | number | null)[][];
340:     return (
341:       <div className="as-table-wrap">
342:         <table className="as-table">
343:           <thead><tr>{columns.map((c, i) => <th key={i} scope="col">{c}</th>)}</tr></thead>
344:           <tbody>
345:             {rows.map((r, i) => <tr key={i}>{r.map((c, j) => <td key={j} className={typeof c === 'number' ? 'as-num' : undefined}>{c ?? '—'}</td>)}</tr>)}
346:             {!rows.length && <tr><td colSpan={columns.length || 1} style={{ textAlign: 'center', color: 'var(--as-muted)' }}>لا توجد بيانات</td></tr>}
347:           </tbody>
348:         </table>
349:       </div>
350:     );
351:   }
352:   return null;
353: }
