358:                     }
359:                     $sequenceType = array_search($key, self::SEQUENCE_TYPES, true);
360:                     if (is_string($sequenceType)) {
361:                         $value = max($value, $this->nextDocumentNumber($sequenceType));
362:                         $documentSequenceTargets[$sequenceType] = $value;
363:                     }
364:                     if ($requested < $value) {
365:                         throw ValidationException::withMessages([$key => 'لا يمكن خفض عداد الترقيم عن قيمته الحالية.']);
366:                     }
367:                 }
368: 
369:                 $setting->value = $value === null && str_ends_with($key, '_prefix')
370:                     ? ''
371:                     : $this->serializeValue($value, $setting->type);
372:                 $setting->save();
373:                 $after[$key] = $this->castValue($setting->value, $setting->type);
374:             }
375: 
376:             $this->assertNumberingDoesNotCollide($settings, $after);
377: 
378:             StaffAdministration::audit(request()->user('staff'), 'settings.updated', 'settings', null, array_keys($settings),
379:                 ['settings' => $this->auditableSettings($before)], ['settings' => $this->auditableSettings($after)], $via);
380:             DB::afterCommit(fn () => $this->clearCache());
