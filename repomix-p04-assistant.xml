256:     private function assertNumberingDoesNotCollide(array $settings, array $after): void
257:     {
258:         foreach ($this->numberingDefinitions() as $type => $definition) {
259:             $keys = [$definition['prefix'], $definition['next'], $definition['padding']];
260:             $target = self::NUMBERING_TARGETS[$type] ?? null;
261:             if ($target === null || array_intersect($keys, array_keys($settings)) === []) {
262:                 continue;
263:             }
264: 
265:             $prefix = array_key_exists($definition['prefix'], $after)
266:                 ? (string) $after[$definition['prefix']]
267:                 : (string) $this->get($definition['prefix'], '');
268:             $padding = array_key_exists($definition['padding'], $after)
269:                 ? max(0, (int) $after[$definition['padding']])
270:                 : max(0, (int) $this->get($definition['padding'], 0));
271:             $next = array_key_exists($definition['next'], $after)
272:                 ? (int) $after[$definition['next']]
273:                 : ($type === 'movement' ? $this->nextMovementNumber() : $this->nextDocumentNumber($type));
274: 
275:             // Collision scan covers the next number AND any future number:
276:             // any existing document sharing this prefix whose numeric suffix
277:             // is >= the proposed counter would collide now or later.
278:             $escaped = addcslashes($prefix, '\\%_');
279:             $existing = DB::table($target[0])->where($target[1], 'like', $escaped.'%')->pluck($target[1]);
280:             $max = null;
281:             foreach ($existing as $number) {
282:                 // The remainder after the prefix must be purely numeric:
283:                 // that numeric suffix is what future counters would reproduce.
284:                 $tail = trim(substr((string) $number, strlen($prefix)));
285:                 if ($tail === '' || ! ctype_digit($tail)) {
286:                     continue;
287:                 }
288:                 $max = max($max ?? 0, (int) $tail);
289:             }
290: 
291:             if ($max !== null && $max >= $next) {
292:                 throw ValidationException::withMessages([
293:                     $definition['next'] => 'الرقم '.$prefix.str_pad((string) $next, $padding, '0', STR_PAD_LEFT).' مستخدم بالفعل في '.$target[0].'. غيّر البداية أو البادئة أو الطول.',
294:                 ]);
295:             }
296:         }
297:     }
