129:         abort_unless($def && $actor->is_active && $actor->can('ai_agent.use') && $actor->can('ai_agent.execute') && $actor->canAny($def['permissions']), 403);
130:         abort_unless($action->conversation()->exists(), 409, 'المحادثة اتحذفت.');
