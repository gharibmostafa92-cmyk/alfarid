 53:   --as-radius: 18px;
 54:   --as-radius-sm: 12px;
 55:   --as-radius-xs: 8px;
 56:   --as-font: 'IBM Plex Sans Arabic', 'Segoe UI', Tahoma, sans-serif;
 57:   --as-mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
 58:   --as-sidebar: 288px;
 59: 
 60:   container: as / inline-size;
 61:   position: relative;
 62:   height: var(--as-height, calc(100dvh - 3rem));
 63:   min-height: 32rem;
 64:   color: var(--as-text);
 65:   background: var(--as-bg);
 66:   font-family: var(--as-font);
 67:   font-size: 14.5px;
 68:   line-height: 1.7;
 69:   border-radius: var(--as-radius);
 70:   border: 1px solid var(--as-border);
 71:   box-shadow: var(--as-shadow);
 72:   overflow: hidden;
 73:   isolation: isolate;
 74:   -webkit-font-smoothing: antialiased;
 75: }
