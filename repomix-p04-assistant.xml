<file path="bags-platform/backend/app/Http/Controllers/Api/V1/Wholesale/RegisterController.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Http\Controllers\Api\V1\Wholesale;
 6: 
 7: use App\Enums\CustomerDocumentStatus;
 8: use App\Enums\CustomerStatus;
 9: use App\Exceptions\BusinessException;
10: use App\Http\Controllers\Controller;
11: use App\Http\Requests\Wholesale\WholesaleRegisterRequest;
12: use App\Http\Resources\Store\CustomerResource;
13: use App\Models\Customer;
14: use App\Services\WholesaleRegistrationService;
15: use Illuminate\Http\JsonResponse;
16: use Illuminate\Http\Request;
17: 
18: /** تسجيل تجار الجملة ومتابعة حالة طلب الاعتماد. */
19: class RegisterController extends Controller
20: {
21:     public function __construct(
22:         private readonly WholesaleRegistrationService $registrations,
23:     ) {}
24: 
25:     public function register(WholesaleRegisterRequest $request): JsonResponse
26:     {
27:         $data = $request->validated();
28:         $registration = $this->registrations->register(
29:             $data,
30:             $request->file('documents', []),
31:             $data['document_types'] ?? [],
32:         );
33: 
34:         return CustomerResource::make($registration['customer'])
35:             ->additional(['message' => 'تم استلام طلب التسجيل؛ حسابك قيد المراجعة', 'token' => $registration['token']])
36:             ->response()
37:             ->setStatusCode(201);
38:     }
39: 
40:     /**
41:      * حالة الطلب لصاحبه — بما فيه المرفوض (يحتاج سبب الرفض ومستنداته).
42:      * محمي بمصادقة العملاء فقط؛ لا يحتاج اعتماد الجملة.
43:      */
44:     public function applicationStatus(Request $request): JsonResponse
45:     {
46:         $customer = $request->user();
47:         if (! $customer instanceof Customer) {
48:             throw new BusinessException('هذه النهاية مخصصة لحسابات العملاء.', [], 403);
49:         }
50: 
51:         $customer->load('documents');
52: 
53:         return response()->json([
54:             'data' => [
55:                 ...CustomerResource::make($customer)->resolve($request),
56:                 'rejection_reason' => $customer->status === CustomerStatus::Rejected ? $customer->rejection_reason : null,
57:                 'suspension_reason' => $customer->status === CustomerStatus::Suspended ? $customer->suspension_reason : null,
58:                 'approved_at' => $customer->approved_at,
59:                 'documents' => $customer->documents->map(fn ($document) => [
60:                     'id' => $document->id,
61:                     'document_type' => $document->document_type,
62:                     'status' => $document->status,
63:                     'original_name' => $document->original_name,
64:                 ])->all(),
65:                 'rejected_documents' => $customer->documents
66:                     ->where('status', CustomerDocumentStatus::Rejected)
67:                     ->map(fn ($document) => [
68:                         'id' => $document->id,
69:                         'document_type' => $document->document_type,
70:                         'original_name' => $document->original_name,
71:                     ])->values()->all(),
72:             ],
73:         ]);
74:     }
75: }
