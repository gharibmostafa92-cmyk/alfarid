475:     private function comparisonValue(mixed $value, string $type): ?string
476:     {
477:         if ($type === 'float' && $value !== null && is_numeric($value)) {
478:             return (string) BigDecimal::of((string) $value)->strippedOfTrailingZeros();
479:         }
480: 
481:         return $type === 'string' ? (string) ($value ?? '') : $this->serializeValue($value, $type);
482:     }
483: 
484:     private function auditableSettings(array $settings): array
485:     {
486:         // Only the public administrative settings schema is safe to audit as values.
487:         $allowed = array_keys((new UpdateSettingsRequest)->rules());
488: 
489:         return array_intersect_key($settings, array_flip($allowed));
490:     }
