133: async function allRecords<T>(path: string, params: object = {}, signal?: AbortSignal): Promise<T[]> {
134:   const rows: T[] = [];
135:   let page = 1, lastPage = 1;
136:   do {
137:     const response = await api.get(path, { params: cleanParams({ ...params, per_page: 100, page }), signal });
138:     const result = asPage<T>(response);
139:     rows.push(...result.data);
140:     lastPage = result.meta.last_page;
141:     page++;
142:   } while (page <= lastPage);
143:   return rows;
144: }
145: export const commerceLookupsApi = {
146:   customers: (signal?: AbortSignal) => allRecords<{ id: number; name: string }>(ADMIN + '/customers', { type: 'wholesale' }, signal),
147:   categories: (signal?: AbortSignal) => allRecords<{ id: number; name_ar: string }>(ADMIN + '/categories', {}, signal)
148:     .then(rows => rows.map(row => ({ id: row.id, label: row.name_ar }))),
149:   brands: (signal?: AbortSignal) => allRecords<{ id: number; name_ar: string }>(ADMIN + '/brands', {}, signal)
150:     .then(rows => rows.map(row => ({ id: row.id, label: row.name_ar }))),
151:   variants: async (signal?: AbortSignal): Promise<CommerceOption[]> => {
