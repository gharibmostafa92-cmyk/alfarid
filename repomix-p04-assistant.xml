27: 
28:     public function updateSettings(Request $request, SettingService $settings, BranchAccess $branches): JsonResponse
29:     {
30:         $branches->assertCentralAccess($request->user('staff'));
31:         $rules = (new UpdateSettingsRequest)->rules();
32:         $allowed = array_filter($rules, fn ($key) => str_starts_with($key, 'ai_') || str_starts_with($key, 'expected.ai_') || $key === 'expected', ARRAY_FILTER_USE_KEY);
33:         abort_if(array_diff(array_keys($request->all()), ['expected', ...array_filter(array_keys($allowed), fn ($key) => str_starts_with($key, 'ai_') && ! str_contains($key, '.'))]) !== [], 422);
34:         $data = $request->validate($allowed);
35:         $expected = $data['expected'];
36:         unset($data['expected']);
37:         abort_unless(array_diff(array_keys($data), array_keys($expected)) === [] && array_diff(array_keys($expected), array_keys($data)) === [], 422, 'القيم الأصلية مطلوبة لكل إعداد معدل.');
38:         try {
39:             DB::transaction(function () use ($request, $settings, $data, $expected): void {
40:                 StaffAdministration::lock();
41:                 StaffAdministration::authorize($request->user('staff'), ['ai_agent.settings']);
42:                 // L-5: قناة التدقيق (ai) لا تُترك فارغة كما في SettingController.
43:                 $settings->updateBatch($data, $expected, ['channel' => 'ai']);
44:             });
45:         } catch (InvalidArgumentException) {
46:             return response()->json([
47:                 'message' => 'إعداد أو أكثر غير مهيأ في قاعدة البيانات. شغّل Seeder الإعدادات ثم أعد المحاولة.',
48:             ], 409);
49:         }
50: 
51:         return response()->json(['data' => $settings->getAllGrouped()['ai'] ?? []]);
52:     }
53: 
54:     public function usage(Request $request, BranchAccess $branches): JsonResponse
55:     {
56:         $actor = $request->user('staff');
57:         $all = $request->boolean('all') && $actor->can('ai_agent.logs.view');
58:         // L-4: all=1 يكشف استهلاك المؤسسة كاملة — يتطلب وصولًا مركزيًا.
59:         if ($all) {
60:             $branches->assertCentralAccess($actor);
61:         }
62:         $rows = AiMessage::query()->whereHas('conversation', function ($q) use ($actor, $all): void {
63:             $q->withTrashed();
64:             if (! $all) {
65:                 $q->where('user_id', $actor->id);
66:             }
67:         })->where('created_at', '>=', now()->subDays(30))->selectRaw('DATE(created_at) as day, SUM(input_tokens) as input_tokens, SUM(output_tokens) as output_tokens')->groupByRaw('DATE(created_at)')->orderByDesc('day')->get();
68: 
69:         return response()->json(['data' => $rows]);
70:     }
