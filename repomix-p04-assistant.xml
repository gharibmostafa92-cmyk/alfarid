 16: // L-1: مع responseType: 'text' تصل response.data نصًا — تُفقد رسائل
 17: // 429 (الميزانية) و423 (طلب جارٍ) و403. JSON.parse آمن داخل catch.
 18: function apiErrorMessage(e: unknown, fallback: string): string {
 19:   const data = (e as { response?: { data?: unknown } }).response?.data;
 20:   if (typeof data === 'string') {
 21:     try {
 22:       const parsed = JSON.parse(data) as { message?: unknown };
 23:       if (typeof parsed.message === 'string' && parsed.message !== '') return parsed.message;
 24:     } catch {
 25:       if (data !== '') return data;
 26:     }
 27:   }
 28:   if (typeof data === 'object' && data !== null && typeof (data as { message?: unknown }).message === 'string') {
 29:     return (data as { message: string }).message;
 30:   }
 31:   return fallback;
 32: }
 33: // تصنيف الخطأ عشان نعرض شكل مناسب (ميزانية / طلب جارٍ / صلاحية / مؤقت).
 34: function apiErrorKind(e: unknown): 'budget' | 'locked' | 'forbidden' | 'transient' {
 35:   const code = (e as { response?: { status?: number } }).response?.status;
 36:   if (code === 429) return 'budget';
 37:   if (code === 423) return 'locked';
 38:   if (code === 403) return 'forbidden';
 39:   return 'transient';
 40: }
