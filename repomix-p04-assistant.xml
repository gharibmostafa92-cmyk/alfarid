19: class AiAdministrationController extends Controller
20: {
21:     public function settings(Request $request, SettingService $settings, ToolRegistry $registry, BranchAccess $branches): JsonResponse
22:     {
23:         $branches->assertCentralAccess($request->user('staff'));
24: 
25:         return response()->json(['data' => $settings->getAllGrouped()['ai'] ?? [], 'tools' => array_keys($registry->definitions())]);
