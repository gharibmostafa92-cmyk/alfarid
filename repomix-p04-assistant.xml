 77: /* 2. الوضع الداكن (Dark Mode) - عند الضغط على زر الثيم الداكن في Vortix */
 78: :root[data-theme='dark'] .assistant,
 79: [data-theme='dark'] .assistant,
 80: .theme-dark .assistant,
 81: .assistant[data-theme='dark'],
 82: .assistant.theme-dark {
 83:   color-scheme: dark;
 84:   --as-primary: var(--accent-orange, #e65328);
 85:   --as-primary-hover: #ff6838;
 86:   --as-primary-soft: var(--accent-orange-light, rgba(230, 83, 40, 0.18));
 87:   --as-primary-ring: rgba(230, 83, 40, 0.45);
 88:   --as-accent: #f0683d;
 89: 
 90:   --as-bg: var(--bg-card, #17141a);
 91:   --as-surface: var(--bg-card, #17141a);
 92:   --as-surface-2: var(--bg-subcard, #1c1920);
 93:   --as-surface-3: var(--bg-subcard-hover, #25212a);
 94:   --as-border: var(--border-subtle, rgba(255, 255, 255, 0.08));
 95:   --as-border-strong: var(--border-field, rgba(255, 255, 255, 0.14));
 96: 
 97:   --as-text: var(--text-primary, #f5f3f7);
 98:   --as-muted: var(--text-secondary, #b0abb8);
 99:   --as-faint: var(--text-muted, #8e8896);
100: 
101:   --as-success: #34d399;
102:   --as-success-soft: rgba(6, 78, 59, 0.45);
103:   --as-warning: #fbbf24;
104:   --as-warning-soft: rgba(180, 83, 9, 0.25);
105:   --as-danger: #fb7185;
106:   --as-danger-soft: rgba(136, 19, 55, 0.45);
107:   --as-info: #818cf8;
108:   --as-info-soft: rgba(67, 56, 202, 0.25);
109: 
110:   --as-user-bubble: #26222c;
111:   --as-user-text: #f5f3f7;
112: 
113:   --as-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
114:   --as-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.5);
115:   --as-shadow-lg: 0 20px 48px -10px rgba(0, 0, 0, 0.7);
116: }
