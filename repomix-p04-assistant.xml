 85:       if (doc === 'dark' || doc === 'light') setResolvedTheme(doc);
 86:     };
 87:     const observer = new MutationObserver(update);
 88:     observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
 89:     return () => observer.disconnect();
