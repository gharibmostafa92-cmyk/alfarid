 483:           </Field>
 484:           <Field label="أقصى مدة تسليم (أيام)" err={err ?? f.errors.max}>
 485:             <input
 486:               type="number"
 487:               min="0"
 488:               className={'inp num ' + (err ? 'err' : '')}
 489:               value={f.v.max}
 490:               onChange={f.on('max' as any)}
 491:             />
 492:           </Field>
 493:         </div>
 494:       </div>
 495:     </Modal>
