538: .as-legend-out { display: inline-block; width: 9px; height: 9px; border-radius: 3px; background: color-mix(in oklab, var(--as-primary) 35%, var(--as-surface-3)); }
539: .as-card { border-radius: var(--as-radius); background: var(--as-surface); border: 1px solid var(--as-border); overflow: hidden; }
540: .as-card-head { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .9rem 1rem; border-bottom: 1px solid var(--as-border); flex-wrap: wrap; }
541: .as-card-head h3 { font-size: .95rem; font-weight: 600; }
542: .as-card-body { padding: 1rem; }
