247:     public function cancel(User $actor, AiPendingAction $action): AiPendingAction
248:     {
249:         abort_unless($action->user_id === $actor->id, 403);
250: 
251:         return DB::transaction(function () use ($actor, $action): AiPendingAction {
252:             StaffAdministration::lock();
253:             $locked = AiPendingAction::query()->lockForUpdate()->findOrFail($action->id);
254:             if ($locked->status === 'pending') {
255:                 $locked->forceFill(['status' => 'cancelled'])->save();
256:                 if ($locked->tool === 'bulk_actions') {
257:                     // M10: الإجراءات الفرعية بتنقفل مع الخبّة الجماعية.
258:                     AiPendingAction::query()->where('user_id', $actor->id)->where('conversation_id', $locked->conversation_id)->whereIn('id', $locked->args['action_ids'])->whereIn('status', ['pending', 'bulk_child'])->update(['status' => 'cancelled']);
259:                 }
260:                 $this->event($locked, 'result', 'تم إلغاء الإجراء '.$locked->id, [['type' => 'result', 'ok' => true, 'message' => 'تم إلغاء الإجراء.']]);
