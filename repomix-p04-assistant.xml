 530:     private function prepSetBranchStatus(User $actor, AiConversation $conv, array $args): ToolOutcome
 531:     {
 532:         $branch = null;
 533:         if (! empty($args['branch_id'])) {
 534:             $branch = Branch::find((int) $args['branch_id']);
 535:         } elseif (! empty($args['branch_query'])) {
 536:             $opts = $this->resolver->branches($actor, (string) $args['branch_query']);
 537:             if (count($opts) === 1) {
 538:                 $branch = Branch::find($opts[0]['id']);
 539:             }
 540:         }
 541:         if (! $branch) {
 542:             return $this->pickerFor($actor, 'branch', 'set_branch_status', (string) ($args['branch_query'] ?? ''));
 543:         }
 544:         $restricted = null;
 545:         try {
 546:             $restricted = $this->branches->restrictedBranch($actor);
 547:         } catch (\Throwable) {
