<file path="bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Ai/AiMessageController.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Http\Controllers\Api\V1\Admin\Ai;
 6: 
 7: use App\Http\Controllers\Controller;
 8: use App\Models\AiConversation;
 9: use App\Services\Ai\AgentOrchestrator;
10: use App\Services\Ai\GeminiException;
11: use Illuminate\Auth\Access\AuthorizationException;
12: use Illuminate\Http\JsonResponse;
13: use Illuminate\Http\Request;
14: use Illuminate\Validation\Rule;
15: use Illuminate\Validation\ValidationException;
16: use Symfony\Component\HttpFoundation\StreamedResponse;
17: use Symfony\Component\HttpKernel\Exception\HttpExceptionInterface;
18: 
19: class AiMessageController extends Controller
20: {
21:     public function stream(Request $request, AiConversation $conversation, AgentOrchestrator $orchestrator): StreamedResponse
22:     {
23:         abort_unless($conversation->user_id === $request->user('staff')->id, 403);
24:         $data = $this->validated($request);
25:         $orchestrator->guard($request->user('staff'));
26: 
27:         return response()->stream(function () use ($request, $conversation, $orchestrator, $data): void {
28:             $emit = static function (string $event, array $payload): void {
29:                 echo 'event: '.$event."\n".'data: '.json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR)."\n\n";
30:                 if (ob_get_level() > 0) {
31:                     ob_flush();
32:                 }
33:                 flush();
34:             };
35:             try {
36:                 $reply = $orchestrator->handle($request->user('staff'), $conversation, $data, fn ($status) => $emit('status', ['message' => $status]));
37:                 $emit('reply', ['text' => $reply->text, 'ui_blocks' => $reply->blocks, 'message_id' => $reply->messageId]);
38:             } catch (\Throwable $e) {
39:                 // L-9: أخطاء التفويض والتحقق ليست HttpExceptionInterface —
40:                 // بدون تصنيف كانت تظهر كـ 502 مضللة.
41:                 $status = match (true) {
42:                     $e instanceof HttpExceptionInterface => $e->getStatusCode(),
43:                     $e instanceof AuthorizationException => 403,
44:                     $e instanceof ValidationException => 422,
45:                     default => 502,
46:                 };
47:                 if ($status >= 500) {
48:                     report($e);
49:                 }
50:                 $emit('error', ['message' => $status < 500 ? $e->getMessage() : 'تعذر إتمام طلب المساعد. حاول مرة تانية.', 'status' => $status]);
51:             }
52:         }, 200, ['Content-Type' => 'text/event-stream', 'Cache-Control' => 'no-cache, no-store', 'X-Accel-Buffering' => 'no']);
53:     }
54: 
55:     public function store(Request $request, AiConversation $conversation, AgentOrchestrator $orchestrator): JsonResponse
56:     {
57:         abort_unless($conversation->user_id === $request->user('staff')->id, 403);
58:         $data = $this->validated($request);
59:         try {
60:             $reply = $orchestrator->handle($request->user('staff'), $conversation, $data);
61:         } catch (GeminiException $e) {
62:             return response()->json(['message' => $e->getMessage()], 502);
63:         }
64: 
65:         return response()->json(['data' => ['text' => $reply->text, 'ui_blocks' => $reply->blocks, 'message_id' => $reply->messageId]]);
66:     }
67: 
68:     private function validated(Request $request): array
69:     {
70:         return $request->validate([
71:             'text' => ['nullable', 'string', 'max:8000'],
72:             'selection' => ['nullable', 'array:entity,id,label'], 'selection.entity' => ['required_with:selection', 'in:branch,user,role,permission,location'], 'selection.id' => ['required_with:selection', Rule::when($request->input('selection.entity') !== 'permission', ['integer', 'min:1'], ['string', 'max:255'])], 'selection.label' => ['nullable', 'string', 'max:255'],
73:             'mentions' => ['nullable', 'array', 'max:25'], 'mentions.*.entity' => ['required', 'in:branch,user,role,location'], 'mentions.*.id' => ['required', 'integer', 'min:1'],
74:         ]);
75:     }
76: }
</file>

<file path="bags-platform/backend/app/Rules/EmailNotUsedByOtherAccountType.php">
 1: <?php
 2: 
 3: declare(strict_types=1);
 4: 
 5: namespace App\Rules;
 6: 
 7: use Closure;
 8: use Illuminate\Contracts\Validation\ValidationRule;
 9: use Illuminate\Support\Facades\DB;
10: 
11: /** يمنع تسجيل بريد مستخدم أصلًا في نوع حساب آخر (users / supplier_users / customers). */
12: final class EmailNotUsedByOtherAccountType implements ValidationRule
13: {
14:     public function __construct(private readonly string $ownTable) {}
15: 
16:     public function validate(string $attribute, mixed $value, Closure $fail): void
17:     {
18:         if (! is_string($value) || trim($value) === '') {
19:             return;
20:         }
21:         $email = mb_strtolower(trim($value));
22:         foreach (['users', 'supplier_users', 'customers'] as $table) {
23:             if ($table === $this->ownTable) {
24:                 continue;
25:             }
26:             $query = DB::table($table)->whereRaw('LOWER(email) = ?', [$email]);
27:             if ($table === 'customers') {
28:                 $query->whereNull('deleted_at');
29:                 // Trader contact emails are login identifiers even before verification.
30:                 $query->where(fn ($query) => $query->whereNotNull('email_verified_at')
31:                     ->orWhereIn('type', ['wholesale', 'distributor']));
32:             }
33:             if ($query->exists()) {
34:                 $fail('هذا البريد مستخدم بحساب آخر في النظام.');
35: 
36:                 return;
37:             }
38:         }
39:     }
40: }
</file>

<file path="bags-platform/backend/app/Services/Ai/EntityResolver.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Services\Ai;
  6: 
  7: use App\Models\Branch;
  8: use App\Models\Location;
  9: use App\Models\User;
 10: use App\Services\BranchAccess;
 11: use App\Services\SearchTerm;
 12: use Spatie\Permission\Models\Permission;
 13: use Spatie\Permission\Models\Role;
 14: 
 15: final class EntityResolver
 16: {
 17:     public function __construct(private BranchAccess $branches) {}
 18: 
 19:     public static function normalize(string $value): string
 20:     {
 21:         $v = mb_strtolower(trim($value));
 22:         $v = str_replace(['أ', 'إ', 'آ', 'ٱ'], 'ا', $v);
 23:         $v = str_replace(['ة'], 'ه', $v);
 24:         $v = str_replace(['ى'], 'ي', $v);
 25:         $v = preg_replace('/[\x{064B}-\x{065F}\x{0640}]/u', '', $v) ?? $v;
 26: 
 27:         return preg_replace('/\s+/u', ' ', $v) ?? $v;
 28:     }
 29: 
 30:     private function restricted(?User $actor): ?int
 31:     {
 32:         if (! $actor) {
 33:             return null;
 34:         }
 35:         try {
 36:             return $this->branches->restrictedBranch($actor);
 37:         } catch (\Throwable) {
 38:             return -1;
 39:         }
 40:     }
 41: 
 42:     /** @return list<array{id:int,label:string,meta:string}> */
 43:     public function branches(User $actor, string $query = '', array $filters = []): array
 44:     {
 45:         $restricted = $this->restricted($actor);
 46:         if ($restricted === -1) {
 47:             return [];
 48:         }
 49:         // M6/L5: الفلترة في SQL (ILIKE محمي بـ SearchTerm::escape) مع LIMIT —
 50:         // استعلام بلا نتيجة ما يمسحش الجدول كله ولا يعمل ذاكرة lazy.
 51:         return Branch::query()->withCount('users')
 52:             ->when($restricted !== null, fn ($x) => $x->whereKey($restricted))
 53:             ->when(array_key_exists('active', $filters), fn ($x) => $x->where('is_active', $filters['active']))
 54:             ->when(isset($filters['type']), fn ($x) => $x->where('type', $filters['type']))
 55:             ->when(isset($filters['city']), fn ($x) => $x->where('city', $filters['city']))
 56:             ->when($query !== '', fn ($x) => $x->where(fn ($w) => $w
 57:                 ->where('name', 'ilike', SearchTerm::pattern($query))
 58:                 ->orWhere('code', 'ilike', SearchTerm::pattern($query))
 59:                 ->orWhere('city', 'ilike', SearchTerm::pattern($query))))
 60:             ->orderBy('id')
 61:             ->limit(50)
 62:             ->get()
 63:             ->map(fn (Branch $b) => ['id' => $b->id, 'label' => $b->name.' ('.$b->code.')', 'meta' => trim(($b->city ?? '').' · '.($b->is_active ? 'نشط' : 'متوقف').' · موظفين: '.$b->users_count)])
 64:             ->values()
 65:             ->all();
 66:     }
 67: 
 68:     /** @return list<array{id:int,label:string,meta:string}> */
 69:     public function users(User $actor, string $query = ''): array
 70:     {
 71:         $restricted = $this->restricted($actor);
 72:         if ($restricted === -1) {
 73:             return [];
 74:         }
 75: 
 76:         return User::query()->where('is_system', false)
 77:             ->when($restricted !== null, fn ($x) => $x->where('branch_id', $restricted))
 78:             ->when($query !== '', fn ($x) => $x->where(fn ($w) => $w
 79:                 ->where('name', 'ilike', SearchTerm::pattern($query))
 80:                 ->orWhere('email', 'ilike', SearchTerm::pattern($query))
 81:                 ->orWhere('phone', 'ilike', SearchTerm::pattern($query))))
 82:             ->orderBy('id')
 83:             ->limit(50)
 84:             ->get()
 85:             ->map(fn (User $u) => ['id' => $u->id, 'label' => $u->name, 'meta' => $this->maskEmail($u->email).' · '.($u->is_active ? 'نشط' : 'معطّل')])
 86:             ->values()
 87:             ->all();
 88:     }
 89: 
 90:     /** @return list<array{id:int,label:string,meta:string}> */
 91:     public function roles(string $query = ''): array
 92:     {
 93:         return Role::query()->withCount(['users', 'permissions'])
 94:             ->where('guard_name', 'staff')
 95:             ->when($query !== '', fn ($x) => $x->where('name', 'ilike', SearchTerm::pattern($query)))
 96:             ->orderBy('id')
 97:             ->limit(50)
 98:             ->get()
 99:             ->map(fn (Role $r) => ['id' => $r->id, 'label' => $r->name, 'meta' => 'موظفين: '.$r->users_count.' · صلاحيات: '.$r->permissions_count])
100:             ->values()
101:             ->all();
102:     }
103: 
104:     /** @return list<array{id:int,label:string,meta:string}> */
105:     public function locations(User $actor, string $query = '', ?int $branchId = null): array
106:     {
107:         $restricted = $this->restricted($actor);
108:         if ($restricted === -1) {
109:             return [];
110:         }
111:         // M1: قيد الفرع يطبق أولًا — مقيّد بفرع ما يقدرش يوجّه branch_id لفرع تاني.
112:         // M6/L5: نفس الفلترة السلكية المحمية مع LIMIT.
113:         return Location::query()
114:             ->when($restricted !== null, fn ($q) => $q->where('branch_id', $restricted), fn ($q) => $q->when($branchId !== null, fn ($w) => $w->where('branch_id', $branchId)))
115:             ->when($query !== '', fn ($x) => $x->where(fn ($w) => $w
116:                 ->where('name', 'ilike', SearchTerm::pattern($query))
117:                 ->orWhere('code', 'ilike', SearchTerm::pattern($query))))
118:             ->orderBy('id')
119:             ->limit(50)
120:             ->get()
121:             ->map(fn (Location $l) => [
122:                 'id' => $l->id,
123:                 'label' => $l->name.' ('.$l->code.')',
124:                 'meta' => trim(($l->type?->value ?? '').' · '.($l->is_active ? 'نشط' : 'معطّل').' · فرع: '.$l->branch_id),
125:             ])
126:             ->values()
127:             ->all();
128:     }
129: 
130:     public function maskEmail(?string $email): string
131:     {
132:         if (! $email || ! str_contains($email, '@')) {
133:             return '';
134:         }
135:         [$local, $domain] = explode('@', $email, 2);
136: 
137:         return mb_substr($local, 0, 2).'***@'.$domain;
138:     }
139: 
140:     /** @param list<string> $fields */
141:     public function matches(string $query, array $fields): bool
142:     {
143:         $nq = self::normalizeForSearch($query);
144:         if ($nq === '') {
145:             return true;
146:         }
147:         foreach ($fields as $f) {
148:             if (str_contains(self::normalizeForSearch($f), $nq)) {
149:                 return true;
150:             }
151:         }
152: 
153:         return false;
154:     }
155: 
156:     public static function normalizeForSearch(string $value): string
157:     {
