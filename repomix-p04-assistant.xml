 51: const dayKey = (iso: string | null) => {
 52:   if (!iso) return 'older';
 53:   const d = new Date(iso); const t = new Date();
 54:   const start = (x: Date) => new Date(x.getFullYear(), x.getMonth(), x.getDate()).getTime();
 55:   const diff = Math.round((start(t) - start(d)) / 86400000);
 56:   return diff <= 0 ? 'today' : diff === 1 ? 'yesterday' : diff < 7 ? 'week' : 'older';
 57: };
 58: const groupTitles: Record<string, string> = { pinned: 'المثبّتة', today: 'النهارده', yesterday: 'امبارح', week: 'آخر ٧ أيام', older: 'أقدم' };
 59: const relTime = (iso: string | null) => {
 60:   if (!iso) return '';
 61:   const d = new Date(iso);
 62:   return dayKey(iso) === 'today' ? d.toLocaleTimeString('ar-EG', { hour: 'numeric', minute: '2-digit' }) : d.toLocaleDateString('ar-EG', { day: 'numeric', month: 'short' });
 63: };
