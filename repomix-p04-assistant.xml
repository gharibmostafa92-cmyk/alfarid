 962:   };
 963:   const applyPercent = async (pctVal: number) => {
 964:     if (pctVal < -100) return toast('النسبة لا تقل عن -100%', 'red');
 965:     const result = await run(async () => {
 966:       for (const r of items) {
 967:         const price = Number((Number(r.price) * (1 + pctVal / 100)).toFixed(4));
 968:         await itemsApi.update(r.id, { product_variant_id: r.variantId, min_qty: Number(r.min), price, starts_at: r.from || null, ends_at: r.to || null });
 969:       }
 970:       return true;
 971:     }, { toast, success: 'تم تطبيق التعديل' });
 972:     remoteItems.reload();
 973:     if (result) setPct('');
