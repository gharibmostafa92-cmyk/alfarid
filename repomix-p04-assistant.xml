 391:     private function prepareBulk(User $actor, AiConversation $conv, array $args): ToolOutcome
 392:     {
 393:         return DB::transaction(function () use ($actor, $conv, $args): ToolOutcome {
 394:             $ids = [];
 395:             $items = [];
 396:             foreach ($args['items'] as $item) {
 397:                 $outcome = $this->dispatch($actor, $conv, ['name' => $item['tool'], 'args' => $item['args']]);
 398:                 if ($outcome->type !== 'proposal') {
 399:                     AiPendingAction::whereIn('id', $ids)->update(['status' => 'cancelled']);
 400: 
 401:                     return ToolOutcome::denied($outcome->message ?? 'حدد كل العناصر بوضوح قبل تجهيز العملية الجماعية.');
 402:                 }
 403:                 $id = $outcome->data['pending_action_id'];
 404:                 $ids[] = $id;
 405:                 $items[] = ['key' => $id, 'label' => $outcome->uiBlock['title'], 'change' => $item['tool'], 'before' => $outcome->uiBlock['before'] ?? null, 'after' => $outcome->uiBlock['after'] ?? null];
 406:             }
 407:             $outcome = $this->makeProposal($actor, $conv, 'bulk_actions', ['action_ids' => $ids], [], ['title' => 'مراجعة '.count($ids).' عمليات', 'items' => $items, 'warnings' => ['كل عنصر بيتنفذ لوحده. راجع التغييرات واستبعد أي عنصر مش مطلوب.']], null, 'high');
 408:             // M10: الأجراءات الفرعية بتبقى bulk_child لحد ما المجموعة تتأكد —
 409:             // كده اصلی الـ confirm() المباشر لواحد منهم مرفوض من غير مراجعة.
 410:             AiPendingAction::whereIn('id', $ids)->where('status', 'pending')->update(['status' => 'bulk_child']);
 411:             $block = $outcome->uiBlock;
 412:             $block['type'] = 'bulk_plan';
 413:             $block['items'] = $items;
 414:             $block['typed_confirmation'] = 'تنفيذ';
 415: 
 416:             return ToolOutcome::proposal($block, $outcome->data);
 417:         });
 418:     }
