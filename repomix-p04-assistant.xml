<file path="bags-platform/backend/app/Services/CustomerAuthService.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Services;
  6: 
  7: use App\Enums\CustomerStatus;
  8: use App\Enums\CustomerType;
  9: use App\Exceptions\BusinessException;
 10: use App\Jobs\SendCustomerPasswordReset;
 11: use App\Models\Customer;
 12: use App\Models\CustomerAuditLog;
 13: use App\Notifications\Channels\CustomerSmsChannel;
 14: use App\Notifications\CustomerPasswordReset;
 15: use App\Rules\EmailNotUsedByOtherAccountType;
 16: use App\Rules\UniqueCustomerEmail;
 17: use Illuminate\Support\Facades\DB;
 18: use Illuminate\Support\Facades\Hash;
 19: use Illuminate\Support\Facades\Validator;
 20: use Illuminate\Support\Str;
 21: use Illuminate\Validation\ValidationException;
 22: 
 23: /**
 24:  * Customer authentication lifecycle coordinator (retail store and wholesale portal).
 25:  * Handles self-registration, credential authentication, password recovery, and token issuance.
 26:  * Security boundaries: sensitive attributes (type/status) are strictly assigned programmatically.
 27:  */
 28: class CustomerAuthService
 29: {
 30:     /** Resolve a unique trader contact email without treating it as verified. */
 31:     public function findForLogin(string $identifier): ?Customer
 32:     {
 33:         if (! str_contains($identifier, '@')) {
 34:             return Customer::query()->where('phone', Customer::normalizePhone($identifier))->first();
 35:         }
 36: 
 37:         $query = Customer::query()->whereRaw('LOWER(email) = ?', [mb_strtolower(trim($identifier))]);
 38:         $verified = (clone $query)->whereNotNull('email_verified_at')->first();
 39:         if ($verified !== null) {
 40:             return $verified;
 41:         }
 42:         $contacts = $query->limit(2)->get();
 43:         $customer = $contacts->count() === 1 ? $contacts->first() : null;
 44: 
 45:         return $customer !== null && in_array($customer->type, [CustomerType::Wholesale, CustomerType::Distributor], true)
 46:                 ? $customer : null;
 47:     }
 48: 
 49:     /**
 50:      * Generate or return a cached dummy bcrypt/hasher hash to prevent user-enumeration timing attacks.
 51:      */
 52:     public static function dummyHash(): string
 53:     {
 54:         if (config('hashing.driver', 'bcrypt') === 'bcrypt') {
 55:             return sprintf('$2y$%02d$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2uheWG/igi.', (int) config('hashing.bcrypt.rounds', 12));
 56:         }
 57:         static $hashes = [];
 58:         $key = json_encode(config('hashing'));
 59: 
 60:         return $hashes[$key] ??= Hash::make('not-a-customer-password');
 61:     }
 62: 
 63:     /**
 64:      * Compute HMAC key for phone/email to prevent rainbow-table reversal on small phone number spaces in audit logs.
 65:      */
 66:     private function identifierKey(string $identifier): string
 67:     {
 68:         return hash_hmac('sha256', $identifier, (string) config('app.key'));
 69:     }
 70: 
 71:     /**
 72:      * Self-register a retail store customer.
 73:      * Enforces Retail type and Approved status unconditionally.
 74:      */
 75:     public function registerRetail(array $data): Customer
 76:     {
 77:         return DB::transaction(function () use ($data): Customer {
 78:             $this->lockRegistrationEmail($data['email'] ?? null);
 79:             $verified = app(CustomerPhoneVerificationService::class)->consume($data);
 80: 
 81:             $customer = Customer::query()->create([
 82:                 'name' => $data['name'],
 83:                 'email' => $data['email'] ?? null,
 84:                 'phone' => $data['phone'],
 85:                 'password' => $data['password'],
 86:                 'type' => CustomerType::Retail,
 87:                 'status' => CustomerStatus::Approved,
 88:                 'phone_verified_at' => $verified ? now() : null,
 89:                 'approved_at' => now(),
 90:             ]);
 91:             CustomerAuditLog::record($customer, 'self_registered', null, ['channel' => 'store']);
 92: 
 93:             return $customer;
 94:         });
 95:     }
 96: 
 97:     /** Recheck registration rules while reserving the email until the surrounding transaction commits. */
 98:     public function lockRegistrationEmail(?string $email): void
 99:     {
100:         if ($email === null || trim($email) === '') {
101:             return;
102:         }
103:         if (DB::transactionLevel() === 0) {
104:             throw new \LogicException('Registration email claims require a transaction.');
105:         }
106:         $email = mb_strtolower(trim($email));
107:         DB::select('SELECT pg_advisory_xact_lock(hashtextextended(?, 0))', [$email]);
108:         Validator::make(['email' => $email], [
109:             'email' => [new UniqueCustomerEmail, new EmailNotUsedByOtherAccountType('customers')],
110:         ])->validate();
111:     }
112: 
113:     /**
114:      * Authenticate customer credentials via phone or verified email.
115:      * Suspended accounts are rejected with 403; pending/rejected wholesale accounts may log in
116:      * to check application status, with channel guards restricting subsequent actions.
117:      *
118:      * @throws BusinessException If credentials invalid or account suspended
119:      */
120:     public function login(string $identifier, string $password): Customer
121:     {
122:         $emailLogin = str_contains($identifier, '@');
123:         $identifier = $emailLogin ? mb_strtolower(trim($identifier)) : Customer::normalizePhone($identifier);
124:         $dummyHash = self::dummyHash();
125:         $customer = $this->findForLogin($identifier);
126: 
127:         $validPassword = Hash::check($password, $customer?->password ?? $dummyHash);
128:         if ($customer === null || ! $validPassword) {
129:             // Avoid inserting unbounded audit log rows for nonexistent identifiers during stuffing attacks;
130:             // log sampled info metric instead, keyed by HMAC.
131:             if ($customer === null) {
132:                 if (random_int(1, 10) === 1) {
133:                     logger()->info('customer.login_failed', ['identifier_key' => $this->identifierKey($identifier)]);
134:                 }
135:             } else {
136:                 defer(fn () => CustomerAuditLog::record($customer, 'login_failed', null, ['identifier_key' => $this->identifierKey($identifier)]))->always();
137:             }
138:             throw new BusinessException('بيانات الدخول غير صحيحة.', [], 401);
139:         }
140: 
141:         if ($customer->status === CustomerStatus::Suspended) {
142:             CustomerAuditLog::record($customer, 'login_failed', null, ['reason' => 'suspended']);
143:             throw new BusinessException(
144:                 'هذا الحساب موقوف.'.($customer->suspension_reason ? ' السبب: '.$customer->suspension_reason : ''),
145:                 ['suspension_reason' => $customer->suspension_reason],
146:                 403,
147:             );
148:         }
149: 
150:         if (Hash::needsRehash($customer->password)) {
151:             $original = $customer->password;
152:             $replacement = Hash::make($password);
153:             if ($customer->newQuery()->whereKey($customer->id)->where('password', $original)->update(['password' => $replacement]) !== 1) {
154:                 throw new BusinessException('بيانات الدخول غير صحيحة.', [], 401);
155:             }
156:             $customer->forceFill(['password' => $replacement])->syncOriginalAttribute('password');
157:         }
158:         CustomerAuditLog::record($customer, 'login_succeeded', null);
159: 
160:         return $customer;
161:     }
162: 
163:     /**
164:      * Initiate asynchronous password reset workflow.
165:      * Returns generic success regardless of account existence to prevent user enumeration.
166:      */
167:     public function forgotPassword(?string $email, ?string $phone): void
168:     {
169:         if (! $email && ! $phone) {
170:             return;
171:         }
172: 
173:         SendCustomerPasswordReset::dispatch($email, $phone)
174:             ->onConnection(config('auth.customer_password_reset.connection', 'database'));
175:     }
176: 
177:     /**
178:      * Generate password reset token and dispatch notification.
179:      * Enforces token throttling and message budget limits.
180:      */
181:     public function sendPasswordReset(?string $email, ?string $phone): void
182:     {
183:         if (! $email && ! $phone) {
184:             return;
185:         }
186: 
187:         $customer = Customer::query()
188:             ->when($email, fn ($q) => $q->whereNotNull('email_verified_at')->whereRaw('LOWER(email) = ?', [mb_strtolower(trim($email))]),
189:                 fn ($q) => $q->where('phone', Customer::normalizePhone($phone)))
190:             ->first();
191: 
192:         if ($customer === null || $customer->status === CustomerStatus::Suspended) {
193:             return;
194:         }
195: 
196:         $plainToken = Str::random(64);
197:         $key = $customer->getEmailForPasswordReset();
198: 
199:         $stored = DB::transaction(function () use ($customer, $key, $plainToken, $email): bool {
200:             $current = Customer::query()->lockForUpdate()->find($customer->id);
201:             if ($current === null || $current->status === CustomerStatus::Suspended) {
202:                 return false;
203:             }
204:             if ($email && ($current->email_verified_at === null || $current->email !== mb_strtolower(trim($email)))) {
205:                 return false;
206:             }
207:             $existing = DB::table('password_reset_tokens')->where('email', $key)->first();
208:             if ($existing && now()->subSeconds(60)->lt($existing->created_at)) {
209:                 return false;
210:             }
211:             if (! app(CustomerMessageBudget::class)->claim('reset:customer:'.$customer->id, sms: ! $email)) {
212:                 return false;
213:             }
214:             DB::table('password_reset_tokens')->updateOrInsert(
215:                 ['email' => $key], ['token' => hash('sha256', $plainToken), 'created_at' => now()],
216:             );
217: 
218:             return true;
219:         });
220:         if (! $stored) {
221:             return;
222:         }
223: 
224:         try {
225:             $customer->notify(new CustomerPasswordReset($plainToken, $email ? 'mail' : CustomerSmsChannel::class));
226:         } catch (\Throwable $exception) {
227:             report($exception);
228:         }
229:     }
230: 
231:     /**
232:      * Validate reset token and update customer password.
233:      * Revokes all active sessions upon successful reset.
234:      *
235:      * @throws BusinessException If token is invalid or expired
236:      */
237:     public function resetPassword(array $data): void
238:     {
239:         $dummyHash = self::dummyHash();
240:         DB::transaction(function () use ($data, $dummyHash): void {
241:             $customer = Customer::query()
242:                 ->when(! empty($data['email']), fn ($q) => $q->whereNotNull('email_verified_at')->whereRaw('LOWER(email) = ?', [mb_strtolower(trim($data['email']))]),
243:                     fn ($q) => $q->where('phone', $data['phone']))
244:                 ->lockForUpdate()->first();
245:             $key = $customer?->getEmailForPasswordReset();
246:             $row = DB::table('password_reset_tokens')->where('email', $key)->lockForUpdate()->first();
247:             $storedToken = $row?->token ?? '';
248:             $validToken = strlen($storedToken) === 64 ? hash_equals($storedToken, hash('sha256', $data['token']))
249:                 : Hash::check($data['token'], $storedToken ?: $dummyHash);
250:             if ($customer === null || $customer->status === CustomerStatus::Suspended || $row === null
251:                 || $row->created_at === null || now()->subMinutes(60)->gte($row->created_at)
252:                 || now()->lt($row->created_at) || ! $validToken) {
253:                 throw new BusinessException('رمز الاستعادة غير صالح أو انتهت صلاحيته.');
254:             }
255:             if (in_array($customer->type, [CustomerType::Wholesale, CustomerType::Distributor], true)
256:                 && mb_strlen($data['password']) < 12) {
257:                 throw ValidationException::withMessages(['password' => 'كلمة المرور يجب أن تكون 12 حرفًا على الأقل.']);
258:             }
259:             $customer->forceFill(['password' => $data['password'], 'remember_token' => Str::random(60)])->save();
260:             $customer->tokens()->delete();
261:             DB::table('password_reset_tokens')->where('email', $key)->delete();
262:             CustomerAuditLog::record($customer, 'password_reset', null);
263:         });
264:     }
265: 
266:     /**
267:      * Issue a channel-scoped Sanctum access token (e.g. store-token, wholesale-token).
268:      * Prunes expired tokens and limits maximum active concurrent sessions.
269:      *
270:      * @throws BusinessException If account is suspended
271:      */
272:     public function issueToken(Customer $customer, string $name): string
273:     {
274:         return DB::transaction(function () use ($customer, $name): string {
275:             $customer = Customer::query()->lockForUpdate()->findOrFail($customer->id);
276:             if ($customer->status === CustomerStatus::Suspended) {
277:                 throw new BusinessException('هذا الحساب موقوف.', [], 403);
278:             }
279: 
280:             $expiry = config('sanctum.expiration');
281:             $customer->tokens()->where(fn ($q) => $q->where('expires_at', '<=', now())
282:                 ->when($expiry, fn ($q) => $q->orWhere('created_at', '<=', now()->subMinutes((int) $expiry))))->delete();
283:             $limit = max(1, (int) config('auth.customer_max_tokens', 10));
284:             $old = $customer->tokens()->orderByDesc('id')->skip($limit - 1)->pluck('id');
285:             if ($old->isNotEmpty()) {
286:                 $customer->tokens()->whereIn('id', $old)->delete();
287:             }
288: 
289:             $token = $customer->createToken($name, ['*'], now()->addMinutes(max(1, (int) config('auth.customer_token_minutes', 1440))));
290:             CustomerAuditLog::record($customer, 'token_issued', null, ['token_id' => $token->accessToken->id, 'channel' => $name]);
291: 
292:             return $token->plainTextToken;
293:         });
294:     }
295: }
</file>

<file path="bags-platform/backend/app/Services/CustomerManagementService.php">
  1: <?php
  2: 
  3: declare(strict_types=1);
  4: 
  5: namespace App\Services;
  6: 
  7: use App\Enums\CustomerDocumentStatus;
  8: use App\Enums\CustomerDocumentType;
  9: use App\Enums\CustomerStatus;
 10: use App\Enums\CustomerType;
 11: use App\Events\WholesaleApplicationReviewed;
 12: use App\Exceptions\BusinessException;
 13: use App\Models\Customer;
 14: use App\Models\CustomerAuditLog;
 15: use App\Models\CustomerDocument;
 16: use Illuminate\Contracts\Pagination\LengthAwarePaginator;
 17: use Illuminate\Http\UploadedFile;
 18: use Illuminate\Support\Facades\DB;
 19: use Illuminate\Support\Str;
 20: 
 21: /**
 22:  * Customer administration and lifecycle management (CRUD, wholesale verification, approval, rejection, and suspension).
 23:  * Immediate suspension invalidates all active sessions; rejection keeps tokens active to review rejection reasons.
 24:  */
 25: class CustomerManagementService
 26: {
 27:     /**
 28:      * Paginate customers with search, type, and status filtering.
 29:      */
 30:     public function paginate(array $filters): LengthAwarePaginator
 31:     {
 32:         return Customer::query()
 33:             ->with('customerGroup')
 34:             ->when(($filters['trashed'] ?? null) === 'only', fn ($q) => $q->onlyTrashed())
 35:             ->when($filters['business_only'] ?? false, fn ($q) => $q->whereIn('type', ['wholesale', 'distributor']))
 36:             ->when($filters['type'] ?? null, fn ($q, $v) => $q->where('type', $v))
 37:             ->when($filters['status'] ?? null, fn ($q, $v) => $q->where('status', $v))
 38:             ->when($filters['customer_group_id'] ?? null, fn ($q, $v) => $q->where('customer_group_id', $v))
 39:             ->when($filters['search'] ?? null, fn ($q, $v) => $q->whereLike('search_text', SearchTerm::pattern($v), caseSensitive: false))
 40:             ->orderByDesc('id')
 41:             ->paginate($filters['per_page'] ?? 15)->withQueryString();
 42:     }
 43: 
 44:     /**
 45:      * Retrieve customer with complete profile relations.
 46:      */
 47:     public function find(int $id): Customer
 48:     {
 49:         return Customer::query()
 50:             ->with(['customerGroup', 'documents', 'addresses.city', 'approver'])
 51:             ->findOrFail($id);
 52:     }
 53: 
 54:     /**
 55:      * Create customer record from admin console.
 56:      * Enforces Approved status for retail and Pending for wholesale accounts.
 57:      *
 58:      * @throws BusinessException If attempting to directly create an approved wholesale account
 59:      */
 60:     public function create(array $data, ?int $actorId = null): Customer
 61:     {
 62:         $data['type'] ??= CustomerType::Retail->value;
 63:         $data['credit_limit'] ??= 0;
 64:         // Default status by type unless explicitly provided: retail is approved, wholesale requires review
 65:         $data['status'] ??= ($data['type'] ?? CustomerType::Retail->value) === CustomerType::Retail->value
 66:             ? CustomerStatus::Approved
 67:             : CustomerStatus::Pending;
 68: 
 69:         if ($data['status'] === CustomerStatus::Approved || $data['status'] === CustomerStatus::Approved->value) {
 70:             if ($data['type'] !== CustomerType::Retail->value) {
 71:                 throw new BusinessException('أنشئ حساب الجملة قيد المراجعة ثم استخدم مسار الاعتماد.');
 72:             }
 73:         }
 74: 
 75:         return DB::transaction(function () use ($data, $actorId): Customer {
 76:             if (in_array($data['status'], [CustomerStatus::Approved, CustomerStatus::Approved->value], true)) {
 77:                 $data['approved_at'] = now();
 78:                 $data['approved_by'] = $actorId;
 79:             }
 80:             $customer = Customer::query()->create($data);
 81:             CustomerAuditLog::record($customer, 'created', $actorId);
 82: 
 83:             return $customer->load('customerGroup');
 84:         });
 85:     }
 86: 
 87:     /**
 88:      * Update customer profile, credentials, and business identity.
 89:      * Invalidates active sessions and reset tokens if credentials change.
 90:      */
 91:     public function update(Customer $customer, array $data, ?int $actorId = null): Customer
 92:     {
 93:         return DB::transaction(function () use ($customer, $data, $actorId): Customer {
 94:             $customer = Customer::query()->lockForUpdate()->findOrFail($customer->id);
 95:             if (isset($data['type']) && $data['type'] !== $customer->type->value) {
 96:                 throw new BusinessException('تغيير نوع الحساب المعتمد يتطلب استخدام مسار الاعتماد.');
 97:             }
 98:             if ($customer->status === CustomerStatus::Approved && $customer->type !== CustomerType::Retail) {
 99:                 foreach (['company_name', 'tax_number', 'commercial_register'] as $field) {
100:                     if (array_key_exists($field, $data) && blank($data[$field])) {
101:                         throw new BusinessException('لا يمكن مسح بيانات الجملة لحساب معتمد.', [$field => ['هذا الحقل مطلوب.']]);
102:                     }
103:                 }
104:             }
105:             $businessIdentityChanged = collect(['company_name', 'tax_number', 'commercial_register'])
106:                 ->contains(fn ($field) => array_key_exists($field, $data) && $data[$field] !== $customer->{$field});
107:             $credentialsChanged = array_key_exists('password', $data)
108:                 || (isset($data['email']) && $data['email'] !== $customer->email)
109:                 || (isset($data['phone']) && $data['phone'] !== $customer->phone)
110:                 || (array_key_exists('email', $data) && $data['email'] === null && $customer->email !== null);
111:             if (isset($data['phone']) && $data['phone'] !== $customer->phone) {
112:                 $customer->forceFill(['phone_verified_at' => null]);
113:             }
114:             $customer->fill($data);
115:             if ($credentialsChanged) {
116:                 $customer->forceFill(['remember_token' => Str::random(60)]);
117:                 $customer->tokens()->delete();
118:                 DB::table('password_reset_tokens')->where('email', $customer->getEmailForPasswordReset())->delete();
119:             }
120:             $customer->save();
121:             CustomerAuditLog::record($customer, $credentialsChanged ? 'credentials_changed' : 'updated', $actorId, ['fields' => array_keys($data)]);
122:             if ($businessIdentityChanged) {
123:                 CustomerAuditLog::record($customer, 'business_identity_changed', $actorId, ['fields' => array_keys(array_intersect_key($data, array_flip(['company_name', 'tax_number', 'commercial_register'])))]);
124:             }
125: 
126:             return $customer->load('customerGroup');
127:         });
128:     }
129: 
130:     /**
131:      * Soft-delete customer and revoke all active tokens/sessions.
132:      */
133:     public function delete(Customer $customer, ?int $actorId = null): void
134:     {
135:         DB::transaction(function () use ($customer, $actorId): void {
136:             $customer = Customer::query()->lockForUpdate()->findOrFail($customer->id);
137:             $customer->tokens()->delete();
138:             DB::table('password_reset_tokens')->where('email', $customer->getEmailForPasswordReset())->delete();
139:             CustomerAuditLog::record($customer, 'deleted', $actorId);
140:             $customer->delete();
141:         });
142:     }
143: 
144:     /**
145:      * Approve customer application (wholesale/distributor).
146:      * Validates verified supporting documents and assigns group, credit limit, and approver timestamp.
147:      *
148:      * @throws BusinessException If documents unverified or required legal info missing
149:      */
150:     public function approve(Customer $customer, array $data, int $adminId): Customer
151:     {
152:         return DB::transaction(function () use ($customer, $data, $adminId): Customer {
153:             $customer = Customer::query()->lockForUpdate()->findOrFail($customer->id);
154:             if ($customer->status === CustomerStatus::Approved && ($data['type'] ?? $customer->type->value) === $customer->type->value) {
155:                 throw new BusinessException('هذا الحساب معتمد بالفعل.');
156:             }
157:             $legal = [];
158:             if ($customer->documents()->where('status', '!=', 'verified')->exists()) {
159:                 throw new BusinessException('راجع واعتمد جميع المستندات المرفقة قبل اعتماد الحساب.');
160:             }
161:             if (($data['type'] ?? $customer->type->value) !== CustomerType::Retail->value) {
162:                 if (! $customer->documents()->where('status', 'verified')->exists()) {
163:                     throw new BusinessException('يلزم مستند موثّق واحد على الأقل لاعتماد حساب الجملة أو الموزع.');
164:                 }
165:                 foreach (['company_name', 'tax_number', 'commercial_register'] as $field) {
166:                     $legal[$field] = $data[$field] ?? $customer->{$field};
167:                     if (blank($legal[$field])) {
168:                         throw new BusinessException('بيانات الجملة مطلوبة قبل الاعتماد.', [$field => ['هذا الحقل مطلوب لاعتماد حساب الجملة أو الموزع.']]);
169:                     }
170:                 }
171:             }
172: 
173:             $customer->update([
174:                 ...$legal,
175:                 'status' => CustomerStatus::Approved,
176:                 'approved_by' => $adminId,
177:                 'approved_at' => now(),
178:                 'rejection_reason' => null,
179:                 'suspension_reason' => null,
180:                 'customer_group_id' => array_key_exists('customer_group_id', $data) ? $data['customer_group_id'] : $customer->customer_group_id,
181:                 'credit_limit' => $data['credit_limit'] ?? $customer->credit_limit,
182:                 'type' => $data['type'] ?? $customer->type,
183:             ]);
184:             CustomerAuditLog::record($customer, 'approved', $adminId, ['type' => $customer->type->value, 'credit_limit' => $customer->credit_limit, 'customer_group_id' => $customer->customer_group_id]);
185: 
186:             if ($customer->type !== CustomerType::Retail) {
187:                 WholesaleApplicationReviewed::dispatch($customer, 'approved');
188:             }
189: 
190:             return $customer->load(['customerGroup', 'documents']);
191:         });
192:     }
193: 
194:     /**
195:      * Reject a pending customer application with a recorded reason.
196:      *
197:      * @throws BusinessException If customer is not in Pending status
198:      */
199:     public function reject(Customer $customer, string $reason, ?int $actorId = null): Customer
200:     {
201:         return DB::transaction(function () use ($customer, $reason, $actorId): Customer {
202:             $customer = Customer::query()->lockForUpdate()->findOrFail($customer->id);
203:             if ($customer->status !== CustomerStatus::Pending) {
204:                 throw new BusinessException('يمكن رفض الطلبات قيد المراجعة فقط؛ استخدم الإيقاف للحسابات المعتمدة.');
205:             }
206: 
207:             $customer->update([
208:                 'status' => CustomerStatus::Rejected,
209:                 'rejection_reason' => $reason,
210:             ]);
211:             CustomerAuditLog::record($customer, 'rejected', $actorId, ['reason' => $reason]);
212: 
213:             if ($customer->type !== CustomerType::Retail) {
214:                 WholesaleApplicationReviewed::dispatch($customer, 'rejected', $reason);
215:             }
216: 
217:             return $customer->load(['customerGroup', 'documents']);
218:         });
219:     }
220: 
221:     /**
222:      * Suspend customer account and revoke all active sessions immediately.
223:      */
224:     public function suspend(Customer $customer, string $reason, ?int $actorId = null): Customer
225:     {
226:         return DB::transaction(function () use ($customer, $reason, $actorId): Customer {
227:             $customer = Customer::query()->lockForUpdate()->findOrFail($customer->id);
228:             if ($customer->status === CustomerStatus::Suspended) {
229:                 throw new BusinessException('هذا الحساب موقوف بالفعل.');
230:             }
231:             $customer->update([
232:                 'status' => CustomerStatus::Suspended,
233:                 'suspension_reason' => $reason,
234:             ]);
235:             $customer->tokens()->delete();
236:             DB::table('password_reset_tokens')->where('email', $customer->getEmailForPasswordReset())->delete();
237:             CustomerAuditLog::record($customer, 'suspended', $actorId, ['reason' => $reason]);
238: 
239:             return $customer->load('customerGroup');
240:         });
241:     }
242: 
243:     /**
244:      * Restore a soft-deleted customer account.
245:      */
246:     public function restore(Customer $customer, ?int $actorId): Customer
247:     {
248:         return DB::transaction(function () use ($customer, $actorId): Customer {
249:             $customer = Customer::withTrashed()->lockForUpdate()->findOrFail($customer->id);
250:             if (! $customer->trashed()) {
251:                 throw new BusinessException('الحساب غير محذوف.');
252:             }
253:             $customer->restore();
254:             CustomerAuditLog::record($customer, 'restored', $actorId);
255: 
256:             return $customer->load('customerGroup');
257:         });
258:     }
259: 
260:     /**
261:      * Review supporting customer verification document status (verified/rejected).
262:      */
263:     public function reviewDocument(Customer $customer, CustomerDocument $document, string $status, int $actorId): CustomerDocument
264:     {
265:         return DB::transaction(function () use ($customer, $document, $status, $actorId) {
266:             $customer = Customer::query()->lockForUpdate()->findOrFail($customer->id);
267:             $document = $customer->documents()->whereKey($document->id)->lockForUpdate()->firstOrFail();
268:             $document->forceFill(['status' => $status, 'reviewed_by' => $actorId, 'reviewed_at' => now()])->save();
269:             CustomerAuditLog::record($customer, 'document_reviewed', $actorId, ['document_id' => $document->id, 'status' => $status]);
270: 
271:             return $document;
272:         });
273:     }
274: 
275:     /**
276:      * Store and associate a private customer document up to a limit of 5 documents.
277:      */
278:     public function uploadDocument(Customer $customer, UploadedFile $file, int $actorId): CustomerDocument
279:     {
280:         return PrivateAttachments::transaction(function (PrivateAttachments $files) use ($customer, $file, $actorId): CustomerDocument {
281:             $customer = Customer::whereKey($customer->id)->lockForUpdate()->firstOrFail();
282:             if ($customer->type === CustomerType::Retail || $customer->documents()->count() >= 5) {
283:                 throw new BusinessException('رفع المستندات متاح للتجار والموزعين بحد أقصى 5 مستندات.');
284:             }
285: 
286:             $path = $files->store($file, 'customer_documents/'.$customer->id);
287:             $document = $customer->documents()->create([
288:                 'document_type' => CustomerDocumentType::Other,
289:                 'file_path' => $path,
290:                 'original_name' => CustomerDocument::safeName($file->getClientOriginalName()),
291:                 'mime_type' => $file->getMimeType(),
292:                 'status' => CustomerDocumentStatus::Pending,
293:             ]);
294:             CustomerAuditLog::record($customer, 'document_uploaded', $actorId, ['document_id' => $document->id]);
295: 
296:             return $document;
297:         }, [[$file, 'customer_documents/'.$customer->id]]);
298:     }
299: }
