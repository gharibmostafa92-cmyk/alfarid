{
    "output":  {
                   "filePath":  "repomix/outputs/repomix-backoffice-operations.xml",
                   "style":  "xml",
                   "parsableStyle":  true,
                   "fileSummary":  true,
                   "directoryStructure":  true,
                   "removeComments":  false,
                   "removeEmptyLines":  true,
                   "topFilesLength":  20,
                   "showLineNumbers":  true,
                   "copyToClipboard":  false,
                   "instructionFilePath":  "repomix/instructions/audit-security-prompt.md",
                   "headerText":  "DOMAIN: ADMIN BACKOFFICE APPLICATION \u0026 UNIFIED NOTIFICATIONS\nAuditing React 19 Backoffice operations portal, staff administration, system activity logs, notification channels, and rate-limited notification scale."
               },
    "include":  [
                    "bags-platform/backend/app/Notifications/**",
                    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Staff*.php",
                    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Settings*.php",
                    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Dashboard*.php",
                    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Activity*.php",
                    "bags-platform/frontend/apps/backoffice/src/**",
                    "bags-platform/frontend/apps/backoffice/package.json"
                ],
    "ignore":  {
                   "useGitignore":  true,
                   "useDefaultPatterns":  true,
                   "customPatterns":  [
                                          "**/tests/**",
                                          "**/*.test.*",
                                          "**/*.spec.*",
                                          "**/vendor/**",
                                          "**/node_modules/**",
                                          "**/.git/**",
                                          "**/storage/**",
                                          "**/*.log",
                                          "**/dist/**"
                                      ]
               }
}
