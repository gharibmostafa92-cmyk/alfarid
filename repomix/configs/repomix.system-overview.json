{
  "output": {
    "filePath": "repomix/outputs/started/repomix-system-overview.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "instructionFilePath": "repomix/instructions/audit-performance-prompt.md",
    "headerText": "DOMAIN: SYSTEM SKELETON & GLOBAL ARCHITECTURAL TOPOLOGY\nHigh-level architectural map: composer & package manifests, bootstrap lifecycles, route registrars, service providers, and database seeder orchestrations."
  },
  "include": [
    "README.md",
    "bags-platform/backend/composer.json",
    "bags-platform/backend/bootstrap/**",
    "bags-platform/backend/routes/web.php",
    "bags-platform/backend/routes/console.php",
    "bags-platform/backend/routes/api/*.php",
    "bags-platform/backend/app/Providers/**",
    "bags-platform/backend/database/seeders/DatabaseSeeder.php",
    "bags-platform/frontend/package.json",
    "bags-platform/frontend/turbo.json",
    "bags-platform/frontend/packages/api-client/src/index.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/*.log"
    ]
  }
}
