{
  "output": {
    "filePath": "repomix/outputs/started/repomix-system-overview.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "instructionFilePath": "repomix/instructions/audit-performance-prompt.md",
    "headerText": "DOMAIN: SYSTEM SKELETON & GLOBAL ARCHITECTURAL TOPOLOGY\nHigh-level architectural map: composer & package manifests, bootstrap lifecycles, route registrars, service providers, configuration, and database seeder orchestrations."
  },
  "include": [
    "README.md",
    "docs/TASK_DEPLOYMENT_STATUS.md",
    "docs/TASKS_EXECUTION_AUDIT.md",
    ".github/workflows/*.yml",
    "bags-platform/backend/composer.json",
    "bags-platform/backend/config/*.php",
    "bags-platform/backend/.env.example",
    "bags-platform/backend/bootstrap/**",
    "bags-platform/backend/app/Http/Middleware/**",
    "bags-platform/backend/routes/web.php",
    "bags-platform/backend/routes/console.php",
    "bags-platform/backend/routes/api/*.php",
    "bags-platform/backend/app/Providers/**",
    "bags-platform/backend/database/seeders/*.php",
    "bags-platform/infrastructure/cloud-run/pilot.ps1",
    "bags-platform/frontend/apps/storefront/src/lib/core/cloud-run-api.ts",
    "bags-platform/frontend/apps/storefront/src/app/api/v1/[...path]/route.ts",
    "bags-platform/frontend/package.json",
    "bags-platform/frontend/turbo.json",
    "bags-platform/frontend/packages/api-client/src/index.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/*.log",
      "**/dist/**",
      "**/.next/**",
      "repomix/outputs/**"
    ]
  }
}
