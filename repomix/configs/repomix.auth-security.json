{
  "output": {
    "filePath": "repomix/outputs/started/repomix-auth-security.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "truncateBase64": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "instructionFilePath": "repomix/instructions/audit-security-prompt.md",
    "headerText": "DOMAIN: AUTHENTICATION, MULTI-GUARD RBAC & SECURITY BOUNDARIES\nAuditing multi-guard Sanctum isolation, Spatie permissions, token security, staff actions, and authorization middleware across Admin, Cashier, Customer, and Staff."
  },
  "include": [
    "bags-platform/backend/routes/api/auth.php",
    "bags-platform/backend/routes/api/admin.php",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Auth/**",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Auth/**",
    "bags-platform/backend/app/Http/Requests/Api/V1/Auth/**",
    "bags-platform/backend/app/Http/Requests/Admin/Auth/**",
    "bags-platform/backend/app/Http/Requests/Concerns/**",
    "bags-platform/backend/app/Http/Requests/ClassAliases.php",
    "bags-platform/backend/app/Http/Middleware/Ensure*",
    "bags-platform/backend/app/Http/Middleware/AuditStaffAdministration.php",
    "bags-platform/backend/app/Services/Auth/**",
    "bags-platform/backend/app/Actions/Staff/**",
    "bags-platform/backend/app/Rules/**",
    "bags-platform/backend/app/Models/User.php",
    "bags-platform/backend/app/Models/Staff.php",
    "bags-platform/backend/app/Models/Customer.php",
    "bags-platform/backend/config/auth.php",
    "bags-platform/backend/config/sanctum.php",
    "bags-platform/backend/config/permission.php",
    "bags-platform/backend/database/migrations/*users*.php",
    "bags-platform/backend/database/migrations/*staff*.php",
    "bags-platform/backend/database/migrations/*permission*.php",
    "bags-platform/backend/database/migrations/*personal_access_tokens*.php",
    "bags-platform/backend/database/migrations/*token*.php",
    "bags-platform/backend/database/migrations/*roles*.php",
    "bags-platform/backend/database/migrations/*auth_lookup*.php",
    "bags-platform/backend/database/migrations/*must_change_password*.php",
    "bags-platform/backend/database/migrations/*scope_phone_unique*.php",
    "bags-platform/backend/database/migrations/*floor_staff_audit_retention*.php",
    "bags-platform/backend/database/seeders/RolePermissionSeeder.php",
    "bags-platform/frontend/packages/api-client/src/endpoints/auth.ts",
    "bags-platform/frontend/apps/storefront/src/services/auth.service.ts",
    "bags-platform/frontend/apps/storefront/src/components/auth/LoginScreen.tsx",
    "bags-platform/frontend/apps/backoffice/src/components/auth/**",
    "bags-platform/frontend/apps/backoffice/src/stores/auth.store.ts",
    "bags-platform/frontend/apps/backoffice/src/stores/mappers.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/*.log",
      "**/dist/**"
    ]
  }
}
