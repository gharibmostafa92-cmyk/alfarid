{
  "output": {
    "filePath": "repomix/outputs/started/repomix-media-attachments.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "instructionFilePath": "repomix/instructions/audit-security-prompt.md",
    "headerText": "DOMAIN: PRIVATE ATTACHMENTS, CLOUDFLARE R2 OBJECT STORAGE & MEDIA PIPELINES\nAuditing signed URL expiration, path traversal guards, attachment privatization, R2 upload migration, and automated orphan media pruning."
  },
  "include": [
    "bags-platform/backend/app/Services/Media/**",
    "bags-platform/backend/app/Services/Shared/PrivateAttachments.php",
    "bags-platform/backend/app/Services/Catalog/ProductMediaService.php",
    "bags-platform/backend/app/Http/Controllers/Api/V1/AttachmentController.php",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Ai/AiAttachmentController.php",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Catalog/ProductMediaController.php",
    "bags-platform/backend/app/Http/Requests/Admin/Catalog/*Media*.php",
    "bags-platform/backend/app/Http/Resources/MediaResource.php",
    "bags-platform/backend/app/Support/CatalogMedia.php",
    "bags-platform/backend/app/Support/ContentDisposition.php",
    "bags-platform/backend/app/Support/StorageCleanupOwner.php",
    "bags-platform/backend/config/filesystems.php",
    "bags-platform/backend/app/Console/Commands/Orders/PrivatizeReturnAttachments.php",
    "bags-platform/backend/app/Console/Commands/Maintenance/*Media*.php",
    "bags-platform/backend/app/Console/Commands/Maintenance/*Attachment*.php",
    "bags-platform/backend/app/Models/AiAttachment.php",
    "bags-platform/backend/app/Models/ProductMedia.php",
    "bags-platform/backend/config/media-library.php",
    "bags-platform/backend/database/migrations/*media*.php",
    "bags-platform/backend/database/migrations/*attachment*.php",
    "bags-platform/backend/database/migrations/*index_private_attachment_paths*.php"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/*.log"
    ]
  }
}
