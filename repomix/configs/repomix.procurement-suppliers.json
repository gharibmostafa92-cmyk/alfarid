{
    "output":  {
                   "filePath":  "repomix/outputs/repomix-procurement-suppliers.xml",
                   "style":  "xml",
                   "parsableStyle":  true,
                   "fileSummary":  true,
                   "directoryStructure":  true,
                   "removeComments":  false,
                   "removeEmptyLines":  true,
                   "topFilesLength":  20,
                   "showLineNumbers":  true,
                   "copyToClipboard":  false,
                   "instructionFilePath":  "repomix/instructions/audit-security-prompt.md",
                   "headerText":  "DOMAIN: PROCUREMENT, SUPPLIER ORDERS \u0026 GOODS INWARD\nAuditing purchase order workflows, receipt vs PO quantity discrepancies, supplier accounts \u0026 debts, and supplier portal authentication."
               },
    "include":  [
                    "bags-platform/backend/app/Services/Procurement/**",
                    "bags-platform/backend/app/Events/Procurement/**",
                    "bags-platform/backend/app/Listeners/Procurement/**",
                    "bags-platform/backend/app/Models/Supplier.php",
                    "bags-platform/backend/app/Models/SupplierUser.php",
                    "bags-platform/backend/app/Models/PurchaseOrder.php",
                    "bags-platform/backend/app/Models/PurchaseOrderItem.php",
                    "bags-platform/backend/app/Models/PurchaseRequest.php",
                    "bags-platform/backend/app/Models/PurchaseRequestItem.php",
                    "bags-platform/backend/app/Models/SupplierDelivery.php",
                    "bags-platform/backend/app/Models/SupplierDeliveryItem.php",
                    "bags-platform/backend/app/Models/SupplierInvoice.php",
                    "bags-platform/backend/app/Models/SupplierPayment.php",
                    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Procurement/**",
                    "bags-platform/backend/app/Http/Controllers/Api/V1/Supplier/**",
                    "bags-platform/backend/routes/api/supplier.php",
                    "bags-platform/backend/database/migrations/*supplier*.php",
                    "bags-platform/backend/database/migrations/*purchase_order*.php",
                    "bags-platform/frontend/packages/api-client/src/endpoints/operations/suppliers.ts"
                ],
    "ignore":  {
                   "useGitignore":  true,
                   "useDefaultPatterns":  true,
                   "customPatterns":  [
                                          "**/tests/**",
                                          "**/*.test.*",
                                          "**/*.spec.*",
                                          "**/vendor/**",
                                          "**/node_modules/**",
                                          "**/.git/**",
                                          "**/storage/**",
                                          "**/*.log"
                                      ]
               }
}
