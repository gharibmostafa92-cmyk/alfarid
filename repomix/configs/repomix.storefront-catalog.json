{
  "output": {
    "filePath": "repomix/outputs/repomix-storefront-catalog.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "truncateBase64": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "instructionFilePath": "repomix/instructions/audit-security-prompt.md",
    "headerText": "DOMAIN: CUSTOMER STOREFRONT, PRODUCT CATALOG & ONLINE CHECKOUT\nAuditing Next.js 15 customer storefront application, public catalog caching, shopping cart security, customer abuse protections, and checkout tampering."
  },
  "include": [
    "bags-platform/backend/app/Services/Catalog/**",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Store/**",
    "bags-platform/backend/routes/api/store.php",
    "bags-platform/backend/tests/Feature/Store/**",
    "bags-platform/frontend/packages/api-client/src/endpoints/catalog.ts",
    "bags-platform/frontend/packages/api-client/src/endpoints/store.ts",
    "bags-platform/frontend/apps/storefront/src/**",
    "bags-platform/frontend/apps/storefront/next.config.mjs",
    "bags-platform/frontend/apps/storefront/package.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/*.log",
      "**/.next/**",
      "**/assets/luxuryAuthAssets.ts"
    ]
  }
}
