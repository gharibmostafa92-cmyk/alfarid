{
  "output": {
    "filePath": "repomix/outputs/repomix-shipping-logistics.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "instructionFilePath": "repomix/instructions/audit-security-prompt.md",
    "headerText": "DOMAIN: SHIPPING, CARRIER LOGISTICS & DELIVERY WEBHOOKS\nAuditing shipping rate calculation, zone pricing, carrier contracts, delivery tracking webhooks, and shipping quote concurrency."
  },
  "include": [
    "bags-platform/backend/app/Models/Shipment.php",
    "bags-platform/backend/app/Models/ShippingCompany.php",
    "bags-platform/backend/app/Models/ShippingRate.php",
    "bags-platform/backend/app/Models/ShippingZone.php",
    "bags-platform/backend/app/Models/City.php",
    "bags-platform/backend/app/Services/Orders/ShipmentService.php",
    "bags-platform/backend/app/Services/Orders/ShippingQuoteService.php",
    "bags-platform/backend/app/Services/Orders/ShippingWebhookService.php",
    "bags-platform/backend/database/migrations/*shipping*.php",
    "bags-platform/backend/database/migrations/*shipment*.php",
    "bags-platform/backend/database/seeders/ShippingPermissionSeeder.php",
    "bags-platform/backend/tests/Feature/Shipping/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/*.log"
    ]
  }
}
