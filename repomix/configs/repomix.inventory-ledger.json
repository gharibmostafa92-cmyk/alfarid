{
  "output": {
    "filePath": "repomix/outputs/repomix-inventory-ledger.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 20,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "instructionFilePath": "repomix/instructions/audit-performance-prompt.md",
    "headerText": "DOMAIN: INVENTORY DOUBLE-ENTRY LEDGER & CONCURRENCY ENGINE\nAuditing immutable stock movements, pessimistic row locking (lockForUpdate), branch transfers, stocktakes, and negative stock invariant guards."
  },
  "include": [
    "bags-platform/backend/app/Services/Inventory/**",
    "bags-platform/backend/app/Services/DiscreteQuantity.php",
    "bags-platform/backend/app/Actions/Branches/**",
    "bags-platform/backend/app/Actions/Locations/**",
    "bags-platform/backend/app/Events/Inventory/**",
    "bags-platform/backend/app/Listeners/Inventory/**",
    "bags-platform/backend/app/Console/Commands/Operations/*Inventory*.php",
    "bags-platform/backend/app/Models/Product.php",
    "bags-platform/backend/app/Models/ProductVariant.php",
    "bags-platform/backend/app/Models/StockMovement.php",
    "bags-platform/backend/app/Models/StockLevel.php",
    "bags-platform/backend/app/Models/StockTransfer.php",
    "bags-platform/backend/app/Models/StockTransferItem.php",
    "bags-platform/backend/app/Models/Stocktake.php",
    "bags-platform/backend/app/Models/StocktakeItem.php",
    "bags-platform/backend/app/Models/StocktakeScan.php",
    "bags-platform/backend/app/Models/Branch.php",
    "bags-platform/backend/app/Models/Location.php",
    "bags-platform/backend/app/Models/InventoryReconcileRun.php",
    "bags-platform/backend/app/Enums/*Stock*",
    "bags-platform/backend/app/Enums/*Inventory*",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/Inventory/**",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/ProductController.php",
    "bags-platform/backend/app/Http/Controllers/Api/V1/Admin/ProductVariantController.php",
    "bags-platform/backend/database/migrations/*stock_movement*.php",
    "bags-platform/backend/database/migrations/*products*.php",
    "bags-platform/backend/database/migrations/*inventory*.php",
    "bags-platform/backend/tests/Feature/Admin/Inventory/**",
    "bags-platform/frontend/packages/api-client/src/endpoints/inventory.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/storage/**",
      "**/*.log"
    ]
  }
}
