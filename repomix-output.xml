<file path="bags-platform/backend/tests/Feature/AdminSettingsEndpointsTest.php">
<?php

declare(strict_types=1);

namespace Tests\Feature;

use App\Models\Setting;
use App\Models\User;
use App\Services\SettingService;
use Database\Seeders\SettingSeeder;
use Illuminate\Foundation\Testing\LazilyRefreshDatabase;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Cache;
use Spatie\Permission\Models\Permission;
use Tests\TestCase;

class AdminSettingsEndpointsTest extends TestCase
{
    use LazilyRefreshDatabase;

    public function test_admin_can_read_grouped_settings_with_typed_values(): void
    {
        $this->seedSettings();
        $token = $this->staffWithSettingsPermission()->createToken('settings-test')->plainTextToken;

        $this->requestWithToken($token, 'GET', '/api/v1/admin/settings')
            ->assertOk()
            ->assertJsonPath('data.tax.tax_enabled', false)
            ->assertJsonPath('data.tax.default_tax_rate', 14)
            ->assertJsonPath('data.numbering.invoice_next_number', 1000)
            ->assertJsonPath('data.company.company_name', 'Alfarid');
    }

    public function test_admin_can_update_settings_and_cache_is_invalidated(): void
    {
        $this->seedSettings();
        $service = app(SettingService::class);
        $this->assertSame(14.0, $service->get('default_tax_rate'));
        $token = $this->staffWithSettingsPermission()->createToken('settings-test')->plainTextToken;

        $this->requestWithToken($token, 'PUT', '/api/v1/admin/settings', [
            'company_name' => 'Alfarid Trading',
            'tax_enabled' => true,
            'default_tax_rate' => 15,
            'order_next_number' => 2000,
        ])->assertOk()
            ->assertJsonPath('data.company.company_name', 'Alfarid Trading')
            ->assertJsonPath('data.tax.tax_enabled', true)
            ->assertJsonPath('data.tax.default_tax_rate', 15)
            ->assertJsonPath('data.numbering.order_next_number', 2000);

        $this->assertSame('Alfarid Trading', $service->get('company_name'));
        $this->assertDatabaseHas('settings', ['key' => 'tax_enabled', 'value' => '1']);
    }

    public function test_update_validates_tax_rates_counters_and_unknown_keys(): void
    {
        $this->seedSettings();
        $token = $this->staffWithSettingsPermission()->createToken('settings-test')->plainTextToken;

        $this->requestWithToken($token, 'PUT', '/api/v1/admin/settings', [
            'default_tax_rate' => 101,
            'invoice_next_number' => 0,
            'unknown_option' => 'value',
        ])->assertUnprocessable()
            ->assertJsonValidationErrors(['default_tax_rate', 'invoice_next_number', 'unknown_option']);
    }

    public function test_settings_update_ignores_query_parameters_and_allows_clearing_prefixes(): void
    {
        $this->seedSettings();
        $token = $this->staffWithSettingsPermission()->createToken('settings-test')->plainTextToken;

        $this->requestWithToken($token, 'PUT', '/api/v1/admin/settings?lang=ar&_t=123', [
            'invoice_prefix' => '',
        ])->assertOk()
            ->assertJsonPath('data.numbering.invoice_prefix', '');

        $this->assertDatabaseHas('settings', ['key' => 'invoice_prefix', 'value' => '']);
    }

    public function test_update_returns_conflict_instead_of_server_error_if_setting_row_is_missing(): void
    {
        $this->seedSettings();
        Setting::query()->where('key', 'company_name')->delete();
        $token = $this->staffWithSettingsPermission()->createToken('settings-test')->plainTextToken;

        $this->requestWithToken($token, 'PUT', '/api/v1/admin/settings', [
            'company_name' => 'New Name',
            'tax_enabled' => true,
        ])->assertStatus(409);

        $this->assertDatabaseMissing('settings', ['key' => 'company_name']);
        $this->assertDatabaseHas('settings', ['key' => 'tax_enabled', 'value' => '0']);
    }

    public function test_number_generation_increments_the_counter_and_applies_padding(): void
    {
        $this->seedSettings();
        $service = app(SettingService::class);
        $service->getAllGrouped();
        $this->assertTrue(Cache::has('app_settings_static'));

        $this->assertSame('ORD-001000', $service->generateNextNumber('order'));
        $this->assertTrue(Cache::has('app_settings_static'));
        $this->assertSame('ORD-001001', $service->generateNextNumber('order'));
        $this->assertSame(1002, $service->get('order_next_number'));
        $this->assertSame('PO-1000', $service->generateNextNumber('purchase_order'));
    }

    private function seedSettings(): void
    {
        $this->seed(SettingSeeder::class);
    }

    private function staffWithSettingsPermission(): User
    {
        $permission = Permission::findOrCreate('settings.manage', 'staff');
        $staff = User::factory()->create();
        $staff->givePermissionTo($permission);

        return $staff;
    }

    /** @param array<string, mixed> $payload */
    private function requestWithToken(string $token, string $method, string $uri, array $payload = [])
    {
        Auth::forgetGuards();

        return $this->withToken($token)->json($method, $uri, $payload);
    }
}
</file>

<file path="bags-platform/backend/tests/Feature/LocationEndpointsTest.php">
<?php

declare(strict_types=1);

namespace Tests\Feature;

use App\Models\Branch;
use App\Models\User;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Foundation\Testing\LazilyRefreshDatabase;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Illuminate\Testing\TestResponse;
use Spatie\Permission\Models\Permission;
use Tests\TestCase;

class LocationEndpointsTest extends TestCase
{
    use LazilyRefreshDatabase;

    public function test_location_crud_is_scoped_to_the_parent_branch(): void
    {
        $branch = Branch::factory()->create();
        $otherBranch = Branch::factory()->create();
        $admin = $this->staffWithPermission('locations.manage');
        $token = $admin->createToken('test')->plainTextToken;

        $created = $this->requestWithToken($token, 'POST', "/api/v1/admin/branches/{$branch->id}/locations", [
            'name' => 'Aisle 1 Bin 2',
            'code' => 'A-01-02',
            'type' => 'bin',
            'is_active' => true,
            'branch_id' => $otherBranch->id,
        ]);

        $created->assertCreated()
            ->assertJsonPath('data.name', 'Aisle 1 Bin 2')
            ->assertJsonPath('data.branch_id', $branch->id)
            ->assertJsonPath('data.type', 'bin');

        $locationId = $created->json('data.id');
        $otherBranchLocationUri = "/api/v1/admin/branches/{$otherBranch->id}/locations/{$locationId}";

        $this->requestWithToken($token, 'GET', $otherBranchLocationUri)->assertNotFound();
        $this->requestWithToken($token, 'PATCH', $otherBranchLocationUri, ['name' => 'Wrong Branch'])->assertNotFound();
        $this->requestWithToken($token, 'DELETE', $otherBranchLocationUri)->assertNotFound();

        $this->requestWithToken($token, 'GET', "/api/v1/admin/branches/{$branch->id}/locations?per_page=1")
            ->assertOk()
            ->assertJsonCount(1, 'data')
            ->assertJsonPath('data.0.id', $locationId)
            ->assertJsonPath('meta.per_page', 1);

        $this->requestWithToken($token, 'PATCH', "/api/v1/admin/branches/{$branch->id}/locations/{$locationId}", [
            'name' => 'Updated Bin',
        ])->assertOk()->assertJsonPath('data.name', 'Updated Bin');

        $this->requestWithToken($token, 'DELETE', "/api/v1/admin/branches/{$branch->id}/locations/{$locationId}")
            ->assertNoContent();

        $this->assertDatabaseMissing('locations', ['id' => $locationId]);
    }

    public function test_location_codes_are_unique_within_a_branch_but_may_repeat_in_another(): void
    {
        $branch = Branch::factory()->create();
        $otherBranch = Branch::factory()->create();
        $admin = $this->staffWithPermission('locations.manage');
        $token = $admin->createToken('test')->plainTextToken;
        $payload = [
            'name' => 'Rack A',
            'code' => 'A-01-01',
            'type' => 'shelf',
        ];

        $this->requestWithToken($token, 'POST', "/api/v1/admin/branches/{$branch->id}/locations", $payload)
            ->assertCreated();

        $this->requestWithToken($token, 'POST', "/api/v1/admin/branches/{$branch->id}/locations", $payload)
            ->assertUnprocessable()
            ->assertJsonValidationErrors(['code']);

        $this->requestWithToken($token, 'POST', "/api/v1/admin/branches/{$otherBranch->id}/locations", $payload)
            ->assertCreated();
    }

    public function test_location_cannot_be_deleted_while_stock_movements_reference_it(): void
    {
        Schema::create('stock_movements', function (Blueprint $table): void {
            $table->id();
            $table->foreignId('location_id')->constrained()->cascadeOnDelete();
        });

        $branch = Branch::factory()->create();
        $location = $branch->locations()->create([
            'name' => 'Receiving Area',
            'code' => 'R-02',
            'type' => 'receiving',
        ]);
        DB::table('stock_movements')->insert(['location_id' => $location->id]);
        $admin = $this->staffWithPermission('locations.manage');
        $token = $admin->createToken('test')->plainTextToken;

        $this->requestWithToken(
            $token,
            'DELETE',
            "/api/v1/admin/branches/{$branch->id}/locations/{$location->id}",
        )->assertStatus(409);

        $this->assertDatabaseHas('locations', ['id' => $location->id]);
        $this->assertDatabaseHas('stock_movements', ['location_id' => $location->id]);
    }

    public function test_location_endpoints_forbid_staff_without_location_permissions(): void
    {
        $branch = Branch::factory()->create();
        $location = $branch->locations()->create([
            'name' => 'Receiving Area',
            'code' => 'R-01',
            'type' => 'receiving',
        ]);
        $staff = User::factory()->create();
        $token = $staff->createToken('test')->plainTextToken;

        $this->requestWithToken($token, 'GET', "/api/v1/admin/branches/{$branch->id}/locations")
            ->assertForbidden();
        $this->requestWithToken($token, 'GET', "/api/v1/admin/branches/{$branch->id}/locations/{$location->id}")
            ->assertForbidden();
    }

    private function staffWithPermission(string $permissionName): User
    {
        $permission = Permission::findOrCreate($permissionName, 'staff');
        $staff = User::factory()->create();
        $staff->givePermissionTo($permission);

        return $staff;
    }

    /**
     * @param  array<string, mixed>  $payload
     */
    private function requestWithToken(string $token, string $method, string $uri, array $payload = []): TestResponse
    {
        Auth::forgetGuards();

        return $this->withToken($token)->json($method, $uri, $payload);
    }
}
