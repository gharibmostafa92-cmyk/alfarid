  <!-- ================= JAVASCRIPT ================= -->
  <script>
    let currentQty = 1;
    let cartTotalItems = 0;
    let activeCategory = 'all';
    let activeColor = 'all';
    let activePriceRange = 'all';

    // Toggle Sidebar Filter
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const grid = document.getElementById('productGrid');
      const btn = document.getElementById('filterToggleBtn');
      const btnText = document.getElementById('filterBtnText');

      sidebar.classList.toggle('hidden');
      grid.classList.toggle('four-cols');
      btn.classList.toggle('open');

      if (sidebar.classList.contains('hidden')) {
        btnText.textContent = 'Show Filters';
      } else {
        btnText.textContent = 'Hide Filters';
      }
    }

    // Filter by Category
    function filterByCategory(cat, pillEl) {
      activeCategory = cat;

      // Update pills
      document.querySelectorAll('.cat-pill').forEach(pill => {
        pill.classList.remove('active');
      });
      if (pillEl) {
        pillEl.classList.add('active');
      } else {
        document.querySelectorAll('.cat-pill').forEach(pill => {
          if ((cat === 'all' && pill.innerText.includes('All')) ||
              pill.innerText.toLowerCase().includes(cat)) {
            pill.classList.add('active');
          }
        });
      }

      // Update sidebar category item active
      document.querySelectorAll('.filter-sidebar .filter-item').forEach(item => {
        item.classList.remove('active');
      });

      applyFilters();
    }

    // Filter by Color
    function filterByColor(color, btnEl) {
      activeColor = color;
      document.querySelectorAll('.swatch-btn').forEach(btn => btn.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');
      applyFilters();
    }

    // Filter by Price Range
    function filterByPriceRange(range) {
      activePriceRange = range;
      applyFilters();
    }

    // Master filter evaluation
    function applyFilters() {
      const cards = document.querySelectorAll('#productGrid .product-card');
      let visibleCount = 0;

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        const cardColor = card.getAttribute('data-color');
        const cardPrice = parseFloat(card.getAttribute('data-price'));

        let matchCat = (activeCategory === 'all' || cardCat === activeCategory);
        let matchColor = (activeColor === 'all' || cardColor === activeColor);
        let matchPrice = true;

        if (activePriceRange === 'under-90') {
          matchPrice = (cardPrice < 90);
        } else if (activePriceRange === '90-120') {
          matchPrice = (cardPrice >= 90 && cardPrice <= 120);
        } else if (activePriceRange === 'over-120') {
          matchPrice = (cardPrice > 120);
        }

        if (matchCat && matchColor && matchPrice) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update count & empty state
      document.getElementById('filterItemCount').textContent = `Showing ${visibleCount} piece${visibleCount === 1 ? '' : 's'}`;
      const noResults = document.getElementById('noResults');
      if (visibleCount === 0) {
        noResults.style.display = 'block';
      } else {
        noResults.style.display = 'none';
      }
    }

    // Reset Filters
    function resetFilters() {
      activeCategory = 'all';
      activeColor = 'all';
      activePriceRange = 'all';

      document.querySelectorAll('.cat-pill').forEach((pill, idx) => {
        if (idx === 0) pill.classList.add('active');
        else pill.classList.remove('active');
      });

      document.querySelectorAll('.swatch-btn').forEach((btn, idx) => {
        if (idx === 0) btn.classList.add('active');
        else btn.classList.remove('active');
      });

      const defaultRadio = document.querySelector('input[name="priceRange"][value="all"]');
      if (defaultRadio) defaultRadio.checked = true;

      applyFilters();
    }

    // Sort Products
    function sortProducts() {
      const sortVal = document.getElementById('sortSelect').value;
      const grid = document.getElementById('productGrid');
      const cards = Array.from(grid.querySelectorAll('.product-card'));

      cards.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price'));
        const priceB = parseFloat(b.getAttribute('data-price'));
        const nameA = a.querySelector('.product-name').innerText;
        const nameB = b.querySelector('.product-name').innerText;

        if (sortVal === 'price-asc') return priceA - priceB;
        if (sortVal === 'price-desc') return priceB - priceA;
        if (sortVal === 'name') return nameA.localeCompare(nameB);
        return 0; // featured default
      });

      cards.forEach(card => grid.appendChild(card));
    }

    // Open Product Detail View
    function openProductDetail(title, price, imgUrl, tintClass, sku, desc) {
      document.getElementById('catalogView').classList.add('hidden');
      document.getElementById('productDetailView').classList.add('active');

      document.getElementById('pdpTitle').innerHTML = title.replace(" Backpack", "<br>Backpack");
      document.getElementById('pdpBreadcrumbTitle').textContent = title;
      document.getElementById('pdpPrice').textContent = price;
      document.getElementById('pdpSku').textContent = `Style: ${sku || 'SP-2026'}`;
      if (desc) document.getElementById('pdpDesc').textContent = desc;

      const mainImg = document.getElementById('pdpMainImage');
      mainImg.src = imgUrl;
      mainImg.className = tintClass || 'tint-pink';

      // Reset qty
      currentQty = 1;
      document.getElementById('qtyNumber').textContent = currentQty;

      window.scrollTo({ top: 380, behavior: 'smooth' });
    }

    // Show Catalog View
    function showCatalog() {
      document.getElementById('productDetailView').classList.remove('active');
      document.getElementById('catalogView').classList.remove('hidden');
      window.scrollTo({ top: 350, behavior: 'smooth' });
    }

    // Switch PDP image on thumbnail click
    function switchMainImage(thumbBox, tintClass) {
      document.querySelectorAll('.pdp-thumb-box').forEach(b => b.classList.remove('active'));
      thumbBox.classList.add('active');

      const img = thumbBox.querySelector('img');
      const mainImg = document.getElementById('pdpMainImage');
      mainImg.src = img.src;
      mainImg.className = tintClass;
    }

    // Set PDP Tint via Swatches
    function setPdpTint(swatchEl, tintClass) {
      document.querySelectorAll('.pdp-swatch').forEach(s => s.classList.remove('active'));
      swatchEl.classList.add('active');

      const mainImg = document.getElementById('pdpMainImage');
      mainImg.className = tintClass;
    }

    // Size Selection
    function selectSize(btn) {
      document.querySelectorAll('.pdp-size-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    // Quantity Picker
    function changeQty(delta) {
      currentQty = Math.max(1, currentQty + delta);
      document.getElementById('qtyNumber').textContent = currentQty;
    }

    // Add to Cart Interaction
    function addToCart() {
      cartTotalItems += currentQty;
      const badge = document.getElementById('cartCountBadge');
      badge.textContent = cartTotalItems;
      badge.classList.add('bump');
      setTimeout(() => badge.classList.remove('bump'), 300);

      const title = document.getElementById('pdpBreadcrumbTitle').textContent;
      showToast(`Added ${currentQty}x "${title}" to your shopping bag!`);
    }

    // Wishlist Toggle
    function toggleWishlist(btn) {
      const icon = btn.querySelector('i');
      if (icon.classList.contains('fa-regular')) {
        icon.classList.remove('fa-regular');
        icon.classList.add('fa-solid');
        icon.style.color = '#e11d48';
        showToast('Saved to your wishlist!');
      } else {
        icon.classList.remove('fa-solid');
        icon.classList.add('fa-regular');
        icon.style.color = '';
        showToast('Removed from your wishlist.');
      }
    }

    // Show Toast Notification
    function showToast(msg) {
      const toast = document.getElementById('cartToast');
      document.getElementById('toastMsg').textContent = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    function openCartToast() {
      showToast(`You have ${cartTotalItems} item${cartTotalItems === 1 ? '' : 's'} in your bag.`);
    }

    // Smooth Navigation Transition between Pages
    document.querySelectorAll('a[href]').forEach(link => {
      const href = link.getAttribute('href');
      if (href && (href === 'home.html' || href === 'categories.html')) {
        link.addEventListener('click', e => {
          const currentFile = window.location.pathname.split('/').pop() || 'categories.html';
          if (link.target !== '_blank' && !e.ctrlKey && !e.metaKey && href !== currentFile) {
            e.preventDefault();
            document.body.classList.add('page-fade-out');
            setTimeout(() => {
              window.location.href = href;
            }, 180);
          }
        });
      }
    });
  </script>
</body>
</html>
